@model customerseller.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<style>
    body {
        background: #fafafa;
    }

    .checkout-wrapper {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: 100vh;
        gap: 44px;
        margin: 40px 0;
        padding: 0 20px;
    }

    .checkout-left {
        background: #fff;
        padding: 38px 36px 28px 36px;
        border-radius: 12px;
        box-shadow: 0 4px 32px rgba(160, 50, 95, 0.08);
        min-width: 400px;
        width: 420px;
    }

    .checkout-right {
        background: #fff;
        padding: 28px 28px 18px 28px;
        border-radius: 12px;
        box-shadow: 0 4px 32px rgba(160, 50, 95, 0.08);
        min-width: 330px;
        width: 370px;
    }

    .logo-heading {
        color: #a64d79;
        font-size: 2.1rem;
        font-weight: bold;
        letter-spacing: 2px;
        margin-bottom: 34px;
    }

    .section-title {
        font-size: 1.09rem;
        font-weight: bold;
        margin: 26px 0 12px 0;
    }

    .checkout-left input[type="text"], .checkout-left input[type="email"], .checkout-left select {
        width: 100%;
        padding: 9px 12px;
        font-size: 1rem;
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        margin-bottom: 16px;
        box-sizing: border-box;
        background: #faf8fa;
    }

    .inline-inputs {
        display: flex;
        gap: 14px;
    }

        .inline-inputs input {
            width: 100%;
        }

    .shipping-box {
        background: #f8faf7;
        border: 1.5px solid #dbe8d0;
        border-radius: 7px;
        padding: 13px 18px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .shipping-box span {
            font-weight: 500;
        }

    .payment-group {
        margin-bottom: 30px;
    }

    .radio-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-top: 10px;
    }

    .radio-row {
        display: flex;
        align-items: center;
        gap: 9px;
    }

        .radio-row label {
            font-size: 1.02rem;
            cursor: pointer;
            user-select: none;
            color: #3b3542;
        }

    .pay-btn {
        width: 100%;
        background: #a64d79;
        color: #fff;
        font-size: 1.15rem;
        font-weight: 600;
        border: none;
        border-radius: 6px;
        padding: 14px 0;
        margin-top: 16px;
        cursor: pointer;
        letter-spacing: 1px;
        transition: background 0.2s;
    }

        .pay-btn:hover {
            background: #873b63;
        }

        .pay-btn:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

    .checkout-links {
        text-align: left;
        margin-top: 36px;
        font-size: 0.95rem;
        color: #777;
    }

        .checkout-links a {
            color: #a64d79;
            text-decoration: none;
            margin-right: 14px;
        }

            .checkout-links a:hover {
                text-decoration: underline;
            }

    .custom-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 99999;
        align-items: center;
        justify-content: center;
    }

        .custom-modal-overlay.show {
            display: flex;
        }

    .custom-modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 32px;
        max-width: 380px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }

    .custom-modal-icon {
        font-size: 2.5rem;
        margin-bottom: 12px;
    }

    .custom-modal-box h3 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #1e1033;
        margin-bottom: 8px;
    }

    .custom-modal-box p {
        font-size: 0.85rem;
        color: #6b7280;
        margin-bottom: 20px;
        line-height: 1.6;
    }

    .custom-modal-btn {
        padding: 10px 28px;
        border-radius: 9px;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        background: #a64d79;
        color: #fff;
    }

    /* Remove ("x") button on each order-summary line item */
    .remove-item-btn {
        background: none;
        border: none;
        color: #bbb;
        font-size: 1.15rem;
        line-height: 1;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 50%;
        transition: color 0.15s, background 0.15s;
    }

        .remove-item-btn:hover {
            color: #fff;
            background: #d9534f;
        }

    .empty-cart-msg {
        color: #999;
        text-align: center;
        padding: 24px 0;
    }

    /* Single-option Country field: looks like a field, not a real dropdown */
    .country-select {
        appearance: none;
        -webkit-appearance: none;
        -moz-appearance: none;
        cursor: default;
        background-image: none;
    }

    @@media (max-width: 950px) {
        .checkout-wrapper {
            flex-direction: column;
            align-items: center;
            gap: 26px;
            margin: 20px 0;
            padding: 0 12px;
        }

        .checkout-left, .checkout-right {
            min-width: 0;
            width: 100%;
            padding: 24px 20px 18px;
        }

        .logo-heading {
            font-size: 1.6rem;
            margin-bottom: 22px;
        }

        .inline-inputs {
            flex-direction: column;
            gap: 0;
        }
    }
    .address-wrap { position: relative; margin-bottom: 8px; }
.area-suggestions {
    display: none;
    position: absolute;
    left: 0; right: 0; top: 100%;
    background: #fff;
    border: 1px solid #e0d3da;
    border-radius: 6px;
    box-shadow: 0 8px 24px rgba(160, 50, 95, 0.15);
    z-index: 50;
    max-height: 220px;
    overflow-y: auto;
}
.area-suggestions.show { display: block; }
.area-suggestions .sg-head {
    font-size: 0.75rem; color: #999; padding: 6px 12px;
    border-bottom: 1px solid #f0e8ec;
}
.area-suggestions .sg-item {
    padding: 9px 12px; cursor: pointer; font-size: 0.95rem; color: #3b3542;
}
.area-suggestions .sg-item:hover { background: #f8eef3; color: #a64d79; }
</style>

<div class="checkout-wrapper">
    <div class="checkout-left">
        <div class="logo-heading">ARTISAN VALLEY</div>

        @if (TempData["Error"] != null)
        {
            <div style="color:red; background:#ffe0e0; padding:10px; border-radius:6px; margin-bottom:15px;">
                ⚠️ @TempData["Error"]
            </div>
        }

        <form id="checkoutForm">

            <input type="hidden" name="cartData" id="cartDataInput" />
            <input type="hidden" name="deliveryFee" id="deliveryFeeInput" value="0" />

            <div class="section-title">Contact</div>
            <input type="text" asp-for="Phone" id="phoneInput" placeholder="03XX-XXXXXXX" maxlength="12" />
                      <div class="section-title">Delivery</div>
            <div style="background:#fff3cd; border:1.5px solid #ffc107; border-radius:8px; padding:9px 14px; margin-bottom:14px; font-size:0.88rem; color:#856404;">
                📍 We currently deliver within <strong>Rawalpindi only</strong>.
            </div>
            <select asp-for="Country" class="country-select">
                <option value="Pakistan" selected>Pakistan, Rawalpindi</option>
            </select>

           <div class="inline-inputs">
    <input type="text" id="FirstName" name="FirstName" placeholder="First name" maxlength="30" autocomplete="given-name">
    <input type="text" id="LastName" name="LastName" placeholder="Last name" maxlength="30" autocomplete="family-name">
</div>
           
                                  <label for="areaSelect" style="font-size:0.9rem; font-weight:600; display:block; margin-bottom:6px;">Select your area <span style="color:red">*</span></label>
            <select id="areaSelect" name="selectedArea">
                <option value="">-- Select your area --</option>
            </select>
            <small style="color:#888; font-size:0.82rem; display:block; margin-top:-8px; margin-bottom:12px;">
                📍 Delivery charge is calculated from the area you select
            </small>

            <textarea asp-for="Address" id="addressInput" rows="3"
                      placeholder="House / shop no, street, landmark (e.g. House 5, Street 3, near KFC)" required
                      style="width:100%; padding:9px 12px; font-size:1rem; font-family:inherit; border:1px solid #e0e0e0; border-radius:4px; margin-bottom:16px; box-sizing:border-box; background:#faf8fa; resize:none; line-height:1.4;"></textarea>         
    
            <input type="hidden" asp-for="City" id="cityHidden" value="Rawalpindi" />

            <div id="areaNotFound" style="display:none; background:#fff3cd; border:1.5px solid #ffc107; border-radius:8px; padding:10px 16px; margin-bottom:16px; font-size:0.88rem; color:#856404;">
                ⚠️ Please select your area from the list above. We deliver within Rawalpindi only.              
   </div>

            <div class="section-title">Shipping method</div>
            <div class="shipping-box">
                <span>Standard Delivery</span>
                <span style="color:#a64d79; font-weight:700;" id="shippingDisplay">Enter address first</span>
            </div>

            <div class="section-title">Payment</div>
            <div class="payment-group">
                <div class="radio-list">
                    <div class="radio-row">
                        <input type="radio" asp-for="PaymentMethod" value="COD" id="cod" checked>
                        <label for="cod">Cash on Delivery (COD)</label>
                    </div>
                </div>
            </div>

            <button type="button" class="pay-btn" id="payBtn">Complete Order</button>
        </form>

        <div class="checkout-links">
            <a href="#">Refund policy</a>
            <a href="#">Privacy policy</a>
        </div>
    </div>

    <div class="checkout-right">
        <div id="orderSummary"></div>
    </div>
</div>


<div class="custom-modal-overlay" id="customModal">
    <div class="custom-modal-box">
        <div class="custom-modal-icon" id="customModalIcon"></div>
        <h3 id="customModalTitle"></h3>
        <p id="customModalMsg"></p>
        <button class="custom-modal-btn" id="customModalBtn">OK</button>
    </div>
</div>

@section Scripts {
    <script>
        let deliveryFee = 0;      
        let baseDeliveryFee = 0;  
        let subtotal = 0;
        let displayItems = [];
        let isSubmitting = false;
        let isBuyNow = false; 
        let allAreas = [];

        function getAreaSuggestions(addr) {
            if (!addr || addr.length < 3) return [];
            const words = normWords(addr);
            const last = words[words.length - 1] || '';
            return allAreas.filter(name => {
                if (addressMatchesArea(addr, name)) return true;
                const aw = normWords(name);
                return last.length >= 3 && aw.some(w => w.startsWith(last));
            }).slice(0, 6);
        }

        function showAreaSuggestions(addr) {
            const box = document.getElementById('areaSuggestions');
            const current = document.getElementById('areaSelect').value;
            const list = getAreaSuggestions(addr).filter(n => n !== current);
            if (!list.length) { box.classList.remove('show'); box.innerHTML = ''; return; }

                       box.innerHTML = '<div class="sg-head">Did you mean this area?</div>' +
                list.map(n => `<div class="sg-item" data-area="${escapeHtml(n)}">${escapeHtml(n)}</div>`).join('');
            box.classList.add('show');

            box.querySelectorAll('.sg-item').forEach(el => {
                el.addEventListener('mousedown', function (e) {
                    e.preventDefault();
                    pickArea(this.getAttribute('data-area'));
                });
            });
        }

        function pickArea(name) {
            const sel = document.getElementById('areaSelect');
            const addrEl = document.getElementById('addressInput');
            sel.value = name;
            applyDeliveryZone(name);

            if (!addressMatchesArea(addrEl.value, name)) {
                addrEl.value = (addrEl.value.trim().replace(/[,\s]+$/, '') + ', ' + name).slice(0, 200);
            }
            document.getElementById('areaSuggestions').classList.remove('show');
        }        
        const SAME_SHOP_EXTRA_CHARGE = 20;

        function groupItemsByShop(items) {
            const groups = new Map();
            items.forEach(item => {
                const key = item.shopId ? ('shop:' + item.shopId) : ('item:' + item.id);
                if (!groups.has(key)) groups.set(key, []);
                groups.get(key).push(item);
            });
            return Array.from(groups.values());
        }

        function recalcDeliveryFee() {
                   if (baseDeliveryFee <= 0 || displayItems.length === 0) {
            deliveryFee = 0;
            document.getElementById('deliveryFeeInput').value = 0;
            document.getElementById('shippingDisplay').textContent = 'Select your area';
            return;
        }
            

            const shopGroups = groupItemsByShop(displayItems);
            let total = 0;
            let totalExtraItems = 0;

            shopGroups.forEach(group => {
                const extraItems = Math.max(group.length - 1, 0);
                total += baseDeliveryFee + (extraItems * SAME_SHOP_EXTRA_CHARGE);
                totalExtraItems += extraItems;
            });

            deliveryFee = total;
            document.getElementById('deliveryFeeInput').value = deliveryFee;

            document.getElementById('shippingDisplay').textContent = 'Rs. ' + deliveryFee.toLocaleString();
        }
                function escapeHtml(str) {
            return String(str == null ? '' : str)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        function showCustomModal(icon, title, msg, callback) {
                        const iconMap = {
                Warning: '\u26A0\uFE0F',
                Pin: '\uD83D\uDCCD',
                Cart: '\uD83D\uDED2',
                Block: '\uD83D\uDEAB',
                Error: '\u274C'
            };
            document.getElementById('customModalIcon').textContent = iconMap[icon] || icon;
            document.getElementById('customModalTitle').textContent = title;
            document.getElementById('customModalMsg').textContent = msg;
            document.getElementById('customModal').classList.add('show');
            document.getElementById('customModalBtn').onclick = function() {
                closeCustomModal();
                if (callback) callback();
            };
        }

        function closeCustomModal() {
            document.getElementById('customModal').classList.remove('show');
        }

        // Recomputes cartDataInput (the hidden field actually posted to the
        // server) from whatever is currently left in displayItems.
        function syncCartDataInput() {
            const cartDataInput = document.getElementById('cartDataInput');
            cartDataInput.value = displayItems.length > 0
                ? JSON.stringify(displayItems.map(i => ({
                    ProductId: (i.id || "0").toString(),
                    Title: i.title,
                    Price: parseFloat(i.price),
                    Quantity: parseInt(i.qty),
                    ImageUrl: i.img
                })))
                : '[]';
        }

        // Removes one line item (by its index in displayItems), keeps
        // localStorage, the subtotal, the posted form data and the Pay
        // button all in sync with what's actually left in the summary.
        function removeItem(index) {
            if (index < 0 || index >= displayItems.length) return;

            displayItems.splice(index, 1);

            subtotal = 0;
            displayItems.forEach(item => {
                subtotal += (parseFloat(item.price) || 0) * (parseInt(item.qty) || 1);
            });

            if (isBuyNow) {
                localStorage.removeItem('buyNowItem');
            } else {
                localStorage.setItem('cart', JSON.stringify(displayItems));
            }

            syncCartDataInput();
            recalcDeliveryFee();

            if (typeof updateCartCount === 'function') updateCartCount();

            const payBtn = document.getElementById('payBtn');
                       if (payBtn) payBtn.disabled = displayItems.length === 0;

            updateSummary();
        }

        // Increments/decrements one line item's quantity by delta. Hitting
        // zero removes the item entirely (same as clicking the x button).
        function changeSummaryQty(index, delta) {
            if (index < 0 || index >= displayItems.length) return;

            let newQty = (parseInt(displayItems[index].qty) || 1) + delta;
            if (newQty <= 0) {
                removeItem(index);
                return;
            }
            displayItems[index].qty = newQty;

            subtotal = 0;
            displayItems.forEach(item => {
                subtotal += (parseFloat(item.price) || 0) * (parseInt(item.qty) || 1);
            });

            if (isBuyNow) {
                localStorage.setItem('buyNowItem', JSON.stringify(displayItems[0]));
            } else {
                localStorage.setItem('cart', JSON.stringify(displayItems));
            }

            syncCartDataInput();
            recalcDeliveryFee();

            if (typeof updateCartCount === 'function') updateCartCount();

            updateSummary();
        }

        

        function updateSummary() {
            const summaryDiv = document.getElementById('orderSummary');
            let html = '<h3 style="margin-bottom:20px; font-weight:800; color:#333;">Order Summary</h3>';

            if (displayItems.length === 0) {
                html += '<div class="empty-cart-msg">Your cart is empty.</div>';
                summaryDiv.innerHTML = html;
                return;
            }

                       displayItems.forEach((item, index) => {
                let price = parseFloat(item.price) || 0;
                let qty = parseInt(item.qty) || 1;
                html += `
                            <div style="display:flex; justify-content:space-between; margin-bottom:15px; align-items:center;">
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <img src="${item.img}" style="width:50px; border-radius:5px; object-fit:cover;">
                                    <div>
<div style="font-weight:600;">${escapeHtml(item.title)}</div>
                                        <div style="display:flex; align-items:center; gap:8px; margin-top:6px;">
                                            <button type="button" class="qty-btn-summary" data-index="${index}" data-delta="-1" style="width:24px;height:24px;border:none;border-radius:4px;background:#f2e9ef;color:#a64d79;font-weight:bold;cursor:pointer;">-</button>
                                            <span>${qty}</span>
                                            <button type="button" class="qty-btn-summary" data-index="${index}" data-delta="1" style="width:24px;height:24px;border:none;border-radius:4px;background:#f2e9ef;color:#a64d79;font-weight:bold;cursor:pointer;">+</button>
                                        </div>
                                    </div>
                                </div>
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <div style="color:#a64d79; font-weight:bold;">Rs.${(price * qty).toLocaleString()}</div>
                                    <button type="button" class="remove-item-btn" data-index="${index}" title="Remove item">&times;</button>
                                </div>
                            </div>`;
            });
            html += `
                        <hr>
                        <div style="display:flex; justify-content:space-between; margin:8px 0; color:#555;">
                            <span>Subtotal</span><span>Rs.${subtotal.toLocaleString()}</span>
                        </div>
                        <div style="display:flex; justify-content:space-between; margin:8px 0; color:#555;">
                            <span>Delivery</span>
                            <span>${deliveryFee > 0 ? 'Rs.' + deliveryFee.toLocaleString() : '<span style="color:#999;">Enter address</span>'}</span>
                        </div>
                        <hr>
                        <div style="display:flex; justify-content:space-between; font-weight:800; font-size:1.2rem; margin-top:8px;">
                            <span>Total</span>
                            <span style="color:#a64d79;">Rs.${(subtotal + deliveryFee).toLocaleString()}</span>
                        </div>`;
            summaryDiv.innerHTML = html;

                     summaryDiv.querySelectorAll('.remove-item-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    removeItem(parseInt(this.getAttribute('data-index'), 10));
                });
            });

            summaryDiv.querySelectorAll('.qty-btn-summary').forEach(btn => {
                btn.addEventListener('click', function() {
                    changeSummaryQty(parseInt(this.getAttribute('data-index'), 10), parseInt(this.getAttribute('data-delta'), 10));
                });
            });
        }

        async function detectAreaFromAddress(address) {
                        if (document.getElementById('areaSelect') && document.getElementById('areaSelect').value) return;
            if (address.length < 4) return;
            const words = address.split(/[\s,]+/).filter(w => w.length > 2);
            for (let word of words) {
                try {
                    const res = await fetch(`/Cart/GetAreas?term=${encodeURIComponent(word)}`);
                    const areas = await res.json();
                    if (areas.length > 0) {
                        await applyDeliveryZone(areas[0]);
                        return;
                    }
                } catch (err) {
                    console.error('Area detection error:', err);
                }
            }
            baseDeliveryFee = 0;
            deliveryFee = 0;
            document.getElementById('areaNotFound').style.display = 'block';
            document.getElementById('shippingDisplay').textContent = 'Area not found';
            updateSummary();
        }

        async function applyDeliveryZone(area) {
            try {
                const res = await fetch(`/Cart/GetDeliveryCharge?area=${encodeURIComponent(area)}`);
                const data = await res.json();
                if (data.found) {
                    baseDeliveryFee = parseFloat(data.charge);
                    document.getElementById('areaNotFound').style.display = 'none';
                    recalcDeliveryFee();
                    updateSummary();
                }
            } catch (err) {
                console.error('Delivery charge error:', err);
            }
        }
                // ---- Area match with small spelling mistakes allowed ----
        function normWords(s) {
            return (s || '').toLowerCase()
                .replace(/([a-z])(\d)/g, '$1 $2')
                .replace(/(\d)([a-z])/g, '$1 $2')
                .split(/[^a-z0-9]+/)
                .filter(Boolean);
        }

        // Edit distance (ek letter ghalat/kam/zyada, ya do letters ulte = 1 ghalti)
        function editDistance(a, b) {
            const d = [];
            for (let i = 0; i <= a.length; i++) d[i] = [i];
            for (let j = 1; j <= b.length; j++) d[0][j] = j;
            for (let i = 1; i <= a.length; i++) {
                for (let j = 1; j <= b.length; j++) {
                    const cost = a[i - 1] === b[j - 1] ? 0 : 1;
                    d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
                    if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {
                        d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1);
                    }
                }
            }
            return d[a.length][b.length];
        }

        function wordMatches(areaWord, addrWords) {
            if (/^\d+$/.test(areaWord)) return addrWords.includes(areaWord); // numbers bilkul sahi hon
            const maxErr = areaWord.length <= 3 ? 0 : (areaWord.length <= 6 ? 1 : 2);
            return addrWords.some(w => !/^\d+$/.test(w) && editDistance(areaWord, w) <= maxErr);
        }

               function addressMatchesArea(addr, area) {
            const addrWords = normWords(addr);
            const areaWords = normWords(area).filter(w => w.length > 1 || /\d/.test(w));
            if (!areaWords.length) return true;

            // "bahriatown" jaisa jura hua likha ho to bhi theek
            if (addrWords.join('').includes(areaWords.join(''))) return true;

            // 1) area ke saare numbers exact hon (Phase 1 != Phase 2)
            const numbers = areaWords.filter(w => /^\d+$/.test(w));
            if (!numbers.every(n => addrWords.includes(n))) return false;

            // 2) sab se ahem (sab se lamba) lafz thori ghalti ke saath match ho
            const letters = areaWords.filter(w => !/^\d+$/.test(w));
            if (!letters.length) return true;
            const keyWord = letters.slice().sort((a, b) => b.length - a.length)[0];
            return wordMatches(keyWord, addrWords);
        }
                function isValidAddress(a) {
            if (a.length < 10 || a.length > 200) return false;
            if (!/^[A-Za-z0-9\s,.\-\/#]+$/.test(a)) return false;
            if (/[^A-Za-z0-9\s]{2,}/.test(a)) return false;
            if ((a.match(/[A-Za-z]/g) || []).length < 6) return false;
            if (a.split(/\s+/).filter(w => /[A-Za-z0-9]/.test(w)).length < 3) return false;
            if (/(.)\1{3,}/.test(a)) return false;
            return true;
        }

        async function submitOrder(event) {
            event.preventDefault();
            event.stopPropagation();

            if (isSubmitting) return;
            isSubmitting = true;

            const cartDataInput = document.getElementById('cartDataInput');
            const phoneInput = document.getElementById('phoneInput');
            const addressInput = document.getElementById('addressInput');
            const payBtn = document.getElementById('payBtn');

            payBtn.disabled = true;
            payBtn.textContent = 'Processing...';

            const phoneVal = phoneInput ? phoneInput.value.replace('-', '') : '';

            if (phoneVal.length !== 11 || isNaN(phoneVal)) {
                showCustomModal('Warning', 'Invalid Phone Number',
                    'Please enter a valid 11-digit mobile number (e.g. 03XX-XXXXXXX).');
                isSubmitting = false;
                payBtn.disabled = false;
                payBtn.textContent = 'Complete Order';
                return;
            }


            const fn = (document.getElementById('FirstName').value || '').trim();
const ln = (document.getElementById('LastName').value || '').trim();
if (fn.length < 2 || ln.length < 2) {
    showCustomModal('Warning', 'Invalid Name',
        'Please enter your first and last name (letters only, at least 2 characters).');
    isSubmitting = false;
    payBtn.disabled = false;
    payBtn.textContent = 'Complete Order';
    return;
}

const addr = addressInput.value.trim();
        if (!isValidAddress(addr)) {
    showCustomModal('Warning', 'Invalid Address',
                      'Please enter a full address with house/shop, street and area (e.g. House 12, Street 4, Saddar). Avoid repeated symbols.');
    isSubmitting = false;
    payBtn.disabled = false;
    payBtn.textContent = 'Complete Order';
    return;
}
        const selArea = (document.getElementById('areaSelect').value || '').trim();
                                      if (!selArea) {
                showCustomModal('Pin', 'Select Area', 'Please select your delivery area from the list.');
                isSubmitting = false;
                payBtn.disabled = false;
                payBtn.textContent = 'Complete Order';
                return;
            }

            if (deliveryFee === 0) {
                showCustomModal('Pin', 'Area Not Detected',
                                    'Please select your delivery area from the list.');   
                isSubmitting = false;
                payBtn.disabled = false;
                payBtn.textContent = 'Complete Order';
                return;
            }

            if (!cartDataInput.value || cartDataInput.value === '[]') {
                showCustomModal('Cart', 'Cart is Empty',
                    'Please add items to your cart before checking out.');
                isSubmitting = false;
                payBtn.disabled = false;
                payBtn.textContent = 'Complete Order';
                return;
            }

            const formData = new FormData();
           formData.append('Phone', phoneInput.value);
                 formData.append('FirstName', fn);
        formData.append('LastName', ln);
        formData.append('Address', addr);
            formData.append('City', 'Rawalpindi');
            formData.append('Country', 'Pakistan');
            formData.append('PaymentMethod', 'COD');
            formData.append('cartData', cartDataInput.value);
                       formData.append('deliveryFee', deliveryFee.toString());
            formData.append('selectedArea', document.getElementById('areaSelect')?.value || '');

            try {
                const response = await fetch('/Cart/ProcessOrder', {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result.success) {
                        localStorage.removeItem('cart');
                        localStorage.removeItem('buyNowItem');
                        window.location.href = result.redirectUrl;
                    } else {
                        showCustomModal('Error', 'Error', result.message || 'Something went wrong. Please try again.');
                        isSubmitting = false;
                        payBtn.disabled = false;
                        payBtn.textContent = 'Complete Order';
                    }
                } else {
                    const errorText = await response.text();
                    console.error('Server error:', errorText);
                    showCustomModal('Error', 'Error', 'Server error. Please try again.');
                    isSubmitting = false;
                    payBtn.disabled = false;
                    payBtn.textContent = 'Complete Order';
                }
            } catch (err) {
                console.error('Submission error:', err);
                showCustomModal('Error', 'Error', 'Network error: ' + err.message);
                isSubmitting = false;
                payBtn.disabled = false;
                payBtn.textContent = 'Complete Order';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const cartDataInput = document.getElementById('cartDataInput');
            const checkoutForm = document.getElementById('checkoutForm');
            const addressInput = document.getElementById('addressInput');
            const phoneInput = document.getElementById('phoneInput');
            const payBtn = document.getElementById('payBtn');
                                  const areaSelect = document.getElementById('areaSelect');
            if (areaSelect) {
                fetch('/Cart/GetAreaList')
                    .then(r => r.json())
                    .then(list => {
                        list.forEach(a => {
                            allAreas.push(a.name);
                            const opt = document.createElement('option');
                            opt.value = a.name;
                            opt.textContent = a.name;
                            areaSelect.appendChild(opt);
                        });
                    })
                    .catch(err => console.error('Area list error:', err));
                areaSelect.addEventListener('change', function () {
                    if (this.value) {
                        applyDeliveryZone(this.value);
                    } else {
                        baseDeliveryFee = 0;
                        deliveryFee = 0;
                        document.getElementById('shippingDisplay').textContent = 'Select your area';
                        updateSummary();
                    }
                });
            }

            let buyNowData = localStorage.getItem('buyNowItem');
            let cartData = localStorage.getItem('cart');
            if (buyNowData) {
                displayItems = [JSON.parse(buyNowData)];
                isBuyNow = true;
            } else if (cartData) {
                displayItems = JSON.parse(cartData);
                isBuyNow = false;
            }

            if (displayItems && displayItems.length > 0) {
                subtotal = 0;
                displayItems.forEach(item => {
                    subtotal += (parseFloat(item.price) || 0) * (parseInt(item.qty) || 1);
                });
                syncCartDataInput();
            }
            updateSummary();

            fetch('/Account/GetUserRole')
                .then(r => r.json())
                .then(data => {
                    if (data.role === 'Seller') {
                        showCustomModal('Block', 'Not Allowed',
                            'Sellers cannot place orders. Please login as a customer.',
                            () => window.location.href = '/');
                    }
                })
                .catch(err => console.error('Role check error:', err));

            if (phoneInput) {
                phoneInput.addEventListener('input', function() {
                    let val = this.value.replace(/\D/g, '');
                    if (val.length > 11) val = val.slice(0, 11);
                    this.value = val.length > 4 ? val.slice(0, 4) + '-' + val.slice(4) : val;
                });
            }

            ['FirstName', 'LastName'].forEach(id => {
    const el = document.getElementById(id);
    if (el) {
        el.addEventListener('input', function () {
            this.value = this.value.replace(/[^A-Za-z\s]/g, '');
        });
    }
});

if (addressInput) {
    addressInput.setAttribute('maxlength', '200');
    addressInput.addEventListener('input', function () {
               this.value = this.value
            .replace(/[^A-Za-z0-9\s,.\-\/#]/g, '')
            .replace(/([^A-Za-z0-9\s])[^A-Za-z0-9\s]+/g, '$1')
            .replace(/(.)\1{3,}/g, '$1$1$1');
    });
}

            if (payBtn) {
                payBtn.addEventListener('click', submitOrder);
            }

            checkoutForm.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                }
            });
        });
    </script>
}
