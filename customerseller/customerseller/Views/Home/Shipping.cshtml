@{
    ViewData["Title"] = "Shipping Policy";
}

<main class="policy-container">
    <h1>Shipping Policy</h1>

    <section>
        <p>
            We are committed to delivering your handmade products safely and promptly.
            Please read our shipping policy carefully.
        </p>
    </section>

    <section>
        <h2>Delivery Area</h2>
        <ul>
            <li>We currently deliver only within Rawalpindi.</li>
            <li>Select your area at checkout. Your delivery charge is calculated from the area you choose.</li>
        </ul>
    </section>

    <section>
        <h2>Order Processing</h2>
        <ul>
            <li>Orders are processed within 1–3 business days after they are placed.</li>
            <li>Handmade products may require additional crafting time depending on complexity.</li>
        </ul>
    </section>

    <section>
        <h2>Delivery Time</h2>
        <ul>
            <li>Orders are usually delivered within 3–7 working days.</li>
            <li>Delivery times may vary depending on your area, the seller and external factors.</li>
        </ul>
    </section>

    <section>
        <h2>Shipping Charges</h2>
        <ul>
            <li>Delivery charges depend on your delivery area and are shown at checkout before you place your order.</li>
            <li>Each seller ships their items separately. A delivery charge applies to each seller's parcel, and a small extra charge (Rs. 20) applies per additional item from the same seller.</li>
        </ul>
    </section>

    <section>
        <h2>Multiple Sellers in One Order</h2>
        <p>
            Artisan Valley is a marketplace of independent sellers. If your cart contains items from
            different sellers, your purchase is split into separate orders, one per seller. Each order
            has its own Order ID, Tracking ID and delivery status, so items may arrive on different days.
        </p>
    </section>

    <section>
        <h2>Payment</h2>
        <p>
            We currently accept Cash on Delivery (COD). You pay each order when it is delivered.
        </p>
    </section>

    <section>
        <h2>Order Tracking</h2>
        <p>
            After you place an order, you will receive a Tracking ID for each order (for example, AV-TRACK-XXXXXXXX)
            on the confirmation page and by email. Enter it on our
            <a asp-controller="Cart" asp-action="TrackOrder">Track Order</a> page to see your order status.
        </p>
    </section>

    <section>
        <h2>Damaged or Lost Items</h2>
        <p>
            If your item arrives damaged or is lost in transit, please contact us within 7 days.
            We will work with you to resolve the issue and offer a replacement or refund as per our
            <a asp-controller="Home" asp-action="Refund">Refund Policy</a>.
        </p>
    </section>

    <section>
        <h2>Contact Us</h2>
        <p>
            For questions regarding shipping, please contact us at:<br />
            <a href="mailto:artisanvalley@gmail.com">artisanvalley@gmail.com</a>
        </p>
    </section>

    <footer class="policy-note">
        Thank you for supporting our handmade small business ❤️
    </footer>
</main>