@{
    Layout = "_AdminLayout";
}

<style>
    .page-header { padding: 28px 35px 0; }
    .page-header h1 { font-size: 1.6rem; font-weight: 700; color: #1e1033; }
    .page-header p { color: #6b7280; font-size: 0.9rem; margin-top: 4px; }
    .content-area { padding: 24px 35px; }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
    }
    .stat-card {
        background: #fff;
        border-radius: 14px;
        padding: 22px;
        border: 1px solid #ede9fe;
        box-shadow: 0 2px 8px rgba(166,77,121,0.06);
        text-align: center;
    }
    .stat-icon {
        width: 50px; height: 50px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem;
        margin: 0 auto 12px;
    }
    .stat-value { font-size: 1.8rem; font-weight: 700; color: #1e1033; }
    .stat-label { font-size: 0.8rem; color: #6b7280; margin-top: 4px; }

    .section-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #ede9fe;
        overflow: hidden;
        margin-bottom: 24px;
    }
    .section-header {
        padding: 16px 22px;
        border-bottom: 1px solid #f5f0ff;
        font-size: 0.95rem;
        font-weight: 700;
        color: #1e1033;
    }
    .section-header i { color: #a64d79; margin-right: 8px; }

    .product-row {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 22px;
        border-bottom: 1px solid #f9f9f9;
    }
    .product-row:last-child { border-bottom: none; }
    .product-row img {
        width: 44px; height: 44px;
        border-radius: 8px; object-fit: cover;
        background: #f5f3ff;
    }
    .product-info { flex: 1; }
    .product-info .ptitle { font-size: 0.88rem; font-weight: 600; color: #1e1033; }
    .product-info .pcat { font-size: 0.75rem; color: #6b7280; margin-top: 2px; }
    .product-stock {
        font-size: 0.82rem; font-weight: 700;
        color: #a64d79;
        background: #fdf0f6;
        padding: 4px 12px;
        border-radius: 20px;
    }

    .revenue-big {
        text-align: center;
        padding: 30px;
        background: linear-gradient(135deg, #a64d79, #880e4f);
        border-radius: 14px;
        color: #fff;
        margin-bottom: 24px;
    }
    .revenue-big .label { font-size: 0.85rem; opacity: 0.8; margin-bottom: 8px; }
    .revenue-big .amount { font-size: 2.8rem; font-weight: 700; }
    .revenue-big .sub { font-size: 0.8rem; opacity: 0.7; margin-top: 6px; }

    @@media (max-width: 480px) {
        .page-header {
            padding: 20px 16px 0;
        }

        .content-area {
            padding: 16px;
        }

        .revenue-big {
            padding: 22px 16px;
        }

            .revenue-big .amount {
                font-size: 2rem;
            }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .product-row {
            padding: 12px 16px;
            gap: 10px;
        }
    }
</style>

<div class="page-header">
    <h1>Reports</h1>
    <p>Overview of ArtisanValley performance</p>
</div>

<div class="content-area">

    <!-- Revenue Banner -->
    <div class="revenue-big">
        <div class="label"><i class="fas fa-chart-line"></i> Total Revenue (Delivered Orders)</div>
        <div class="amount">Rs. @ViewBag.TotalRevenue.ToString("N0")</div>
        <div class="sub">From all successfully delivered orders</div>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon" style="background:#ede9fe;">
                <i class="fas fa-shopping-cart" style="color:#7c3aed;"></i>
            </div>
            <div class="stat-value">@ViewBag.TotalOrders</div>
            <div class="stat-label">Total Orders</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#fce4ec;">
                <i class="fas fa-store" style="color:#a64d79;"></i>
            </div>
            <div class="stat-value">@ViewBag.TotalSellers</div>
            <div class="stat-label">Active Sellers</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#e0f2fe;">
                <i class="fas fa-users" style="color:#0369a1;"></i>
            </div>
            <div class="stat-value">@ViewBag.TotalCustomers</div>
            <div class="stat-label">Customers</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#d1fae5;">
                <i class="fas fa-box" style="color:#059669;"></i>
            </div>
            <div class="stat-value">@ViewBag.TotalProducts</div>
            <div class="stat-label">Live Products</div>
        </div>
    </div>

    <!-- Top Products -->
    <div class="section-card">
        <div class="section-header">
            <i class="fas fa-star"></i> Top Products
        </div>
        @if (ViewBag.TopProducts != null)
        {
            foreach (var p in ViewBag.TopProducts)
            {
                <div class="product-row">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" alt="@p.Title" />
                    }
                    else
                    {
                        <div style="width:44px; height:44px; background:#f5f3ff; border-radius:8px; display:flex; align-items:center; justify-content:center;">
                            <i class="fas fa-box" style="color:#a64d79;"></i>
                        </div>
                    }
                    <div class="product-info">
                        <div class="ptitle">@p.Title</div>
                        <div class="pcat">@p.Category &nbsp;|&nbsp; Rs. @p.Price</div>
                    </div>
                    <div class="product-stock">Stock: @p.Stock</div>
                </div>
            }
        }
    </div>

</div>
