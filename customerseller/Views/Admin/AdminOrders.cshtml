@model List<customerseller.Models.Order>
@{
    Layout = "_AdminLayout";
}

<style>
    .page-header { padding: 28px 35px 0; }
    .page-header h1 { font-size: 1.6rem; font-weight: 700; color: #1e1033; }
    .page-header p { color: #6b7280; font-size: 0.9rem; margin-top: 4px; }
    .content-area { padding: 24px 35px; }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }
    .stat-card {
        background: #fff;
        border-radius: 12px;
        padding: 18px 22px;
        border: 1px solid #ede9fe;
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .stat-icon {
        width: 44px; height: 44px;
        border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem;
    }
    .stat-card h3 { font-size: 1.4rem; font-weight: 700; color: #1e1033; }
    .stat-card p { font-size: 0.78rem; color: #6b7280; margin-top: 2px; }

    .filter-bar {
        display: flex; gap: 10px; margin-bottom: 20px;
        flex-wrap: wrap; align-items: center;
        justify-content: space-between;
    }
    .filter-btns { display: flex; gap: 8px; }
    .filter-btn {
        padding: 7px 18px; border-radius: 20px;
        border: 1.5px solid #ede9fe; background: #fff;
        color: #6b7280; font-size: 0.82rem; font-weight: 600;
        cursor: pointer; font-family: inherit;
    }
    .filter-btn.active, .filter-btn:hover {
        background: #a64d79; color: #fff; border-color: #a64d79;
    }
    .search-input {
        padding: 9px 16px; border: 1.5px solid #ede9fe;
        border-radius: 10px; font-size: 0.88rem;
        font-family: inherit; outline: none; width: 240px;
    }
    .search-input:focus { border-color: #a64d79; }

    table {
        width: 100%; border-collapse: collapse;
        background: #fff; border-radius: 14px;
        overflow: hidden; border: 1px solid #ede9fe;
    }
    thead { background: #f5f3ff; }
    th {
        padding: 13px 18px; text-align: left;
        font-size: 0.75rem; font-weight: 700;
        color: #6b7280; text-transform: uppercase; letter-spacing: 0.8px;
    }
    td {
        padding: 14px 18px; font-size: 0.87rem;
        color: #1e1033; border-top: 1px solid #f3f4f6;
        vertical-align: middle;
    }
    tr:hover td { background: #fdf9ff; }

    .badge {
        padding: 4px 12px; border-radius: 20px;
        font-size: 0.75rem; font-weight: 700;
    }
    .badge-placed    { background: #e0f2fe; color: #0369a1; }
    .badge-shipped   { background: #fef3c7; color: #d97706; }
    .badge-delivered { background: #d1fae5; color: #059669; }
    .badge-cancelled { background: #fee2e2; color: #dc2626; }
    .badge-pending   { background: #f3f4f6; color: #6b7280; }

    .empty-state { text-align: center; padding: 60px; color: #9ca3af; }
    .empty-state i { font-size: 3rem; margin-bottom: 16px; display: block; }

    .table-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    @@media (max-width: 768px) {
        .page-header {
            padding: 20px 16px 0;
        }

        .content-area {
            padding: 16px;
        }

        .stats-row {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .filter-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-btns {
            overflow-x: auto;
            padding-bottom: 4px;
        }

        .search-input {
            width: 100%;
        }

        table {
            font-size: 0.82rem;
        }

        th, td {
            padding: 10px 12px;
        }
    }
</style>

<div class="page-header">
    <h1>Orders</h1>
    <p>All customer orders on ArtisanValley</p>
</div>

<div class="content-area">

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon" style="background:#ede9fe;">
                <i class="fas fa-shopping-cart" style="color:#7c3aed;"></i>
            </div>
            <div>
                <h3>@ViewBag.Total</h3>
                <p>Total Orders</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#fef3c7;">
                <i class="fas fa-clock" style="color:#d97706;"></i>
            </div>
            <div>
                <h3>@ViewBag.Pending</h3>
                <p>Pending</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#d1fae5;">
                <i class="fas fa-check-circle" style="color:#059669;"></i>
            </div>
            <div>
                <h3>@ViewBag.Delivered</h3>
                <p>Delivered</p>
            </div>
        </div>
    </div>

    <div class="filter-bar">
        <div class="filter-btns">
            <button class="filter-btn active" onclick="filterTable('all', this)">All</button>
            <button class="filter-btn" onclick="filterTable('Placed', this)">Placed</button>
            <button class="filter-btn" onclick="filterTable('Shipped', this)">Shipped</button>
            <button class="filter-btn" onclick="filterTable('Delivered', this)">Delivered</button>
            <button class="filter-btn" onclick="filterTable('Cancelled', this)">Cancelled</button>
        </div>
        <input type="text" class="search-input" placeholder="Search orders..."
               onkeyup="searchTable()" id="searchInput" />
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-shopping-cart"></i>
            <p>No orders yet.</p>
            <p style="font-size:0.8rem; margin-top:4px;">Orders will appear here once customers start buying.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
        <table id="ordersTable">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Amount</th>
                    <th>Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                    @foreach (var o in Model)
                    {
                        <tr data-status="@(o.Status ?? "Pending")">
                            <td style="font-family:monospace; font-size:0.82rem; color:#7c3aed;">
                                #@(o.OrderId?.Length > 8 ? o.OrderId.Substring(0, 8).ToUpper() : o.OrderId)
                            </td>
                            <td>
                                <div style="font-weight:600;">@(o.CustomerName ?? $"{o.FirstName} {o.LastName}")</div>
                                <div style="font-size:0.78rem; color:#6b7280;">@o.Email</div>
                            </td>
                            <td>
                                @if (o.Items != null && o.Items.Any())
                                {
                                    var pm = (Dictionary<string, object>)ViewBag.ProductMap;
                                    var cats = o.Items
                                        .Where(i => pm.ContainsKey(i.ProductId))
                                        .Select(i =>
                                        {
                                            dynamic p = pm[i.ProductId];
                                            string sub = p.SubCategory != null ? p.SubCategory.ToString() : "";
                                            return string.IsNullOrEmpty(sub) ? p.Category.ToString() : $"{p.Category} / {sub}";
                                        })
                                        .Distinct();

                                    <div style="font-weight:600;">@string.Join(", ", o.Items.Select(i => i.Title))</div>
                                    <div style="font-size:0.78rem; color:#6b7280;">
                                        Seller: @string.Join(", ", o.Items.Select(i => i.SellerShopName).Distinct())
                                    </div>
                                    <div style="font-size:0.75rem; color:#9ca3af;">@string.Join(", ", cats)</div>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td style="font-weight:700; color:#a64d79;">Rs. @o.Total.ToString("N0")</td>
                            <td style="font-size:0.82rem; color:#6b7280;">
                                @o.OrderDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
                            </td>
                            <td>
                                @{
                                    var statusClass = o.Status switch
                                    {
                                        "Placed" => "badge-placed",
                                        "Shipped" => "badge-shipped",
                                        "Delivered" => "badge-delivered",
                                        "Cancelled" => "badge-cancelled",
                                        _ => "badge-pending"
                                    };
                                }
                                <span class="badge @statusClass">@(o.Status ?? "Pending")</span>
                            </td>
                        </tr>
                    }
            </tbody>
        </table>
        </div>
    }
</div>

<script>
function filterTable(status, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('#ordersTable tbody tr').forEach(row => {
        row.style.display = (status === 'all' || row.dataset.status === status) ? '' : 'none';
    });
}

function searchTable() {
    const input = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('#ordersTable tbody tr').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(input) ? '' : 'none';
    });
}
</script>
