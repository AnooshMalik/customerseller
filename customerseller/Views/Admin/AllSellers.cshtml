@model List<customerseller.Models.User>
@{
    Layout = "_AdminLayout";
}

<style>
    .page-header {
        padding: 28px 35px 0;
    }

        .page-header h1 {
            font-size: 1.6rem;
            font-weight: 700;
            color: #1e1033;
        }

        .page-header p {
            color: #6b7280;
            font-size: 0.9rem;
            margin-top: 4px;
        }

    .content-area {
        padding: 24px 35px;
    }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border-radius: 12px;
        padding: 18px 22px;
        border: 1px solid #ede9fe;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-card h3 {
        font-size: 1.4rem;
        font-weight: 700;
        color: #1e1033;
    }

    .stat-card p {
        font-size: 0.78rem;
        color: #6b7280;
        margin-top: 2px;
    }

    .search-bar {
        display: flex;
        gap: 12px;
        margin-bottom: 20px;
    }

    .search-input {
        flex: 1;
        padding: 10px 16px;
        border: 1.5px solid #ede9fe;
        border-radius: 10px;
        font-size: 0.88rem;
        font-family: inherit;
        outline: none;
    }

        .search-input:focus {
            border-color: #a64d79;
        }

    table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #ede9fe;
    }

    thead {
        background: #f5f3ff;
    }

    th {
        padding: 13px 18px;
        text-align: left;
        font-size: 0.75rem;
        font-weight: 700;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }

    td {
        padding: 14px 18px;
        font-size: 0.87rem;
        color: #1e1033;
        border-top: 1px solid #f3f4f6;
    }

    tr:hover td {
        background: #fdf9ff;
    }

    .seller-name {
        font-weight: 600;
        color: #1e1033;
    }

    .seller-email {
        font-size: 0.8rem;
        color: #6b7280;
        margin-top: 2px;
    }

    .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #a64d79, #7c3aed);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .seller-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .btn-block {
        background: #fff;
        color: #dc2626;
        border: 1.5px solid #dc2626;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
    }

        .btn-block:hover {
            background: #fee2e2;
        }

    .empty-state {
        text-align: center;
        padding: 60px;
        color: #9ca3af;
    }

    .table-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    @@media (max-width: 768px) {
        .page-header {
            padding: 20px 16px 0;
        }

        .content-area {
            padding: 16px;
        }

        .stats-row {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .search-bar {
            flex-direction: column;
        }

        table {
            font-size: 0.82rem;
        }

        th, td {
            padding: 10px 12px;
        }
    }
</style>

<div class="page-header">
    <h1>All Sellers</h1>
    <p>Manage registered sellers on ArtisanValley</p>
</div>

<div class="content-area">

    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon" style="background:#ede9fe;">
                <i class="fas fa-users" style="color:#7c3aed;"></i>
            </div>
            <div>
                <h3>@Model.Count</h3>
                <p>Total Sellers</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#d1fae5;">
                <i class="fas fa-store" style="color:#059669;"></i>
            </div>
            <div>
                <h3>@ViewBag.ApprovedShops</h3>
                <p>Approved Shops</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#fef3c7;">
                <i class="fas fa-clock" style="color:#d97706;"></i>
            </div>
            <div>
                <h3>@ViewBag.PendingShops</h3>
                <p>Pending Shops</p>
            </div>
        </div>
    </div>

    <div class="search-bar">
        <input type="text" class="search-input" id="searchInput"
               placeholder="Search by name or email..." onkeyup="searchTable()" />
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-users" style="font-size:3rem; margin-bottom:16px; display:block;"></i>
            <p>No sellers found.</p>
        </div>
    }
    else
    {
        <div class="table-scroll">
            <table id="sellersTable">
                <thead>
                    <tr>
                        <th>Seller</th>
                        <th>Email</th>
                        <th>Shop</th>
                        <th>Shop Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var seller in Model)
                    {
                        var shop = ViewBag.Shops != null
                            ? ((List<customerseller.Models.SellerShop>)ViewBag.Shops)
                                .FirstOrDefault(s => s.SellerEmail == seller.Email)
                            : null;

                        <tr>
                            <td>
                                <div class="seller-cell">
                                    <div class="avatar">
                                        @(seller.FirstName?.Length > 0 ? seller.FirstName[0].ToString().ToUpper() : "S")
                                    </div>
                                    <div>
                                        <div class="seller-name">@seller.FirstName @seller.LastName</div>
                                    </div>
                                </div>
                            </td>
                            <td>@seller.Email</td>
                            <td>@(shop?.ShopName ?? "—")</td>
                            <td>
                                @if (shop != null)
                                {
                                    <span class="badge @(shop.AdminStatus == "Approved" ? "badge-approved" : shop.AdminStatus == "Rejected" ? "badge-rejected" : "badge-pending")">
                                        @(shop.AdminStatus ?? "Pending")
                                    </span>
                                }
                                else
                                {
                                    <span style="color:#9ca3af; font-size:0.82rem;">No shop</span>
                                }
                            </td>
                            <td>
                                @if (seller.IsBlocked)
                                {
                                    <div style="font-size:0.75rem; color:#dc2626; margin-bottom:4px;">
                                        @if (seller.BlockExpiry.HasValue)
                                        {
                                            <span>Blocked until @seller.BlockExpiry.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</span>
                                        }
                                        else
                                        {
                                            <span>Permanently Blocked</span>
                                        }
                                        @if (!string.IsNullOrEmpty(seller.BlockReason))
                                        {
                                            <br /><span>Reason: @seller.BlockReason</span>
                                        }
                                    </div>
                                    <button class="btn-block" style="border-color:#059669; color:#059669;" onclick="openUnblockModal(@seller.Id, this)">
                                        <i class="fas fa-unlock"></i> Unblock
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-block" onclick="openBlockModal(@seller.Id, this)">
                                        <i class="fas fa-ban"></i> Block
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div id="blockModalOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:9999; align-items:center; justify-content:center;">
            <div style="background:#fff; border-radius:16px; padding:28px; max-width:360px; width:90%; text-align:center;">
                <h3 style="font-size:1.1rem; font-weight:700; color:#1e1033; margin-bottom:16px;">Block Seller</h3>

                <div style="display:flex; flex-direction:column; gap:10px; margin-bottom:18px;">
                    <label style="display:flex; align-items:center; gap:8px; text-align:left; font-size:0.88rem; cursor:pointer;">
                        <input type="radio" name="blockType" value="temp" checked onchange="toggleDaysInput()"> Temporary Block
                    </label>
                    <select id="blockDays" style="padding:8px; border-radius:8px; border:1.5px solid #ede9fe; font-size:0.85rem;">
                        <option value="7">7 Days</option>
                        <option value="15">15 Days</option>
                        <option value="30">30 Days</option>
                    </select>

                    <textarea id="blockReason" placeholder="Enter reason for blocking..."
                              style="padding:8px; border-radius:8px; border:1.5px solid #ede9fe; font-size:0.85rem; resize:vertical; min-height:60px; font-family:inherit;"></textarea>

                    <label style="display:flex; align-items:center; gap:8px; text-align:left; font-size:0.88rem; cursor:pointer;">
                        <input type="radio" name="blockType" value="permanent" onchange="toggleDaysInput()"> Permanent Block
                    </label>
                </div>
                <div style="display:flex; gap:10px; justify-content:center;">
                    <button onclick="closeBlockModal()" style="padding:9px 20px; border-radius:8px; border:none; background:#e5e7eb; color:#374151; font-weight:600; cursor:pointer;">Cancel</button>
                    <button onclick="confirmBlock()" style="padding:9px 20px; border-radius:8px; border:none; background:#dc2626; color:#fff; font-weight:600; cursor:pointer;">Block</button>
                </div>
            </div>
        </div>
        <div id="unblockModalOverlay" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.45); z-index:9999; align-items:center; justify-content:center;">
            <div style="background:#fff; border-radius:16px; padding:28px; max-width:340px; width:90%; text-align:center;">
                <div style="width:52px; height:52px; border-radius:50%; background:#d1fae5; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
                    <i class="fas fa-unlock" style="color:#059669; font-size:1.3rem;"></i>
                </div>
                <h3 style="font-size:1.1rem; font-weight:700; color:#1e1033; margin-bottom:8px;">Unblock this seller?</h3>
                <p style="font-size:0.85rem; color:#6b7280; margin-bottom:22px;">They will regain full access to their seller account.</p>

                <div style="display:flex; gap:10px; justify-content:center;">
                    <button onclick="closeUnblockModal()" style="padding:9px 20px; border-radius:8px; border:none; background:#e5e7eb; color:#374151; font-weight:600; cursor:pointer;">Cancel</button>
                    <button onclick="confirmUnblock()" style="padding:9px 20px; border-radius:8px; border:none; background:#059669; color:#fff; font-weight:600; cursor:pointer;">Unblock</button>
                </div>
            </div>
        </div>
    }
</div>

<script>
    function searchTable() {
        const input = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('#sellersTable tbody tr').forEach(row => {
            row.style.display = row.innerText.toLowerCase().includes(input) ? '' : 'none';
        });
    }

    var blockingId = null;
    var blockingBtn = null;

    function openBlockModal(id, btn) {
        blockingId = id;
        blockingBtn = btn;
        document.getElementById('blockModalOverlay').style.display = 'flex';
    }

    function closeBlockModal() {
        document.getElementById('blockModalOverlay').style.display = 'none';
        blockingId = null;
        blockingBtn = null;
    }

    function toggleDaysInput() {
        var isTemp = document.querySelector('input[name="blockType"]:checked').value === 'temp';
        document.getElementById('blockDays').style.display = isTemp ? 'block' : 'none';
    }

    function confirmBlock() {
        var isTemp = document.querySelector('input[name="blockType"]:checked').value === 'temp';
        var days = isTemp ? parseInt(document.getElementById('blockDays').value) : null;
        var reason = document.getElementById('blockReason').value.trim();

        if (!reason) {
            document.getElementById('blockReason').style.border = '1.5px solid #dc2626';
            return;
        }

        fetch('/Admin/BlockUser', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: blockingId, days: days, reason: reason })
        })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.error || 'Something went wrong. Please login again as Admin.');
                }
            });
    }

    var unblockingId = null;

    function openUnblockModal(id, btn) {
        unblockingId = id;
        document.getElementById('unblockModalOverlay').style.display = 'flex';
    }

    function closeUnblockModal() {
        document.getElementById('unblockModalOverlay').style.display = 'none';
        unblockingId = null;
    }

    function confirmUnblock() {
        fetch('/Admin/UnblockUser', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: unblockingId })
        })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                } else {
                    alert(data.error || 'Something went wrong. Please login again as Admin.');
                }
            });
    }
</script>