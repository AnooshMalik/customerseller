@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Forgot Password - Artisan Valley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
   
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; min-height: 100vh; display: flex; }
        .left-panel {
            width: 45%;
            background: linear-gradient(135deg, #8e3a6e, #b05490, #7b2d6e);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 40px;
            position: relative;
            overflow: hidden;
        }
        .left-panel::before {
            content: '';
            position: absolute;
            width: 300px; height: 300px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
            top: -80px; left: -80px;
        }
        .left-panel::after {
            content: '';
            position: absolute;
            width: 200px; height: 200px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
            bottom: -50px; right: -50px;
        }
        .left-panel h1 {
            color: #fff;
            font-size: 2.8rem;
            font-weight: 300;
            letter-spacing: 2px;
            text-align: center;
            z-index: 1;
        }
        .left-panel h1 span { font-weight: 700; }
        .left-panel p {
            color: rgba(255,255,255,0.7);
            font-size: 0.8rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-top: 8px;
            z-index: 1;
        }
        .left-divider {
            width: 50px; height: 2px;
            background: rgba(255,255,255,0.4);
            margin: 25px auto;
            z-index: 1;
        }
        .left-quote {
            color: rgba(255,255,255,0.8);
            font-style: italic;
            font-size: 1rem;
            text-align: center;
            z-index: 1;
            max-width: 280px;
            line-height: 1.6;
        }
        .right-panel {
            width: 55%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #fafafa;
            padding: 60px 40px;
        }
        .form-box { width: 100%; max-width: 420px; }
        .icon-box {
            width: 65px; height: 65px;
            background: linear-gradient(135deg, #a64d79, #880e4f);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 20px;
        }
        .icon-box i { color: #fff; font-size: 1.6rem; }
        h2 { font-size: 1.8rem; color: #1a1a2e; font-weight: 600; margin-bottom: 8px; }
        .sub { color: #888; font-size: 0.88rem; margin-bottom: 30px; line-height: 1.6; }
        .error-box {
            background: #ffebee; color: #c62828;
            padding: 10px 14px; border-radius: 8px;
            margin-bottom: 15px; font-size: 0.9rem;
        }
        .success-box {
            background: #e8f5e9; color: #2e7d32;
            padding: 10px 14px; border-radius: 8px;
            margin-bottom: 15px; font-size: 0.9rem;
        }
        .field-label {
            display: block;
            font-size: 0.72rem;
            font-weight: 700;
            color: #999;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 8px;
        }
        input {
            width: 100%;
            padding: 14px 16px;
            border: 1.5px solid #e0e0e0;
            border-radius: 10px;
            font-size: 0.95rem;
            margin-bottom: 24px;
            outline: none;
            background: #fff;
            transition: border 0.3s;
        }
        input:focus { border-color: #a64d79; }
        .submit-btn {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #a64d79, #880e4f);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity 0.3s;
        }
        .submit-btn:hover { opacity: 0.9; }
        .back-link { text-align: center; margin-top: 20px; font-size: 0.85rem; }
        .back-link a { color: #a64d79; text-decoration: none; }
        .footer-text { text-align: center; margin-top: 30px; color: #bbb; font-size: 0.8rem; }

            @@media (max-width: 768px) {
                body {
                    flex-direction: column;
                }

                .left-panel {
                    width: 100%;
                    padding: 30px 20px;
                    min-height: auto;
                }

                    .left-panel h1 {
                        font-size: 1.8rem;
                    }

                .left-quote {
                    font-size: 0.9rem;
                    max-width: 100%;
                }

                .right-panel {
                    width: 100%;
                    padding: 30px 20px;
                }

                .form-box {
                    max-width: 100%;
                }
            }
    </style>
</head>
<body>
    <div class="left-panel">
        <h1><span>Artisan</span> Valley</h1>
        <p>Admin Portal</p>
        <div class="left-divider"></div>
        <div class="left-quote">"Crafted with care,<br>managed with precision."</div>
    </div>

    <div class="right-panel">
        <div class="form-box">
            <div class="icon-box">
                <i class="fa-solid fa-lock-open"></i>
            </div>
            <h2>Forgot Password?</h2>
            <p class="sub">Enter your admin email address. We'll send you a link to reset your password.</p>

            @if (TempData["ForgotError"] != null)
            {
                <div class="error-box">⚠️ @TempData["ForgotError"]</div>
            }
            @if (TempData["ForgotSuccess"] != null)
            {
                <div class="success-box">✅ @TempData["ForgotSuccess"]</div>
            }

            <form asp-controller="Admin" asp-action="ForgotPassword" method="post">
                <label class="field-label">Email Address</label>
                <input type="email" name="email"
                    placeholder="" required>
                <button type="submit" class="submit-btn">
                    <i class="fa-solid fa-paper-plane"></i> Send Reset Link
                </button>
            </form>

            <div class="back-link">
                <a href="/Admin/Login"><i class="fa-solid fa-arrow-left"></i> Back to Login</a>
            </div>
            <div class="footer-text">© 2065 Artisan Valley. All rights reserved.</div>
        </div>
    </div>
</body>
</html>