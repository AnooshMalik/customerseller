@model List<customerseller.Models.Product>
@{
    Layout = "_AdminLayout";
}

<style>
    .page-header { padding: 28px 35px 0; }
    .page-header h1 { font-size: 1.6rem; font-weight: 700; color: #1e1033; }
    .page-header p { color: #6b7280; font-size: 0.9rem; margin-top: 4px; }

    .filter-bar {
        padding: 20px 35px 0;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .filter-btn {
        padding: 7px 18px;
        border-radius: 20px;
        border: 1.5px solid #ede9fe;
        background: #fff;
        color: #6b7280;
        font-size: 0.82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

    .filter-btn.active, .filter-btn:hover {
        background: #a64d79;
        color: #fff;
        border-color: #a64d79;
    }

    .content-area { padding: 20px 35px; }

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-card {
        background: #fff;
        border-radius: 12px;
        padding: 18px 22px;
        border: 1px solid #ede9fe;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .stat-card h3 { font-size: 1.4rem; font-weight: 700; color: #1e1033; }
    .stat-card p { font-size: 0.78rem; color: #6b7280; margin-top: 2px; }

    .product-card {
        background: #fff;
        border-radius: 14px;
        padding: 20px 24px;
        margin-bottom: 16px;
        border: 1px solid #ede9fe;
        box-shadow: 0 2px 8px rgba(166,77,121,0.05);
        display: grid;
        grid-template-columns: 80px 1fr auto;
        gap: 18px;
        align-items: start;
    }

    .product-img {
        width: 80px;
        height: 80px;
        border-radius: 10px;
        object-fit: cover;
        background: #f5f3ff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #a64d79;
        font-size: 1.5rem;
    }

    .product-img img {
        width: 100%;
        height: 100%;
        border-radius: 10px;
        object-fit: cover;
    }

    .product-title { font-size: 1rem; font-weight: 700; color: #1e1033; }
    .product-meta { font-size: 0.82rem; color: #6b7280; margin-top: 3px; }

    .product-info {
        display: flex;
        gap: 20px;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .info-chip {
        font-size: 0.78rem;
        color: #6b7280;
    }

    .info-chip strong { color: #1e1033; }

    .badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-pending { background: #fef3c7; color: #d97706; }
    .badge-approved { background: #d1fae5; color: #059669; }
    .badge-rejected { background: #fee2e2; color: #dc2626; }

    .product-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-end;
        min-width: 140px;
    }

    .video-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ede9fe;
        color: #7c3aed;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        width: 100%;
        justify-content: center;
    }

    .notes-box {
        background: #f5f3ff;
        border-radius: 8px;
        padding: 10px 14px;
        margin-top: 10px;
        border-left: 3px solid #a64d79;
        font-size: 0.82rem;
        color: #4b5563;
    }

    .notes-box strong { color: #a64d79; font-size: 0.75rem; text-transform: uppercase; }

    .empty-state {
        text-align: center;
        padding: 60px;
        color: #9ca3af;
    }

    @@media (max-width: 640px) {
        .page-header {
            padding: 20px 16px 0;
        }

        .filter-bar {
            padding: 16px 16px 0;
        }

        .content-area {
            padding: 16px;
        }

        .stats-row {
            grid-template-columns: 1fr;
            gap: 10px;
        }

        .product-card {
            grid-template-columns: 60px 1fr;
            padding: 16px;
        }

        .product-img {
            width: 60px;
            height: 60px;
        }

        .product-actions {
            grid-column: 1 / -1;
            flex-direction: row;
            align-items: stretch;
            min-width: 0;
            margin-top: 10px;
        }

        .video-btn {
            width: auto;
            flex: 1;
        }
    }
</style>

<div class="page-header">
    <h1>Video Reviews</h1>
    <p>Monitor moderator decisions on product videos</p>
</div>

<div class="content-area">

    <!-- Stats -->
    <div class="stats-row">
        <div class="stat-card">
            <div class="stat-icon" style="background:#fef3c7;">
                <i class="fas fa-clock" style="color:#d97706;"></i>
            </div>
            <div>
                <h3>@Model.Count(p => p.VideoStatus == "Pending")</h3>
                <p>Pending Review</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#d1fae5;">
                <i class="fas fa-check-circle" style="color:#059669;"></i>
            </div>
            <div>
                <h3>@Model.Count(p => p.VideoStatus == "Approved")</h3>
                <p>Approved</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon" style="background:#fee2e2;">
                <i class="fas fa-times-circle" style="color:#dc2626;"></i>
            </div>
            <div>
                <h3>@Model.Count(p => p.VideoStatus == "Rejected")</h3>
                <p>Rejected</p>
            </div>
        </div>
    </div>

    <!-- Filter -->
    <div style="display:flex; gap:10px; margin-bottom:20px; flex-wrap:wrap;">
        <button class="filter-btn active" onclick="filterCards('all', this)">All</button>
        <button class="filter-btn" onclick="filterCards('Pending', this)">Pending</button>
        <button class="filter-btn" onclick="filterCards('Approved', this)">Approved</button>
        <button class="filter-btn" onclick="filterCards('Rejected', this)">Rejected</button>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-film" style="font-size:3rem; margin-bottom:16px; display:block;"></i>
            <p>No video reviews found.</p>
        </div>
    }
    else
    {
        @foreach (var p in Model)
        {
            <div class="product-card" data-status="@p.VideoStatus">
                <div class="product-img">
                    @if (!string.IsNullOrEmpty(p.ImageUrl))
                    {
                        <img src="@p.ImageUrl" alt="@p.Title" />
                    }
                    else
                    {
                        <i class="fas fa-box"></i>
                    }
                </div>

                <div>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <div class="product-title">@p.Title</div>
                        <span class="badge @(p.VideoStatus == "Approved" ? "badge-approved" : p.VideoStatus == "Rejected" ? "badge-rejected" : "badge-pending")">
                            @(p.VideoStatus ?? "Pending")
                        </span>
                    </div>
                    <div class="product-meta">@p.SellerName · @p.SellerEmail</div>

                    <div class="product-info">
                        <div class="info-chip"><strong>Category:</strong> @p.Category</div>
                        <div class="info-chip"><strong>Price:</strong> Rs. @p.Price</div>
                        @if (p.ReviewedAt.HasValue)
                        {
                            <div class="info-chip"><strong>Reviewed:</strong> @p.ReviewedAt.Value.ToString("dd MMM yyyy")</div>
                        }
                        @if (!string.IsNullOrEmpty(p.ReviewedBy))
                        {
                            <div class="info-chip"><strong>By:</strong> @p.ReviewedBy</div>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(p.RejectionReason))
                    {
                        <div class="notes-box">
                            <strong>Rejection Reason</strong><br />
                            @p.RejectionReason
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(p.InternalNotes))
                    {
                        <div class="notes-box">
                            <strong>Moderator Notes</strong><br />
                            @p.InternalNotes
                        </div>
                    }
                </div>

                <div class="product-actions">
                    @if (!string.IsNullOrEmpty(p.VideoUrl))
                    {
                        <a href="@p.VideoUrl" target="_blank" class="video-btn">
                            <i class="fas fa-play-circle"></i> Watch Video
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>

<script>
    function filterCards(status, btn) {
        document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        document.querySelectorAll('.product-card').forEach(card => {
            if (status === 'all' || card.dataset.status === status) {
                card.style.display = 'grid';
            } else {
                card.style.display = 'none';
            }
        });
    }
</script>