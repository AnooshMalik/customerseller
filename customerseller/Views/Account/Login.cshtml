

@{
    Layout = "_Layout";
}
<style>
    .login-container {
        display: flex;
        max-width: 900px;
        margin: 60px auto;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(166,77,121,0.15);
    }

    .login-sidebar {
        background: #a64d79;
        color: #fff;
        width: 40%;
        padding: 50px 35px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

        .login-sidebar h2 {
            margin-bottom: 12px;
            font-size: 1.6rem;
        }

        .login-sidebar p {
            font-size: 0.9rem;
            opacity: 0.9;
            line-height: 1.5;
        }

    .login-form-section {
        background: #fff;
        width: 60%;
        padding: 50px 40px;
    }

        .login-form-section h2 {
            margin-bottom: 24px;
            color: #1a1a2e;
        }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-size: 0.78rem;
            font-weight: 700;
            color: #888;
            text-transform: uppercase;
            margin-bottom: 6px;
            letter-spacing: 0.5px;
        }

        .form-group input {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.95rem;
            outline: none;
        }

            .form-group input:focus {
                border-color: #a64d79;
            }

    .forgot-link {
        margin-bottom: 18px;
        font-size: 0.85rem;
    }

        .forgot-link a {
            color: #a64d79;
            text-decoration: none;
        }

    .submit-btn {
        padding: 14px;
        background: #a64d79;
        color: #fff;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .signup-link-wrapper {
        text-align: center;
        margin-top: 20px;
        font-size: 0.85rem;
        color: #666;
    }

        .signup-link-wrapper a {
            color: #a64d79;
            text-decoration: none;
            font-weight: 600;
        }

    @@media (max-width: 768px) {
        .login-container {
            flex-direction: column;
            margin: 20px;
        }

        .login-sidebar, .login-form-section {
            width: 100%;
        }
    }
</style>
<div class="login-container">
    <div class="login-sidebar">
        <i class="fas fa-store-alt" style="font-size: 50px; margin-bottom: 20px;"></i>
        <h2>Welcome Back!</h2>
        <p>Login to access your shop dashboard, manage inventory, and track your artisan orders.</p>
    </div>

    <div class="login-form-section">
        <h2>Login</h2>

        <form asp-controller="Account" asp-action="Login" method="post" autocomplete="off">

            @if (ViewBag.Error != null)
            {
                <div style="background-color: #fce4ec; color: #d81b60; padding: 10px; border-radius: 5px; margin-bottom: 15px; font-size: 13px; border: 1px solid #f8bbd0;">
                    <i class="fas fa-exclamation-triangle"></i> @ViewBag.Error
                </div>
            }
            @if (TempData["LoginError"] != null)
            {
                <div style="background-color: #fce4ec; color: #d81b60; padding: 10px; border-radius: 5px; margin-bottom: 15px; font-size: 13px; border: 1px solid #f8bbd0;">
                    <i class="fas fa-exclamation-triangle"></i> @TempData["LoginError"]
                </div>
            }

            <!-- Dummy hidden fields to trick browser autofill -->
            <input type="text" style="display:none" autocomplete="username">
            <input type="password" style="display:none" autocomplete="new-password">

            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="Enter your email" required
                       autocomplete="off" readonly onfocus="this.removeAttribute('readonly')">
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password"
                       name="password"
                       id="userPassword"
                       placeholder=""
                       required
                       minlength="8"
                       autocomplete=""
                       readonly onfocus="this.removeAttribute('readonly')">
            </div>

            <input type="hidden" name="source" value="sellerpage" />

            <div class="forgot-link">
                <a href="javascript:void(0)" onclick="openForgotModal()">Forgot Password?</a>
            </div>

            <button type="submit" class="submit-btn" style="width:100%; cursor:pointer; border:none; outline:none;">
                Login to Shop
            </button>
        </form>

        <div class="signup-link-wrapper">
            New to Artisans? <a asp-controller="Login" asp-action="Signup">Create a Shop</a>
        </div>
    </div>
</div>

<!-- Forgot Password Modal -->
<div class="modal-overlay" id="forgotModal">
    <div class="modal-box">
        <div class="modal-header">
            <h3><i class="fa-solid fa-lock-open" style="color:#a64d79;"></i> Forgot Password</h3>
            <span class="modal-close" onclick="closeForgotModal()">&times;</span>
        </div>
        <div style="padding:20px;">
            <p style="font-size:0.85rem; color:#888; margin-bottom:18px;">Enter your registered email address. We'll send you a link to reset your password.</p>
            <input type="email" id="forgotEmail" placeholder="Email Address" style="width:100%; padding:12px 14px; border:1.5px solid #e0e0e0; border-radius:8px; font-size:0.9rem; margin-bottom:16px; outline:none;">
            <div id="forgotMsg" style="display:none; font-size:0.85rem; margin-bottom:14px;"></div>
            <div style="display:flex; gap:10px;">
                <button onclick="closeForgotModal()" style="flex:1; padding:12px; background:#f1f5f9; color:#555; border:none; border-radius:8px; font-weight:600; cursor:pointer;">Cancel</button>
                <button onclick="submitForgotPassword()" style="flex:1; padding:12px; background:#a64d79; color:#fff; border:none; border-radius:8px; font-weight:600; cursor:pointer;">Send Reset Link</button>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(30,16,50,0.5);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 14px;
        width: 380px;
        max-width: 90%;
        overflow: hidden;
    }

    .modal-header {
        padding: 18px 20px;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .modal-header h3 {
            font-size: 1rem;
            color: #1a1a2e;
        }

    .modal-close {
        cursor: pointer;
        color: #999;
        font-size: 1.3rem;
        line-height: 1;
    }
</style>

<script>
    function openForgotModal() {
        document.getElementById('forgotEmail').value = '';
        document.getElementById('forgotMsg').style.display = 'none';
        document.getElementById('forgotModal').classList.add('show');
    }

    function closeForgotModal() {
        document.getElementById('forgotModal').classList.remove('show');
    }

    async function submitForgotPassword() {
        const email = document.getElementById('forgotEmail').value.trim();
        const msgBox = document.getElementById('forgotMsg');

        if (!email) {
            msgBox.style.color = '#c62828';
            msgBox.textContent = 'Please enter your email address.';
            msgBox.style.display = 'block';
            return;
        }

        const formData = new FormData();
        formData.append('email', email);

        const res = await fetch('/Account/ResetPasswordAjax', { method: 'POST', body: formData });
        const data = await res.json();

        if (data.success) {
            msgBox.style.color = '#2e7d32';
            msgBox.textContent = data.message || 'Reset link sent to your email.';
        } else {
            msgBox.style.color = '#c62828';
            msgBox.textContent = data.message || 'Something went wrong.';
        }
        msgBox.style.display = 'block';
    }
</script>