@model string
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<style>
    .reset-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .reset-card {
        background: #fff;
        width: 100%;
        max-width: 420px;
        padding: 45px 40px;
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(166, 77, 121, 0.12);
        text-align: center;
    }

        .reset-card h2 {
            color: #a64d79;
            font-size: 1.7rem;
            font-weight: 800;
            margin-bottom: 8px;
        }

        .reset-card p {
            color: #888;
            font-size: 0.9rem;
            margin-bottom: 28px;
        }

        .reset-card label {
            display: block;
            text-align: left;
            font-size: 0.88rem;
            font-weight: 600;
            color: #555;
            margin-bottom: 6px;
        }

        .reset-card input[type=password] {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid #e8d0dc;
            border-radius: 10px;
            font-size: 0.95rem;
            color: #333;
            box-sizing: border-box;
            margin-bottom: 20px;
            outline: none;
            transition: border 0.2s;
        }

            .reset-card input[type=password]:focus {
                border-color: #a64d79;
            }

    .reset-btn {
        width: 100%;
        padding: 13px;
        background: #a64d79;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 1rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s;
    }

        .reset-btn:hover {
            background: #8c3d65;
        }

    @@media (max-width: 480px) {
        .reset-card {
            padding: 30px 24px;
            border-radius: 18px;
        }

            .reset-card h2 {
                font-size: 1.4rem;
            }
    }
</style>

<div class="reset-wrapper">
    <div class="reset-card">
        <h2>Reset Password</h2>
        <p>Enter your new password below.</p>

        <form method="post">
            <input type="hidden" name="token" value="@Model" />

            <label>New Password</label>
            <input type="password" name="newPassword"
                   placeholder="Enter new password (min 8 characters)"
                   required minlength="8" />

            <button type="submit" class="reset-btn">
                Reset Password
            </button>
        </form>
    </div>
</div>