@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ADMIN DASHBOARD - ArtisanValley</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --sidebar-bg: #a64d79;
                --sidebar-accent: #a64d79;
                --sidebar-hover: rgba(166, 77, 121, 0.15);
                --sidebar-active: rgba(166, 77, 121, 0.25);
                --sidebar-text: rgba(255, 255, 255, 0.75);
                --sidebar-text-muted: rgba(255, 255, 255, 0.35);
                --sidebar-border: rgba(255, 255, 255, 0.08);
                --logo-span: #e879a0;
                --badge-bg: #a64d79;
            }

            body {
                display: flex;
                min-height: 100vh;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                background: #f5f3ff;
            }

            #sidebar {
                width: 240px;
                min-height: 100vh;
                background: var(--sidebar-bg);
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0;
                left: 0;
                bottom: 0;
                z-index: 1000;
                overflow-y: auto;
                transition: transform 0.28s ease; /* NAYA */
            }

            .sidebar-content {
                display: flex;
                flex-direction: column;
                height: 100%;
            }

            .logo-area {
                padding: 24px 20px 18px;
                border-bottom: 1px solid var(--sidebar-border);
            }

                .logo-area h2 {
                    font-size: 1.4rem;
                    font-weight: 700;
                    color: #fff;
                    letter-spacing: 0.5px;
                }

                    .logo-area h2 span {
                        color: var(--logo-span);
                    }

                .logo-area .role-badge {
                    display: inline-block;
                    margin-top: 5px;
                    font-size: 0.65rem;
                    font-weight: 700;
                    letter-spacing: 1.2px;
                    text-transform: uppercase;
                    color: var(--logo-span);
                    background: rgba(232, 121, 160, 0.12);
                    border: 1px solid rgba(232, 121, 160, 0.25);
                    padding: 2px 8px;
                    border-radius: 20px;
                }

            /* nav sections */
            .nav-section-label {
                font-size: 0.62rem;
                font-weight: 700;
                letter-spacing: 1.4px;
                text-transform: uppercase;
                color: var(--sidebar-text-muted);
                padding: 18px 20px 6px;
            }

            nav a {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 20px;
                color: var(--sidebar-text);
                text-decoration: none;
                font-size: 0.88rem;
                border-left: 3px solid transparent;
                transition: all 0.18s ease;
                position: relative;
            }

                nav a:hover {
                    background: var(--sidebar-hover);
                    color: #fff;
                }

                nav a.nav-active,
                .nav-active a {
                    background: var(--sidebar-active);
                    color: #fff;
                    border-left-color: var(--sidebar-accent);
                }

                nav a i {
                    width: 18px;
                    text-align: center;
                    font-size: 0.95rem;
                    flex-shrink: 0;
                }

                /* notification badge on nav */
                nav a .nav-badge {
                    margin-left: auto;
                    background: var(--badge-bg);
                    color: #fff;
                    font-size: 0.65rem;
                    font-weight: 700;
                    padding: 2px 7px;
                    border-radius: 20px;
                    min-width: 20px;
                    text-align: center;
                }

            /* divider */
            .nav-divider {
                margin: 8px 20px;
                border: none;
                border-top: 1px solid var(--sidebar-border);
            }

            .logout-style {
                color: rgba(255, 100, 100, 0.7) !important;
            }

                .logout-style:hover {
                    background: rgba(255, 80, 80, 0.1) !important;
                    color: #ff8080 !important;
                }

            /* bottom courier link */
            .sidebar-footer {
                margin-top: auto;
                padding: 12px 20px;
                border-top: 1px solid var(--sidebar-border);
            }

                .sidebar-footer a {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                    color: var(--sidebar-text-muted);
                    text-decoration: none;
                    font-size: 0.72rem;
                    letter-spacing: 0.5px;
                    transition: color 0.18s;
                }

                    .sidebar-footer a:hover {
                        color: rgba(255,255,255,0.5);
                    }

            main {
                margin-left: 240px;
                flex: 1;
                min-height: 100vh;
                width: 100%;
                min-width: 0;
            }

            #logoutPopup {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(26, 10, 46, 0.6);
                z-index: 99999;
                align-items: center;
                justify-content: center;
            }

            .logout-modal {
                background: #fff;
                border-radius: 16px;
                padding: 32px;
                width: 380px;
                max-width: 90vw; /* NAYA */
                text-align: center;
                border: 1px solid #ddd6fe;
            }

            .logout-icon-wrap {
                width: 56px;
                height: 56px;
                background: #fdf0f6;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin: 0 auto 16px;
            }

            .logout-modal h3 {
                font-size: 1.1rem;
                font-weight: 700;
                color: #1e1033;
                margin-bottom: 8px;
            }

            .logout-modal p {
                font-size: 0.85rem;
                color: #6b7280;
                margin-bottom: 24px;
            }

            .logout-btns {
                display: flex;
                gap: 10px;
            }

            .btn-cancel {
                flex: 1;
                padding: 11px;
                border-radius: 10px;
                border: 1.5px solid #ddd6fe;
                background: #f5f3ff;
                color: #6b7280;
                font-size: 0.9rem;
                font-weight: 600;
                cursor: pointer;
                font-family: inherit;
            }

            .btn-logout {
                flex: 1;
                padding: 11px;
                border-radius: 10px;
                border: none;
                background: #a64d79;
                color: #fff;
                font-size: 0.9rem;
                font-weight: 600;
                cursor: pointer;
                text-decoration: none;
                display: flex;
                align-items: center;
                justify-content: center;
            }
            /* ── MOBILE TOPBAR (hamburger) ── */
            #mobileTopbar {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: 56px;
                background: var(--sidebar-bg);
                align-items: center;
                justify-content: space-between;
                padding: 0 16px;
                z-index: 900;
            }

                #mobileTopbar h2 {
                    color: #fff;
                    font-size: 1.1rem;
                    font-weight: 700;
                }

                    #mobileTopbar h2 span {
                        color: var(--logo-span);
                    }

            #hamburgerBtn {
                background: none;
                border: none;
                color: #fff;
                font-size: 1.3rem;
                cursor: pointer;
                padding: 8px;
                line-height: 1;
            }

            #sidebarOverlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.4);
                z-index: 999;
            }

            @@media (max-width: 900px) {
                #sidebar {
                    transform: translateX(-100%);
                    top: 56px;
                    z-index: 1000;
                }

                    #sidebar.open {
                        transform: translateX(0);
                    }

                #mobileTopbar {
                    display: flex;
                }

                #sidebarOverlay.open {
                    display: block;
                }

                main {
                    margin-left: 0;
                    margin-top: 56px;
                }
            }

            @@media (max-width: 768px) {
                .stats-grid {
                    grid-template-columns: 1fr 1fr;
                    gap: 12px;
                }

                .stat-card {
                    padding: 14px;
                    flex-direction: column;
                    text-align: center;
                    gap: 8px;
                }

                .stat-number {
                    font-size: 1.3rem;
                }

                .topbar {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 10px;
                }

                .main-content {
                    padding: 20px 16px;
                }
            }

            @@media (max-width: 480px) {
                .stats-grid {
                    grid-template-columns: 1fr;
                }
            }
    </style>
</head>
<body>
    <!-- MOBILE TOPBAR WITH HAMBURGER -->
    <div id="mobileTopbar">
        <h2>Artisan<span>Valley</span></h2>
        <button id="hamburgerBtn" onclick="toggleSidebar()" aria-label="Menu">
            <i class="fas fa-bars"></i>
        </button>
    </div>

    <!-- OVERLAY -->
    <div id="sidebarOverlay" onclick="closeSidebar()"></div>
    <aside id="sidebar">
        <div class="sidebar-content">

            <div class="logo-area">
                <h2>Artisan<span>Valley</span></h2>
                <span class="role-badge">Admin Panel</span>
            </div>

            <nav>
                <!-- OVERVIEW -->
                <div class="nav-section-label">Overview</div>

                <div class="nav-active">
                    <a asp-controller="Admin" asp-action="Dashboard">
                        <i class="fas fa-th-large"></i> Dashboard
                    </a>
                </div>

                <!-- SELLER MANAGEMENT -->
                <div class="nav-section-label">Sellers</div>

                <a asp-controller="Admin" asp-action="ShopRequests">
                    <i class="fas fa-store"></i> Shop Requests
                    <span class="nav-badge" id="shopRequestCount">0</span>
                </a>

                <a asp-controller="Admin" asp-action="AllSellers">
                    <i class="fas fa-users"></i> All Sellers
                </a>

               
                <a asp-controller="Admin" asp-action="Products">
                    <i class="fas fa-box"></i> Products
                    <span class="nav-badge" id="productCount">0</span>
                </a>

                <!-- ORDERS & FINANCE -->
                <div class="nav-section-label">Finance</div>

                <a asp-controller="Admin" asp-action="Orders">
                    <i class="fas fa-shopping-cart"></i> Orders
                </a>

                <a asp-controller="Admin" asp-action="Reports">
                    <i class="fas fa-chart-bar"></i> Reports
                </a>

                <a asp-controller="Admin" asp-action="Complaints">
                    <i class="fas fa-flag"></i> Complaints
                    <span class="nav-badge" id="complaintCount">0</span>
                </a>

                <!-- SYSTEM -->
                <hr class="nav-divider" />
                <a asp-controller="Chat" asp-action="Messages">
                    <i class="fas fa-comment-dots"></i> Messages
                    <span class="nav-badge" id="chatUnreadCount" style="display:none;">0</span>
                </a>

                <a asp-controller="Admin" asp-action="Settings">
                    <i class="fas fa-cog"></i> Settings
                </a>

                <a href="#" class="logout-style" onclick="confirmLogout(event)">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </nav>

           

        </div>
    </aside>

    <!-- LOGOUT POPUP -->
    <div id="logoutPopup" style="display:none; position:fixed; inset:0; background:rgba(26,10,46,0.6); z-index:99999; align-items:center; justify-content:center;">
        <div class="logout-modal">
            <div class="logout-icon-wrap">
                <i class="fas fa-sign-out-alt" style="font-size:1.4rem; color:#a64d79;"></i>
            </div>
            <h3>Logout?</h3>
            <p>Are you sure you want to logout from ArtisanValley Admin?</p>
            <div class="logout-btns">
                <button onclick="cancelLogout()" class="btn-cancel">Cancel</button>
                <a href="@Url.Action("Logout", "Admin")" class="btn-logout">Yes, Logout</a>
            </div>
        </div>
    </div>

    <main>
        @RenderBody()
    </main>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script>
        function confirmLogout(e) {
        e.preventDefault();
        document.getElementById('logoutPopup').style.display = 'flex';
        }

        function cancelLogout() {
        document.getElementById('logoutPopup').style.display = 'none';
        }
        function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('open');
        document.getElementById('sidebarOverlay').classList.toggle('open');
        }

        function closeSidebar() {
        document.getElementById('sidebar').classList.remove('open');
        document.getElementById('sidebarOverlay').classList.remove('open');
        }

        document.querySelectorAll('nav a').forEach(function (link) {
        link.addEventListener('click', function () {
        if (window.innerWidth <= 900) {
        closeSidebar();
        }
        });
        });
        // Active nav link highlight
        (function () {
        var path = window.location.pathname.toLowerCase();
        document.querySelectorAll('nav a').forEach(function (link) {
        if (link.href && link.href !== '#') {
        var linkPath = new URL(link.href, window.location.origin).pathname.toLowerCase();
        if (path.startsWith(linkPath) && linkPath !== '/') {
        link.parentElement.classList.contains('nav-active')
        ? null
        : link.classList.add('nav-active');
        }
        }
        });
        })();


        async function loadSidebarCounts() {
        try {
        const res = await fetch('/Admin/GetPendingShops');
        const shops = await res.json();
        if (shops && !shops.error) {
        document.getElementById('shopRequestCount').textContent = shops.length;
        }
        } catch(e) {}

        try {
        const res2 = await fetch('/Admin/GetOpenComplaints');
        const data = await res2.json();
        if (data && !data.error) {
        document.getElementById('complaintCount').textContent = data.count;
        }
        } catch(e) {}

        try {
        const res3 = await fetch('/Admin/GetPendingProducts');
        const products = await res3.json();
        if (products && !products.error) {
        document.getElementById('productCount').textContent = products.length;
        }
        try {
        const res4 = await fetch('/Chat/GetUnreadCount');
        const data4 = await res4.json();
        const badge = document.getElementById('chatUnreadCount');
        if (data4.count > 0) {
        badge.textContent = data4.count;
        badge.style.display = 'inline-block';
        }
        } catch(e) {}
        } catch(e) {}
        }

        loadSidebarCounts();
    </script>
</body>
</html>
