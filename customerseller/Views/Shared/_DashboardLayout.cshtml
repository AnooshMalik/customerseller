@using Microsoft.Data.SqlClient
@using customerseller.Models
@inject IConfiguration Configuration
@{
    Layout = null;

    bool isApproved = true;

    var sellerEmail = Context.Session.GetString("UserEmail");
    var sellerRole = Context.Session.GetString("UserRole");

    DateTime? subscriptionEnd = null;

    if (sellerRole == "Seller" && !string.IsNullOrEmpty(sellerEmail))
    {
        using var con = new SqlConnection(Configuration.GetConnectionString("DefaultConnection"));
        con.Open();

        var cmd = new SqlCommand("SELECT IsApproved, SubscriptionEnd FROM SellerShops WHERE SellerEmail = @email", con);
        cmd.Parameters.AddWithValue("@email", sellerEmail);

        var reader2 = cmd.ExecuteReader();
        if (reader2.Read())
        {
            isApproved = reader2["IsApproved"] != DBNull.Value && (bool)reader2["IsApproved"];
            subscriptionEnd = reader2["SubscriptionEnd"] != DBNull.Value ? (DateTime?)reader2["SubscriptionEnd"] : null;
        }
        reader2.Close();
    }

    bool isSubscriptionLocked = false;
    bool isSubscriptionGrace = false;
    int graceDaysLeft = 0;

    if (subscriptionEnd.HasValue)
    {
        var daysSinceExpiry = (DateTime.Now - subscriptionEnd.Value).TotalDays;
        if (daysSinceExpiry > 2)
        {
            isSubscriptionLocked = true;
        }
        else if (daysSinceExpiry > 0)
        {
            isSubscriptionGrace = true;
            graceDaysLeft = 2 - (int)Math.Floor(daysSinceExpiry);
        }
    }

    bool isTempBlocked = false;
    string blockReason = "";
    string blockUntil = "";
    bool hasPendingPayment = false;
    bool isChatPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Chat";
    bool isSubscriptionPage = ViewContext.RouteData.Values["controller"]?.ToString() == "Subscription";

    if (sellerRole == "Seller" && !string.IsNullOrEmpty(sellerEmail))
    {
        using var conPay = new SqlConnection(Configuration.GetConnectionString("DefaultConnection"));
        conPay.Open();
        var payCmd = new SqlCommand("SELECT COUNT(*) FROM PaymentSubmissions WHERE SellerEmail = @email AND Status = 'Pending'", conPay);
        payCmd.Parameters.AddWithValue("@email", sellerEmail);
        hasPendingPayment = (int)payCmd.ExecuteScalar() > 0;
    }
    if (sellerRole == "Seller" && !string.IsNullOrEmpty(sellerEmail))
    {
        using var conBlock = new SqlConnection(Configuration.GetConnectionString("DefaultConnection"));
        conBlock.Open();
        var blockCmd = new SqlCommand("SELECT IsBlocked, BlockExpiry, BlockReason FROM Users WHERE Email = @email", conBlock);
        blockCmd.Parameters.AddWithValue("@email", sellerEmail);
        var blockReader = blockCmd.ExecuteReader();
        if (blockReader.Read())
        {
            bool isBlocked = blockReader["IsBlocked"] != DBNull.Value && (bool)blockReader["IsBlocked"];
            if (isBlocked)
            {
                var expiry = blockReader["BlockExpiry"] != DBNull.Value ? (DateTime?)blockReader["BlockExpiry"] : null;
                if (expiry.HasValue)
                {
                    isTempBlocked = true;
                    blockUntil = expiry.Value.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
                }
                blockReason = blockReader["BlockReason"]?.ToString() ?? "No reason provided";
            }
        }
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SELLER DASHBOARD</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="~/seller/css/site.css" rel="stylesheet" />
    <style>
            #mobileTopbar {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: 56px;
                background: #a64d79;
                align-items: center;
                justify-content: space-between;
                padding: 0 16px;
                z-index: 1100;
            }

                #mobileTopbar h2 {
                    color: #fff;
                    font-size: 1.1rem;
                    font-weight: 700;
                }

                    #mobileTopbar h2 span {
                        color: rgba(255,255,255,0.6);
                    }

            #hamburgerBtn {
                background: none;
                border: none;
                color: #fff;
                font-size: 1.3rem;
                cursor: pointer;
                padding: 8px;
            }

            #sidebarOverlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.4);
                z-index: 999;
            }

            .nav-disabled {
                opacity: 0.45;
                cursor: not-allowed !important;
                pointer-events: none;
                position: relative;
            }

                .nav-disabled::after {
                    content: "\f023";
                    font-family: "Font Awesome 6 Free";
                    font-weight: 900;
                    margin-left: auto;
                    font-size: 0.75rem;
                    opacity: 0.8;
                }

            @@media (max-width: 900px) {
                #sidebar {
                    transform: translateX(-100%);
                    transition: transform 0.28s ease;
                    top: 56px;
                }

                    #sidebar.open {
                        transform: translateX(0);
                    }

                #mobileTopbar {
                    display: flex;
                }

                #sidebarOverlay.open {
                    display: block;
                }

                main {
                    margin-left: 0 !important;
                    margin-top: 56px;
                }
            }
    </style>
</head>
<body>
    <div id="mobileTopbar">
        <h2>Artisan<span>Valley</span></h2>
        <button id="hamburgerBtn" onclick="toggleSidebar()" aria-label="Menu">
            <i class="fas fa-bars"></i>
        </button>
    </div>
    <div id="sidebarOverlay" onclick="closeSidebar()"></div>
    <aside id="sidebar">
        <div class="vertical-text">SELLER DASHBOARD</div>
        <div class="sidebar-content">
            <div class="logo-area">
                <h2>Artisan<span>Valley</span></h2>
            </div>

            @if (!isApproved)
            {
                <div style="background:#fff3cd; color:#856404; font-size:0.72rem; padding:8px 12px; margin:0 12px 10px; border-radius:8px; text-align:center;">
                    <i class="fas fa-clock"></i> Pending admin approval
                </div>
            }


            <nav>
                <div class="nav-active">
                    <a asp-controller="Dashboard" asp-action="Dashboard">
                        <i class="fas fa-th-large"></i> Dashboard
                    </a>
                </div>
                <a asp-controller="Products" asp-action="SellerProduct">
                    <i class="fas fa-box"></i> Products
                </a>
                <a asp-controller="Products" asp-action="BulkUpload">
                    <i class="fas fa-file-excel"></i> Bulk Upload
                </a>

                @if (isApproved)
                {
                    <a asp-controller="Chat" asp-action="Messages">
                        <i class="fas fa-comment-dots"></i> Messages
                        <span id="chatUnreadBadge" style="margin-left:auto; background:#dc2626; color:#fff; font-size:0.65rem; font-weight:700; padding:2px 7px; border-radius:20px; min-width:18px; text-align:center; display:none;"></span>
                    </a>
                    <a asp-controller="Orders" asp-action="Order">
                        <i class="fas fa-shopping-cart"></i> Orders
                        <span id="orderCountBadge" style="margin-left:auto; background:#a64d79; color:#fff; font-size:0.65rem; font-weight:700; padding:2px 7px; border-radius:20px; min-width:18px; text-align:center; display:none;"></span>
                    </a>
                    <a asp-controller="SellerComplaint" asp-action="Index">
                        <i class="fas fa-flag"></i> Complaints
                        <span id="sellerComplaintBadge" style="display:none; margin-left:auto; background:#dc2626; color:#fff; font-size:0.65rem; font-weight:700; padding:2px 7px; border-radius:20px; min-width:18px; text-align:center;"></span>
                    </a>
                    <a asp-controller="Review" asp-action="SellerReviews">
                        <i class="fas fa-star"></i> Reviews
                    </a>
                    <a asp-controller="Payments" asp-action="Payments">
                        <i class="fas fa-wallet"></i> Payments
                    </a>

                }

                else
                {
                    <a href="javascript:void(0)" class="nav-disabled" title="Available after admin approval">
                        <i class="fas fa-comment-dots"></i> Messages
                    </a>
                    <a href="javascript:void(0)" class="nav-disabled" title="Available after admin approval">
                        <i class="fas fa-shopping-cart"></i> Orders
                    </a>
                    <a href="javascript:void(0)" class="nav-disabled" title="Available after admin approval">
                        <i class="fas fa-flag"></i> Complaints
                    </a>
                    <a href="javascript:void(0)" class="nav-disabled" title="Available after admin approval">
                        <i class="fas fa-star"></i> Reviews
                    </a>
                    <a href="javascript:void(0)" class="nav-disabled" title="Available after admin approval">
                        <i class="fas fa-wallet"></i> Payments
                    </a>
                }
                <a asp-controller="Subscription" asp-action="Pay">
                    <i class="fas fa-credit-card"></i> Subscription
                </a>

                <a asp-controller="Profile" asp-action="Profile">
                    <i class="fas fa-user-circle"></i> Profile
                </a>
                <a href="#" class="logout-style" onclick="confirmLogout(event)">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </nav>

        </div>
    </aside>
    <div id="logoutPopup" style="display:none; position:fixed; inset:0; background:rgba(30,16,80,0.5); z-index:99999; align-items:center; justify-content:center;">
        <div style="background:#fff; border-radius:16px; padding:32px; width:380px; text-align:center; border:1px solid #ddd6fe;">
            <div style="width:56px; height:56px; background:#fdf0f6; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
                <i class="fas fa-sign-out-alt" style="font-size:1.4rem; color:#a64d79;"></i>
            </div>
            <h3 style="font-size:1.1rem; font-weight:700; color:#1e1033; margin-bottom:8px;">Logout?</h3>
            <p style="font-size:0.85rem; color:#6b7280; margin-bottom:24px;">Are you sure you want to logout from ArtisanValley?</p>
            <div style="display:flex; gap:10px;">
                <button onclick="cancelLogout()" style="flex:1; padding:11px; border-radius:10px; border:1.5px solid #ddd6fe; background:#f5f3ff; color:#6b7280; font-size:0.9rem; font-weight:600; cursor:pointer; font-family:inherit;">
                    Cancel
                </button>
                <a href="@Url.Action("Logout", "Account")" style="flex:1; padding:11px; border-radius:10px; border:none; background:#a64d79; color:#fff; font-size:0.9rem; font-weight:600; cursor:pointer; text-decoration:none; display:flex; align-items:center; justify-content:center;">
                    Yes, Logout
                </a>
            </div>
        </div>
    </div>
    <main style="position:relative;">
        @if (isTempBlocked)
        {
            <div style="position:sticky; top:0; z-index:5000; background:#fee2e2; border-bottom:2px solid #dc2626; padding:14px 24px; display:flex; align-items:center; gap:10px;">
                <i class="fas fa-lock" style="color:#dc2626; font-size:1.1rem;"></i>
                <div>
                    <strong style="color:#991b1b;">Your shop is temporarily blocked until @blockUntil.</strong>
                    <div style="font-size:0.85rem; color:#7f1d1d; margin-top:2px;">Reason: @blockReason</div>
                    @if (!isChatPage)
                    {
                        <div style="font-size:0.8rem; color:#7f1d1d; margin-top:4px;">You can still use Messages to contact support.</div>
                    }
                </div>
            </div>

            @if (isChatPage)
            {
                @RenderBody()
            }
            else
            {
                <div style="position:relative;">
                    <div style="pointer-events:none; opacity:0.5;">
                        @RenderBody()
                    </div>
                    <div style="position:absolute; inset:0; z-index:10;"></div>
                </div>
            }
        }
        else if (isSubscriptionLocked)
        {
            @if (hasPendingPayment)
            {
                <div style="position:sticky; top:0; z-index:5000; background:#dbeafe; border-bottom:2px solid #2563eb; padding:14px 24px; display:flex; align-items:center; gap:10px;">
                    <i class="fas fa-clock" style="color:#2563eb; font-size:1.1rem;"></i>
                    <div>
                        <strong style="color:#1e3a8a;">Payment submitted, awaiting review.</strong>
                        <div style="font-size:0.85rem; color:#1e40af; margin-top:2px;">
                            Your dashboard will unlock automatically once our team approves your payment.
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div style="position:sticky; top:0; z-index:5000; background:#fee2e2; border-bottom:2px solid #dc2626; padding:14px 24px; display:flex; align-items:center; gap:10px;">
                    <i class="fas fa-lock" style="color:#dc2626; font-size:1.1rem;"></i>
                    <div>
                        <strong style="color:#991b1b;">Your dashboard is locked due to an unpaid subscription.</strong>
                        <div style="font-size:0.85rem; color:#7f1d1d; margin-top:2px;">Please complete your payment to restore access.</div>
                        @if (!isChatPage && !isSubscriptionPage)
                        {
                            <a asp-controller="Subscription" asp-action="Pay" style="display:inline-block; margin-top:8px; background:#dc2626; color:#fff; padding:6px 16px; border-radius:6px; font-size:0.82rem; font-weight:600; text-decoration:none;">
                                Pay Now
                            </a>
                        }
                    </div>
                </div>
            }
            @if (isChatPage || isSubscriptionPage)
            {
                @RenderBody()
            }
            else
            {
                <div style="position:relative;">
                    <div style="pointer-events:none; opacity:0.5;">
                        @RenderBody()
                    </div>
                    <div style="position:absolute; inset:0; z-index:10;"></div>
                </div>
            }
        }
        else
        {
            @if (isSubscriptionGrace)
            {
                @if (hasPendingPayment)
                {
                    <div style="position:sticky; top:0; z-index:5000; background:#dbeafe; border-bottom:2px solid #2563eb; padding:14px 24px; display:flex; align-items:center; gap:10px;">
                        <i class="fas fa-clock" style="color:#2563eb; font-size:1.1rem;"></i>
                        <div>
                            <strong style="color:#1e3a8a;">Payment submitted, awaiting review.</strong>
                            <div style="font-size:0.85rem; color:#1e40af; margin-top:2px;">
                                Our team will verify your payment shortly. Your dashboard will unlock automatically once approved.
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div style="position:sticky; top:0; z-index:5000; background:#fff3cd; border-bottom:2px solid #d97706; padding:14px 24px; display:flex; align-items:center; gap:10px;">
                        <i class="fas fa-exclamation-triangle" style="color:#d97706; font-size:1.1rem;"></i>
                        <div>
                            <strong style="color:#92400e;">Your subscription has expired.</strong>
                            <div style="font-size:0.85rem; color:#78350f; margin-top:2px;">
                                Please pay within @graceDaysLeft day@(graceDaysLeft != 1 ? "s" : "") to avoid your dashboard being locked.
                            </div>
                            @if (!isSubscriptionPage)
                            {
                                <a asp-controller="Subscription" asp-action="Pay" style="display:inline-block; margin-top:8px; background:#d97706; color:#fff; padding:6px 16px; border-radius:6px; font-size:0.82rem; font-weight:600; text-decoration:none;">
                                    Pay Now
                                </a>
                            }
                        </div>
                    </div>
                }
            }
            @RenderBody()
        }
    </main>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script>
        function confirmLogout(e) {
        e.preventDefault();
        document.getElementById('logoutPopup').style.display = 'flex';
        }
        function toggleSidebar() {
        document.getElementById('sidebar').classList.toggle('open');
        document.getElementById('sidebarOverlay').classList.toggle('open');
        }
        function closeSidebar() {
        document.getElementById('sidebar').classList.remove('open');
        document.getElementById('sidebarOverlay').classList.remove('open');
        }
        document.querySelectorAll('nav a').forEach(function (link) {
        link.addEventListener('click', function () {
        if (window.innerWidth <= 900) closeSidebar();
        });
        });
        function cancelLogout() {
        document.getElementById('logoutPopup').style.display = 'none';
        }
    </script>
    <script>
        async function loadSellerComplaintBadge() {
        try {
        const res = await fetch('/SellerComplaint/GetCount');
        const data = await res.json();
        const badge = document.getElementById('sellerComplaintBadge');
        if (data.count > 0) {
        badge.textContent = data.count;
        } else {
        badge.style.display = 'none';
        }
        } catch(e) {}
        }
        @(isApproved ? "loadSellerComplaintBadge();" : "")

        async function loadOrderBadge() {
        try {
        const res = await fetch('/Orders/GetOrderCount');
        const data = await res.json();
        const badge = document.getElementById('orderCountBadge');
        if (data.count > 0) {
        badge.textContent = data.count;
        badge.style.display = 'inline-block';
        }
        } catch(e) {}
        }
        @(isApproved ? "loadOrderBadge();" : "")

        async function loadChatUnreadBadge() {
        try {
        const res = await fetch('/Chat/GetUnreadCount');
        const data = await res.json();
        const badge = document.getElementById('chatUnreadBadge');
        if (data.count > 0) {
        badge.textContent = data.count;
        badge.style.display = 'inline-block';
        } else {
        badge.style.display = 'none';
        }
        } catch(e) {}
        }
        @(isApproved ? "loadChatUnreadBadge(); setInterval(loadChatUnreadBadge, 10000);" : "")
    </script>
</body>
</html>