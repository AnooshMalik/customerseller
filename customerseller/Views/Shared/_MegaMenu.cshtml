<script>
  const megaItem    = document.querySelector('.mega-item');
  const megaPanel   = document.querySelector('.mega-panel');
  const megaNavLink = document.querySelector('.mega-nav-link');
  let hideTimer;
 
  megaItem.addEventListener('mouseenter', () => {
    clearTimeout(hideTimer);
 
    // ✅ Navbar ke neeche bilkul sahi position
    const navbarEl = megaItem.closest('header') || megaItem.closest('nav');
    if (navbarEl) {
      const rect = navbarEl.getBoundingClientRect();
      megaPanel.style.top    = rect.bottom + 'px';
      megaPanel.style.position = 'fixed';
      megaPanel.style.left   = '0';
      megaPanel.style.right  = '0';
      megaPanel.style.width  = '100%';
      megaPanel.style.height = 'auto';        // ✅ height auto rakhein
    }
 
    megaPanel.classList.add('active');
    document.body.classList.add('menu-open');
  });
 
  megaItem.addEventListener('mouseleave', () => {
    hideTimer = setTimeout(() => {
      megaPanel.classList.remove('active');
      document.body.classList.remove('menu-open');
    }, 150);
  });
 
  megaPanel.addEventListener('mouseenter', () => clearTimeout(hideTimer));
  megaPanel.addEventListener('mouseleave', () => {
    hideTimer = setTimeout(() => {
      megaPanel.classList.remove('active');
      document.body.classList.remove('menu-open');
    }, 150);
  });
 
  megaNavLink.addEventListener('click', (e) => {
    e.preventDefault();
    megaPanel.classList.toggle('active');
    document.body.classList.toggle('menu-open', megaPanel.classList.contains('active'));
  });
 
  document.addEventListener('click', (e) => {
    if (!megaItem.contains(e.target)) {
      megaPanel.classList.remove('active');
      document.body.classList.remove('menu-open');
    }
  });
</script>