@model List<customerseller.Models.Complaint>
@{
    Layout = "_DashboardLayout";
}

<style>
    .complaints-wrap {
        padding: 1.5rem;
    }

    .complaints-header {
        margin-bottom: 1.5rem;
    }

        .complaints-header h1 {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1e1033;
        }

        .complaints-header p {
            font-size: 0.85rem;
            color: #888;
            margin-top: 4px;
        }

    .complaint-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #ede9fe;
        margin-bottom: 16px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(166,77,121,0.04);
    }

    .complaint-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 22px;
        border-bottom: 1px solid #f5f0ff;
        flex-wrap: wrap;
        gap: 10px;
    }

    .ticket-no {
        font-family: monospace;
        font-size: 0.82rem;
        color: #7c3aed;
        background: #ede9fe;
        padding: 3px 10px;
        border-radius: 6px;
        font-weight: 700;
    }

    .badge {
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .badge-forwarded {
        background: #fff3e0;
        color: #e65100;
    }

    .badge-responded {
        background: #fef3c7;
        color: #d97706;
    }

    .badge-resolved {
        background: #d1fae5;
        color: #059669;
    }

    .complaint-body {
        padding: 18px 22px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .info-item label {
        font-size: 0.7rem;
        color: #9ca3af;
        font-weight: 700;
        text-transform: uppercase;
    }

    .info-item span {
        display: block;
        font-size: 0.86rem;
        color: #1e1033;
        font-weight: 500;
        margin-top: 2px;
    }

    .desc-box {
        background: #f9f9f9;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 0.85rem;
        color: #444;
        line-height: 1.6;
        margin-bottom: 14px;
        border-left: 3px solid #a64d79;
    }

    .admin-notes-box {
        background: #f5f3ff;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 0.85rem;
        color: #4c1d95;
        margin-bottom: 14px;
        border-left: 3px solid #7c3aed;
    }

    .evidence-img {
        width: 80px;
        height: 80px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid #ede9fe;
        cursor: pointer;
        margin-bottom: 14px;
    }

    .response-box {
        background: #f0fdf4;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 0.85rem;
        color: #166534;
        margin-bottom: 14px;
        border-left: 3px solid #16a34a;
    }

    .respond-form {
        padding-top: 14px;
        border-top: 1px solid #f5f0ff;
    }

        .respond-form textarea {
            width: 100%;
            min-height: 80px;
            padding: 10px 14px;
            border: 1.5px solid #ede9fe;
            border-radius: 9px;
            font-size: 0.85rem;
            font-family: inherit;
            outline: none;
            resize: vertical;
            margin-bottom: 10px;
        }

            .respond-form textarea:focus {
                border-color: #a64d79;
            }

        .respond-form input[type="file"] {
            font-size: 0.8rem;
            margin-bottom: 12px;
        }

    .btn-respond {
        background: #a64d79;
        color: #fff;
        border: none;
        padding: 9px 22px;
        border-radius: 9px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        font-family: inherit;
    }

        .btn-respond:hover {
            background: #880e4f;
        }

    .empty-state {
        text-align: center;
        padding: 60px;
        color: #9ca3af;
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 16px;
            display: block;
        }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 32px;
        max-width: 400px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }

        .modal-box .modal-icon {
            font-size: 2.5rem;
            margin-bottom: 12px;
        }

        .modal-box h3 {
            font-size: 1.1rem;
            font-weight: 700;
            color: #1e1033;
            margin-bottom: 8px;
        }

        .modal-box p {
            font-size: 0.85rem;
            color: #6b7280;
            margin-bottom: 20px;
        }

    .modal-btn {
        padding: 10px 28px;
        border-radius: 9px;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        background: #a64d79;
        color: #fff;
    }

    @@media (max-width: 600px) {
        .complaints-wrap {
            padding: 1rem;
        }

        .complaint-header {
            padding: 14px 16px;
        }

        .complaint-body {
            padding: 16px;
        }

        .info-grid {
            grid-template-columns: 1fr 1fr;
        }

        .btn-respond {
            width: 100%;
        }
    }
</style>

<div class="complaints-wrap">
    <div class="complaints-header">
        <h1><i class="fas fa-flag" style="color:#a64d79; margin-right:8px;"></i>Customer Complaints</h1>
        <p>Respond to complaints forwarded by admin</p>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-circle-check"></i>
            <p>No complaints yet. Keep up the great work!</p>
        </div>
    }
    else
    {
        @foreach (var c in Model)
        {
            var statusClass = c.Status switch
            {
                "Forwarded" => "badge-forwarded",
                "SellerResponded" => "badge-responded",
                "Resolved" => "badge-resolved",
                _ => "badge-forwarded"
            };

            <div class="complaint-card">
                <div class="complaint-header">
                    <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                        <span class="ticket-no">@c.TicketNumber</span>
                        <span class="badge @statusClass">@c.Status</span>
                    </div>
                    <span style="font-size:0.78rem; color:#9ca3af;">
                        @c.CreatedAt.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
                    </span>
                </div>

                <div class="complaint-body">
                    <div class="info-grid">
                        <div class="info-item">
                            <label>Customer</label>
                            <span>@c.CustomerName</span>
                        </div>
                        <div class="info-item">
                            <label>Order ID</label>
                            <span>@(c.OrderId ?? "—")</span>
                        </div>
                        <div class="info-item">
                            <label>Type</label>
                            <span>@c.ComplaintType</span>
                        </div>
                    </div>

                    <div class="desc-box">
                        <strong style="font-size:0.75rem; color:#a64d79; text-transform:uppercase;">Customer's Complaint</strong><br />
                        @c.Description
                    </div>

                    @if (!string.IsNullOrEmpty(c.EvidenceImageUrl))
                    {
                        <div style="margin-bottom:14px;">
                            <div style="font-size:0.72rem; color:#9ca3af; font-weight:700; text-transform:uppercase; margin-bottom:6px;">Customer Evidence</div>
                            <a href="@c.EvidenceImageUrl" target="_blank">
                                <img src="@c.EvidenceImageUrl" class="evidence-img" alt="Evidence" />
                            </a>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(c.AdminNotes))
                    {
                        <div class="admin-notes-box">
                            <strong>Admin Notes:</strong> @c.AdminNotes
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(c.SellerResponse))
                    {
                        <div class="response-box">
                            <strong>Your Response:</strong> @c.SellerResponse
                            @if (!string.IsNullOrEmpty(c.SellerProofImageUrl))
                            {
                                <br /><a href="@c.SellerProofImageUrl" target="_blank" style="color:#16a34a; font-size:0.78rem;">
                                <i class="fas fa-image"></i> View Your Proof Image
                            </a>
                        }
                    </div>
                }

                @if (c.Status == "Forwarded")
                {
                    <div class="respond-form">
                        <div style="font-size:0.75rem; color:#9ca3af; font-weight:700; text-transform:uppercase; margin-bottom:8px;">
                            Your Response
                        </div>
                        <textarea id="response-@c.Id" placeholder="Explain what happened and how you resolved it..."></textarea>
                        <input type="file" id="proof-@c.Id" accept="image/*" />
                        <br />
                        <button class="btn-respond" onclick="submitResponse(@c.Id)">
                            <i class="fas fa-paper-plane"></i> Submit Response
                        </button>
                    </div>
                }
                else if (c.Status == "Resolved")
                {
                    <div style="font-size:0.83rem; color:#059669; padding-top:10px; border-top:1px solid #f5f0ff;">
                        <i class="fas fa-check-circle"></i> This complaint has been resolved by admin.
                    </div>
                }
                else if (c.Status == "SellerResponded")
                {
                    <div style="font-size:0.83rem; color:#d97706; padding-top:10px; border-top:1px solid #f5f0ff;">
                        <i class="fas fa-clock"></i> Waiting for admin to review your response.
                    </div>
                }
            </div>
        </div>
    }
}
</div>
<div class="modal-overlay" id="resultModal">
    <div class="modal-box">
        <div class="modal-icon" id="modalIcon"></div>
        <h3 id="modalTitle"></h3>
        <p id="modalMsg"></p>
        <button class="modal-btn" onclick="closeModal()">OK</button>
    </div>
</div>

<script>
    function showModal(icon, title, msg) {
        document.getElementById('modalIcon').textContent = icon;
        document.getElementById('modalTitle').textContent = title;
        document.getElementById('modalMsg').textContent = msg;
        document.getElementById('resultModal').classList.add('show');
    }
    function closeModal() {
        document.getElementById('resultModal').classList.remove('show');
        location.reload();
    }

    async function submitResponse(id) {
        const response = document.getElementById('response-' + id).value.trim();
        const fileInput = document.getElementById('proof-' + id);

        if (!response) {
            showModal('⚠️', 'Response Required', 'Please describe how you resolved this complaint.');
            return;
        }

        const formData = new FormData();
        formData.append('complaintId', id);
        formData.append('response', response);
        if (fileInput.files.length > 0) {
            formData.append('proofImage', fileInput.files[0]);
        }

        const res = await fetch('/SellerComplaint/Respond', {
            method: 'POST',
            body: formData
        });
        const data = await res.json();

        if (data.success) {
            showModal('✅', 'Response Submitted!', 'Admin has been notified and will review your response.');
        } else {
            showModal('❌', 'Error', 'Something went wrong. Please try again.');
        }
    }
</script>
