@*
     https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
}
@{
    <section class="seller-about-hero">
        <div class="hero-text">
            <h1>Turn Your <span>Craft</span> into a Global Business</h1>
            <p>Artisans is more than a marketplace. We provide the tools, the audience, and the support to help local creators grow their brand from scratch.</p>

        </div>
        <div class="hero-image">
            <div class="image-circle">
                <img src="~/images/about.png" />
            </div>
        </div>
    </section>

    <section class="benefits-section">
        <h2 style="font-family: 'Georgia', serif; font-size: 36px;">Why Sell on Artisans?</h2>
        <div class="benefits-grid">
            <div class="benefit-card">
                <i class="fas fa-percentage"></i>
                <h3>Low Commission</h3>
                <p>We keep our fees low so you can keep more of what you earn. No hidden charges.</p>
            </div>
            <div class="benefit-card">
                <i class="fas fa-shipping-fast"></i>
                <h3>Easy Logistics</h3>
                <p>Focus on creating; we'll handle the shipping and tracking through our local partners.</p>
            </div>
            <div class="benefit-card">
                <i class="fas fa-headset"></i>
                <h3>24/7 Seller Support</h3>
                <p>Our dedicated seller success team is here to help you at every step of your journey.</p>
            </div>
        </div>
    </section>
    <section class="trust-section">
        <div class="trust-container">
            <div class="trust-visual">
                <img src="~/images/about1.png" />
                <div class="verified-badge">
                    <i class="fas fa-check-circle"></i>
                    <span>100% Verified<br>Artisans</span>
                </div>
            </div>

            <div class="trust-text">
                <h2>Why Buyers Trust Our Artisans?</h2>

                <div class="trust-step">
                    <div class="step-icon-box"><i class="fas fa-search-location"></i></div>
                    <div class="step-info">
                        <h4>Local Workshop </h4>
                        <p>Our team personally checks every workshop to ensure items are truly handmade.</p>
                    </div>
                </div>

                <div class="trust-step">
                    <div class="step-icon-box"><i class="fas fa-gem"></i></div>
                    <div class="step-info">
                        <h4>Quality Material Check</h4>
                        <p>We verify the source of silver, clay, and fabrics used by our artisans to maintain high standards.</p>
                    </div>
                </div>

                <div class="trust-step">
                    <div class="step-icon-box"><i class="fas fa-shield-alt"></i></div>
                    <div class="step-info">
                        <h4>Secure Pay</h4>
                        <p>Your payment is held safely and only released to the artisan once you receive your order.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
