@{
    ViewData["Title"] = "Privacy Policy";
}

<main class="policy-container">
    <h1>Privacy Policy</h1>

    <section>
        <p>
            We value your trust in our handmade products. This Privacy Policy explains how we collect,
            use, and protect your personal information when you shop with us.
        </p>
    </section>

    <section>
        <h2>Information We Collect</h2>
        <p>We may collect the following information when you place an order or interact with our website:</p>
        <ul>
            <li>Your name</li>
            <li>Email address</li>
            <li>Phone number</li>
            <li>Shipping and billing address</li>
            <li>Order details</li>
            <li>Payment information (processed securely by third-party gateways)</li>
        </ul>
    </section>

    <section>
        <h2>How We Use Your Information</h2>
        <ul>
            <li>Processing and delivering your order</li>
            <li>Sending order updates</li>
            <li>Improving customer experience</li>
            <li>Responding to your messages or concerns</li>
        </ul>
    </section>

    <section>
        <h2>How We Protect Your Data</h2>
        <p>
            We use secure payment gateways and SSL encryption to keep your personal details safe.
            We never store your full payment details on our system.
        </p>
    </section>

    <section>
        <h2>Sharing of Information</h2>
        <p>We do <strong>not</strong> sell or share your personal information with third parties, except:</p>
        <ul>
            <li>Trusted delivery partners (for shipping your order)</li>
            <li>Payment processors (to complete your purchase)</li>
        </ul>
    </section>

    <section>
        <h2>Cookies</h2>
        <p>
            Our website may use cookies to enhance your browsing experience — such as remembering
            your cart items or preferences.
        </p>
    </section>

    <section>
        <h2>Your Rights</h2>
        <ul>
            <li>Delete your data</li>
            <li>Update incorrect information</li>
            <li>Request details of what data we hold</li>
        </ul>
    </section>

    <section>
        <h2>Contact Us</h2>
        <p>
            If you have any questions about our Privacy Policy, please contact us at:<br />
            <a href="mailto:email.com">artisanvalley@gmail.com</a>
        </p>
    </section>

    <footer class="policy-note">
        Thank you for trusting our handmade small business ❤️
    </footer>
</main>
