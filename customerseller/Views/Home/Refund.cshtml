@{
    ViewData["Title"] = "Refund Policy";
}

<main class="policy-container">
    <h1>Refund Policy</h1>

    <p>
        We truly appreciate your interest in our handmade products. Every item is crafted with care,
        passion and creativity. Since our products are handmade, small variations and imperfections
        are normal and part of the beauty of handmade craftsmanship.
    </p>

    <section>
        <h2>Eligibility for Refund</h2>
        <p>
            ✔ You can request a refund within <strong>7 days</strong> of receiving your order.<br />
            ✔ Refund is only applicable if the product:
        </p>
        <ul>
            <li>is damaged on arrival</li>
            <li>has a manufacturing defect</li>
            <li>is different from what you ordered</li>
        </ul>
    </section>

    <section>
        <h2>Non-Refundable Items</h2>
        <p>
            ❌ Customized or personalized products<br />
            ❌ Items damaged due to misuse<br />
            ❌ Products without original packaging
        </p>
    </section>

    <section>
        <h2>Exchange Policy</h2>
        <p>
            If you received a defective or incorrect item, you can request an exchange within 7 days.
            We will replace the product without any extra cost.
        </p>
    </section>

    <section>
        <h2>How to Request a Refund</h2>
        <p>
            Please email us at <strong>@@email.com</strong><br />
            Include the following:
        </p>
        <ul>
            <li>Your full name</li>
            <li>Order number</li>
            <li>Clear pictures of the issue</li>
            <li>Reason for refund</li>
        </ul>
    </section>

    <section>
        <h2>Processing Time</h2>
        <p>
            Once your request is accepted, refunds will be processed within
            <strong>5–7 business days</strong>.
            Refund will be issued through the original payment method.
        </p>
    </section>

    <footer class="policy-note">
        Thank you for supporting handmade products ❤️
    </footer>
</main>
