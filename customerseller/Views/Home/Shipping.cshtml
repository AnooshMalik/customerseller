@{
    ViewData["Title"] = "Shipping Policy";
}

<main class="policy-container">
    <h1>Shipping Policy</h1>

    <section>
        <p>
            We are committed to delivering your handmade products safely and promptly.
            Please read our shipping policy carefully.
        </p>
    </section>

    <section>
        <h2>Order Processing</h2>
        <ul>
            <li>Orders are processed within 1–3 business days after payment confirmation.</li>
            <li>Handmade products may require additional crafting time depending on complexity.</li>
        </ul>
    </section>

    <section>
        <h2>Shipping Methods & Delivery Times</h2>
        <ul>
            <li>Standard Shipping: 5–10 business days</li>
            <li>Express Shipping: 2–5 business days</li>
            <li>Delivery times may vary depending on location and external factors.</li>
        </ul>
    </section>

    <section>
        <h2>Shipping Charges</h2>
        <ul>
            <li>Currently, we are offering free shipping on all orders.</li>
            <li>Shipping charges may be applied in the future based on location and order weight.</li>
        </ul>
    </section>

    <section>
        <h2>Order Tracking</h2>
        <p>
            Once your order is shipped, you can track your order using your order number.
        </p>
    </section>

    <section>
        <h2>Damaged or Lost Items</h2>
        <p>
            If your item arrives damaged or is lost in transit, please contact us within 7 days.
            We will work with you to resolve the issue and offer a replacement or refund as per our
            <a asp-controller="Home" asp-action="Refund">Refund Policy</a>.
        </p>
    </section>

    <section>
        <h2>Contact Us</h2>
        <p>
            For questions regarding shipping, please contact us at:<br />
            <a href="mailto:email.com">artisanvalley@gmail.com</a>
        </p>
    </section>

    <footer class="policy-note">
        Thank you for supporting our handmade small business ❤️
    </footer>
</main>
