@section Scripts {
    <script>
    (function () {
        const slider = document.querySelector('.banner-slider');
        if (!slider) return;

        const slides = slider.querySelector('.slides');
        const dots = slider.querySelectorAll('.dot');
        const total = dots.length;
        let index = 0;
        let timer = null;

        function showSlide(i) {
            index = (i + total) % total;
            slides.style.transform = `translateX(-${index * 100}%)`;
            dots.forEach(d => d.classList.remove('active'));
            dots[index].classList.add('active');
        }

        function startAuto() {
            clearInterval(timer);
            timer = setInterval(() => showSlide(index + 1), 6000);
        }

        slider.querySelector('.banner-arrow.next').addEventListener('click', function () {
            showSlide(index + 1);
            startAuto();      
            this.blur();      
        });

        slider.querySelector('.banner-arrow.prev').addEventListener('click', function () {
            showSlide(index - 1);
            startAuto();
            this.blur();
        });

        dots.forEach((dot, i) => {
            dot.addEventListener('click', () => {
                showSlide(i);
                startAuto();
            });
        });

        startAuto();
    })();
</script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var shouldOpenLogin = '@TempData["OpenLoginSidebar"]';

            if (shouldOpenLogin === "true") {
                openLoginSidebar();
            }
        });

        function openLoginSidebar() {
            const sidebar = document.querySelector('.login-sidebar');
            if (sidebar) {
                sidebar.style.right = "0";
            }
        }

        function addToCart(productId) {
            fetch('/Products/GetProductJson?id=' + productId)
                .then(r => r.json())
                .then(product => {
                    let cart = JSON.parse(localStorage.getItem('cart')) || [];

                    let existing = cart.find(i => i.id === productId);
                    if (existing) {
                        existing.qty = (existing.qty || 1) + 1;
                    } else {
                        cart.push({
                            id: product.id,
                            title: product.title,
                            price: product.price,
                            img: product.imageUrl,
                            qty: 1
                        });
                    }
                    localStorage.setItem('cart', JSON.stringify(cart));
                    localStorage.removeItem('buyNowItem');
                    openCart();
                    updateCartCount();
                });
        }
    </script>

    <script>
        (function () {
            const track = document.querySelector('.testi-marquee-track');
            const nextBtn = document.querySelector('.testi-next');
            const prevBtn = document.querySelector('.testi-prev');
            if (!track || !nextBtn || !prevBtn) return;

            
            track.innerHTML = track.innerHTML.repeat(3);

            let busy = false;

            function stepSize() {
                const c = track.children;
                return c[1].offsetLeft - c[0].offsetLeft;
            }

            function next() {
                if (busy) return;
                busy = true;
                track.style.transition = 'transform 0.5s ease';
                track.style.transform = `translateX(-${stepSize()}px)`;

                setTimeout(() => {
                    track.style.transition = 'none';
                    track.appendChild(track.firstElementChild);
                    track.style.transform = 'translateX(0)';
                    busy = false;
                }, 520);
            }

            function prev() {
                if (busy) return;
                busy = true;
                const s = stepSize();

                track.style.transition = 'none';
                track.insertBefore(track.lastElementChild, track.firstElementChild);
                track.style.transform = `translateX(-${s}px)`;
                track.offsetWidth;

                track.style.transition = 'transform 0.5s ease';
                track.style.transform = 'translateX(0)';

                setTimeout(() => { busy = false; }, 520);
            }

            nextBtn.addEventListener('click', next);
            prevBtn.addEventListener('click', prev);
        })();
    </script>
}