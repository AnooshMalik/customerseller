<h2 class="best-seller-heading" id="best-sellers">Best Sellers</h2>

<div class="product-carousel-wrapper">
    <div class="product-carousel-track">
        @if (Model != null && Model.Any())
        {
            @for (int pass = 0; pass < 4; pass++)
            {
                @foreach (var product in Model)
                {
                    var imagePath = Url.Content(product.ImageUrl ?? "~/images/default.jpg");

                    double avgRating = 0;
                    int reviewCount = 0;
                    var ratingsDict = ViewBag.ProductRatings as Dictionary<string, dynamic>;
                    if (ratingsDict != null && ratingsDict.ContainsKey(product.Id))
                    {
                        avgRating = ratingsDict[product.Id].AverageRating;
                        reviewCount = ratingsDict[product.Id].ReviewCount;
                    }

                    int fullStars = (int)Math.Round(avgRating);

                    <div class="product-card" style="position:relative;">
                        <a href="/Products/Details/@product.Id" style="display:block; text-decoration:none; color:inherit;">
                            <div class="image-wrapper">
                                <img src="@imagePath" alt="@product.Title" loading="lazy" />
                            </div>
                            <div class="product-info">
                                <h3>@product.Title</h3>
                                <p style="font-size:0.78rem; color:#888; margin:4px 0; line-height:1.4;">
                                    @(product.Description != null && product.Description.Length > 40
                                        ? product.Description.Substring(0, 40) + "..."
                                        : product.Description)
                                </p>
                                <div class="price" style="color:#a64d79; font-weight:700; margin:6px 0;">
                                    PKR @product.Price
                                </div>
                                <div class="rating" style="color:#f59e0b; font-size:0.85rem;">
                                    @if (reviewCount > 0)
                                    {
                                        <span>@(new string('★', fullStars))@(new string('☆', 5 - fullStars))</span>
                                        <span style="color:#888; font-size:0.8rem;">(@avgRating.ToString("0.0"))</span>
                                    }
                                    else
                                    {
                                        <span style="color:#aaa; font-size:0.8rem;">No reviews yet</span>
                                    }
                                </div>
                            </div>
                        </a>
                        <button class="plus-btn" onclick="event.preventDefault(); event.stopPropagation(); addToCart('@product.Id')">+</button>
                    </div>
                }
            }
        }
        else
        {
            <div style="text-align:center; padding: 50px; color: #999; font-style: italic; width: 100%;">
                <p>No featured products available right now.</p>
            </div>
        }
    </div>
</div>
