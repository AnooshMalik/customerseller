@section Scripts {
    <script>
       
        let index = 0;
        const slides = document.querySelector('.slides');
        const dots = document.querySelectorAll('.dot');

        function showSlide(i) {
            index = (i + 3) % 3;
            slides.style.transform = `translateX(-${index * 100}%)`;
            dots.forEach(d => d.classList.remove("active"));
            dots[index].classList.add("active");
        }

        document.querySelector('.next').onclick = () => showSlide(index + 1);
        document.querySelector('.prev').onclick = () => showSlide(index - 1);

        dots.forEach((dot, i) => {
            dot.onclick = () => showSlide(i);
        });

        setInterval(() => showSlide(index + 1), 6000);
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
           
            var shouldOpenLogin = '@TempData["OpenLoginSidebar"]';

            if (shouldOpenLogin === "true") {
               
                openLoginSidebar();

            }
        });

        
        function openLoginSidebar() {
            const sidebar = document.querySelector('.login-sidebar'); 
            if(sidebar) {
                sidebar.style.right = "0"; 
            }
        }

                function addToCart(productId) {
            
            fetch('/Products/GetProductJson?id=' + productId)
                .then(r => r.json())
                .then(product => {
                    let cart = JSON.parse(localStorage.getItem('cart')) || [];

                    // Already hai to qty badhao
                    let existing = cart.find(i => i.id === productId);
                    if (existing) {
                        existing.qty = (existing.qty || 1) + 1;
                    } else {
                        cart.push({
                            id: product.id,
                            title: product.title,
                            price: product.price,
                            img: product.imageUrl,
                            qty: 1
                        });
                    }

                    localStorage.setItem('cart', JSON.stringify(cart));
                    openCart(); // Cart sidebar kholo
                    updateCartCount();
                });
        }
    </script>
}