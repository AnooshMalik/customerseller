@{
    Layout = "~/Views/Shared/_SellerLayout.cshtml";
}

<div class="privacy-container">
    <header class="privacy-header">
        <h1>Privacy Policy</h1>
        <p>Effective Date: April 2026</p>
    </header>

    <div class="policy-card">
        <div class="section">
            <div class="section-title">
                <i class="fa-solid fa-leaf"></i> Our Commitment
            </div>
            <div class="section-content">
                Artisans Valley respects the hard work of our creators. This Privacy Policy explains how we collect, use, and protect the information of our sellers. By using our platform, you agree to the practices described here.
            </div>
        </div>

        <div class="section">
            <div class="section-title">
                <i class="fa-solid fa-address-card"></i> Information We Collect
            </div>
            <div class="section-content">
                To set up your artisan shop, we require basic business information such as your name, shop name, contact details, and payment information to ensure you receive your earnings securely.
            </div>
            <div class="highlight-box">
                "We only collect data that is necessary to help you sell your handmade treasures."
            </div>
        </div>

        <div class="section">
            <div class="section-title">
                <i class="fa-solid fa-shield-halved"></i> Data Security
            </div>
            <div class="section-content">
                Your data is encrypted and stored securely. We use industry-standard protocols to protect your personal and financial information from unauthorized access. We do not sell your private data to third-party advertisers.
            </div>
        </div>

        <div class="section">
            <div class="section-title">
                <i class="fa-solid fa-user-gear"></i> Seller Rights
            </div>
            <div class="section-content">
                As a seller, you have the right to access, update, or delete your information at any time through your dashboard. For any legal inquiries regarding your data, our support team is always here to help.
            </div>
        </div>
    </div>
</div>