@using Microsoft.Data.SqlClient
@inject IConfiguration Configuration
@model IEnumerable<customerseller.Models.Order>
@{
    Layout = "_DashboardLayout";

    var couriers = new List<customerseller.Models.RiderCompany>();
    using (var conR = new SqlConnection(Configuration.GetConnectionString("DefaultConnection")))
    {
        conR.Open();
        var cmdR = new SqlCommand("SELECT Id, CompanyName FROM RiderCompanies WHERE IsActive = 1", conR);
        using var rdR = cmdR.ExecuteReader();
        while (rdR.Read())
        {
            couriers.Add(new customerseller.Models.RiderCompany
            {
                Id = Convert.ToInt32(rdR["Id"]),
                CompanyName = rdR["CompanyName"].ToString() ?? ""
            });
        }
    }
}
<style>
    .orders-page {
        padding: 30px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

        .page-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1a2e;
        }

        .page-header p {
            color: #888;
            font-size: 0.85rem;
            margin-top: 3px;
        }

    .orders-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .stat-box {
        background: #fff;
        border-radius: 12px;
        padding: 20px 22px;
        border-top: 3px solid #ad2882;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

        .stat-box .label {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #888;
            margin-bottom: 8px;
        }

        .stat-box .value {
            font-size: 1.8rem;
            font-weight: 700;
            color: #1a1a2e;
        }

    .orders-table-card {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.06);
        margin-bottom: 24px;
    }

    .table-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 20px;
        border-bottom: 1px solid #f0f0f0;
    }

        .table-top h3 {
            font-size: 0.95rem;
            font-weight: 700;
            color: #1a1a2e;
        }

        .table-top span {
            font-size: 0.78rem;
            color: #888;
        }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead tr {
        background: #fafafa;
    }

    th {
        padding: 12px 18px;
        text-align: left;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #888;
        border-bottom: 1px solid #f0f0f0;
    }

    td {
        padding: 14px 18px;
        font-size: 0.88rem;
        color: #333;
        border-bottom: 1px solid #f7f7f7;
    }

    tr:last-child td {
        border-bottom: none;
    }

    tr:hover td {
        background: #fdf5f9;
    }

    .order-id {
        font-family: monospace;
        font-size: 0.8rem;
        color: #666;
        background: #f5f5f5;
        padding: 3px 8px;
        border-radius: 6px;
    }

    .btn-track {
        background: #fce4f3;
        color: #ad2882;
        border: 1.5px solid #ad2882;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-track:hover {
            background: #ad2882;
            color: #fff;
        }

    .btn-track, .btn-assign {
        white-space: nowrap;
    }

    .btn-assign {
        background: #a64d79;
        color: #fff;
        border: none;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
    }

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .badge-assigned {
        background: #d1fae5;
        color: #065f46;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        margin-left: 6px;
    }

    .empty-state {
        text-align: center;
        padding: 50px;
        color: #888;
    }

        .empty-state i {
            font-size: 3rem;
            color: #ddd;
            margin-bottom: 15px;
            display: block;
        }

    .tracking-section {
        background: #fff;
        border-radius: 14px;
        padding: 28px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        border: 1px solid rgba(0,0,0,0.06);
        margin-top: 10px;
    }

    .tracking-title {
        font-size: 1rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 25px;
    }

        .tracking-title span {
            color: #ad2882;
        }

    .stepper-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        position: relative;
        padding: 10px 0;
    }

        .stepper-wrapper::before {
            content: '';
            position: absolute;
            top: 22px;
            left: 10%;
            right: 10%;
            height: 2px;
            background: #f0f0f0;
            z-index: 0;
        }

    .step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        flex: 1;
        z-index: 1;
    }

    .step-dot {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #f0f0f0;
        border: 3px solid #e0e0e0;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
    }

        .step-dot i {
            font-size: 0.85rem;
            color: #bbb;
        }

    .step-item.active .step-dot {
        background: #ad2882;
        border-color: #ad2882;
    }

        .step-item.active .step-dot i {
            color: #fff;
        }

    .step-item h4 {
        font-size: 0.85rem;
        font-weight: 700;
        color: #1a1a2e;
        margin-bottom: 4px;
    }

    .step-item p {
        font-size: 0.75rem;
        color: #888;
    }

    .step-item.active h4 {
        color: #ad2882;
    }

         
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 16px;
        padding: 30px;
        max-width: 420px;
        width: 90%;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }

        .modal-box h3 {
            font-size: 1.05rem;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .modal-box label {
            display: block;
            font-size: 0.78rem;
            font-weight: 700;
            color: #555;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .modal-box select, .modal-box input {
            width: 100%;
            padding: 10px 12px;
            border: 1.5px solid #ddd;
            border-radius: 8px;
            font-size: 0.88rem;
            margin-bottom: 14px;
            font-family: inherit;
            outline: none;
        }

            .modal-box select:focus, .modal-box input:focus {
                border-color: #a64d79;
            }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 4px;
    }

    .btn-cancel-modal {
        flex: 1;
        padding: 11px;
        background: #f1f5f9;
        color: #555;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-confirm-modal {
        flex: 1;
        padding: 11px;
        background: #a64d79;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }


    .wa-box {
        background: #fff;
        border-radius: 16px;
        padding: 28px;
        max-width: 440px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }

        .wa-box .wa-icon {
            font-size: 2.4rem;
            color: #25D366;
            margin-bottom: 10px;
        }

        .wa-box h3 {
            font-size: 1rem;
            font-weight: 700;
            color: #1a1a2e;
            margin-bottom: 14px;
        }

    .wa-preview {
        background: #f0fdf4;
        border: 1.5px solid #c8e6c9;
        border-radius: 10px;
        padding: 14px 16px;
        font-size: 0.82rem;
        color: #333;
        text-align: left;
        white-space: pre-wrap;
        margin-bottom: 18px;
        max-height: 220px;
        overflow-y: auto;
    }

    .btn-wa-send {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #25D366;
        color: #fff;
        border: none;
        padding: 11px 24px;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        text-decoration: none;
        margin-bottom: 10px;
        width: 100%;
        justify-content: center;
    }

    .btn-wa-close {
        background: none;
        border: none;
        color: #888;
        font-size: 0.85rem;
        cursor: pointer;
    }

    .toast-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        z-index: 10000;
        align-items: center;
        justify-content: center;
    }

        .toast-overlay.show {
            display: flex;
        }

    .toast-box {
        background: #fff;
        border-radius: 16px;
        padding: 26px 30px;
        max-width: 380px;
        width: 90%;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0,0,0,0.2);
    }

    .toast-icon {
        font-size: 2.2rem;
        margin-bottom: 10px;
    }

        .toast-icon.success {
            color: #10b981;
        }

        .toast-icon.error {
            color: #ef4444;
        }

    .toast-message {
        font-size: 0.92rem;
        color: #333;
        margin-bottom: 20px;
        line-height: 1.5;
    }

    .btn-toast-ok {
        background: #a64d79;
        color: #fff;
        border: none;
        padding: 10px 28px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.88rem;
    }

    @@media (max-width: 768px) {
        .orders-page {
            padding: 16px;
        }

        .orders-stats {
            grid-template-columns: 1fr;
        }

        .orders-table-card {
            overflow-x: auto;
        }

        table {
            min-width: 650px;
        }

        .table-top {
            flex-direction: column;
            align-items: flex-start;
            gap: 6px;
        }

        
          

        .modal-box, .wa-box {
            padding: 20px;
        }

        .modal-actions {
            flex-direction: column;
        }

        .btn-assign {
            margin-left: 0;
            margin-top: 6px;
            display: inline-block;
        }
               
    }

        .trk-wrap {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        position: relative;
        padding: 10px 0;
    }

        .trk-wrap::before {
            content: '';
            position: absolute;
            top: 28px;
            left: 12.5%;
            right: 12.5%;
            height: 2px;
            background: #f0f0f0;
            z-index: 0;
        }

    .trk-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .trk-dot {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #f0f0f0;
        border: 3px solid #e0e0e0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

        .trk-dot i {
            font-size: 0.85rem;
            color: #bbb;
        }

    .trk-step.active .trk-dot {
        background: #ad2882;
        border-color: #ad2882;
    }

        .trk-step.active .trk-dot i {
            color: #fff;
        }

    .trk-step h4 {
        font-size: 0.85rem;
        font-weight: 700;
        color: #1a1a2e;
        margin: 0 0 4px;
    }

    .trk-step p {
        font-size: 0.75rem;
        color: #888;
        margin: 0;
    }

    .trk-step.active h4 {
        color: #ad2882;
    }

    @@media (max-width: 768px) {
        .trk-wrap {
            grid-template-columns: repeat(2, 1fr);
            row-gap: 16px;
        }

            .trk-wrap::before {
                display: none;
            }
    }
</style>


<div class="orders-page">
    <div class="page-header">
        <div>
            <h1>Orders</h1>
            <p>Track and manage your artisan sales.</p>
        </div>
    </div>

    <div class="orders-stats">
        <div class="stat-box">
            <div class="label">Total Orders</div>
            <div class="value">@(Model?.Count() ?? 0)</div>
        </div>
        <div class="stat-box">
            <div class="label">Pending</div>
            <div class="value">@(Model?.Count(o => o.Status == "Placed" || o.Status == "Pending" || o.Status == "Processing") ?? 0)</div>
        </div>
        <div class="stat-box">
            <div class="label">Delivered</div>
            <div class="value">@(Model?.Count(o => o.Status == "Delivered") ?? 0)</div>
        </div>
    </div>

    <div class="orders-table-card">
        <div class="table-top">
            <h3>All Orders</h3>
            <span>@(Model?.Count() ?? 0) orders</span>
        </div>
        <table>
            <thead>
                <tr>
                    <th>Order ID</th>
                      <th>Date &amp; Time</th>
                    <th>Customer</th>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Courier</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var order in Model)
                    {
                        <tr>
                                                      <td><span class="order-id">@order.OrderId</span></td>
                            <td style="white-space:nowrap;">
                                @order.OrderDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)
                                <small style="color:#999; display:block;">@order.OrderDate.ToString("h:mm tt", System.Globalization.CultureInfo.InvariantCulture)</small>
                            </td>
                            <td>@order.CustomerName</td>
                            <td>
                                @order.ProductName
                                <small style="color:#999; display:block;">
                                    Qty: @(order.Items?.FirstOrDefault(i => i.ProductId != null)?.Quantity ?? 1)
                                </small>
                            </td>
                            <td style="font-weight:700; color:#ad2882;">PKR @order.Price</td>
                                                       <td>
                                @{
                                    var statusBg = order.Status == "Return Requested" ? "#fff3e0" :
                                                   order.Status == "Cancelled" ? "#fee2e2" :
                                                   order.Status == "Delivered" ? "#d1fae5" : "#fce4f3";
                                    var statusColor = order.Status == "Return Requested" ? "#e65100" :
                                                       order.Status == "Cancelled" ? "#dc2626" :
                                                       order.Status == "Delivered" ? "#065f46" : "#ad2882";
                                }
                                <span style="background:@statusBg; color:@statusColor; padding:4px 10px; border-radius:20px; font-size:0.75rem; font-weight:600;">
                                    @if (order.Status == "Return Requested")
                                    {
                                        <text>↩️ </text>
                                    }
                                    @(order.Status ?? "Placed")
                                </span>
                            </td>
                            <td>
                                @if (order.RiderCompanyId == null)
                                {
                                    <span style="color:#aaa; font-size:0.8rem;">Not assigned</span>
                                }
                                else if (order.RiderStatus == "PickedUp")
                                {
                                    <span style="background:#e3f2fd; color:#1565c0; padding:4px 10px; border-radius:20px; font-size:0.75rem; font-weight:600;">🚴 Picked Up</span>
                                }
                                else if (order.RiderStatus == "Delivered")
                                {
                                    <span style="background:#d1fae5; color:#065f46; padding:4px 10px; border-radius:20px; font-size:0.75rem; font-weight:600;">✅ Delivered</span>
                                }
                                else
                                {
                                    <span style="background:#fce4f3; color:#ad2882; padding:4px 10px; border-radius:20px; font-size:0.75rem; font-weight:600;">📦 Assigned</span>
                                }
                            </td>

                            <td>
                                <div class="action-buttons">
                                                                      <button class="btn-track" data-order-id="@order.OrderId" data-status="@order.Status"
                                            data-assigned="@(order.RiderCompanyId != null ? "1" : "0")"
                                            data-courier-status="@order.RiderStatus"
                                            onclick="showOrderTracking(this)">
                                    <i class="fas fa-location-dot"></i> Track
                                    </button>
                                    @if (order.RiderCompanyId == null)
                                    {
                                        <button class="btn-assign"
                                                data-order-id="@order.OrderId"
                                                data-phone="@order.CustomerPhone"
                                                data-address="@order.CustomerAddress"
                                                onclick="openAssignModal(this.dataset.orderId, this.dataset.phone, this.dataset.address)">
                                            <i class="fas fa-truck"></i> Assign to Delivery
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <i class="fas fa-shopping-bag"></i>
                                <p>No orders found yet.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="trackingArea" class="tracking-section" style="display:none;">
        <div class="tracking-title">
            Order Status: <span id="trackId"></span>
        </div>
        <div id="cancelledMessage" style="display:none; text-align:center; padding:20px;">
            <i class="fas fa-circle-xmark" style="font-size:2.5rem; color:#ef4444; margin-bottom:12px; display:block;"></i>
            <h4 style="font-size:1.05rem; font-weight:700; color:#ef4444; margin-bottom:6px;">Order Cancelled</h4>
            <p style="color:#888; font-size:0.85rem;">This order was cancelled and will not be processed further.</p>
        </div>
                <div id="normalStepper" class="trk-wrap">
            <div class="trk-step" id="step-placed">
                <div class="trk-dot"><i class="fas fa-check"></i></div>
                <h4>Order Placed</h4>
                <p>Confirmed</p>
            </div>
            <div class="trk-step" id="step-assigned">
                <div class="trk-dot"><i class="fas fa-user-check"></i></div>
                <h4>Assigned</h4>
                <p>Courier Assigned</p>
            </div>
            <div class="trk-step" id="step-shipped">
                <div class="trk-dot"><i class="fas fa-truck"></i></div>
                <h4>Shipped</h4>
                <p>In Transit</p>
            </div>
            <div class="trk-step" id="step-delivered">
                <div class="trk-dot"><i class="fas fa-house"></i></div>
                <h4>Delivered</h4>
                <p>Completed</p>
            </div>
        </div>
        </div>
    </div>


<div class="modal-overlay" id="confirmModal">
    <div class="modal-box">
        <h3><i class="fas fa-truck"></i> Assign to Delivery</h3>
        <p style="font-size:0.88rem; color:#666; margin-bottom:18px;">
            You are about to assign this order to the rider. Do you want to continue?
        </p>
        <div class="modal-actions">
            <button class="btn-cancel-modal" onclick="closeConfirmModal()">Cancel</button>
            <button class="btn-confirm-modal" onclick="proceedToAssign()">Continue</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="assignModal">
    <div class="modal-box">
        <h3><i class="fas fa-truck"></i> Assign Rider</h3>

        <input type="hidden" id="assignOrderId" />

        
        @if (couriers.Any())
        {
            <input type="hidden" id="courierSelect" value="@couriers.First().Id" />
        }
        else
        {
            <input type="hidden" id="courierSelect" value="" />
            <div style="color:#c0392b; font-size:0.85rem; margin-bottom:14px;">No rider available right now.</div>
        }

        <label>Customer Phone</label>
        <input type="text" id="customerPhoneInput" placeholder="e.g. 03001234567" />

        <label>Customer Address</label>
        <input type="text" id="customerAddressInput" placeholder="Full delivery address" />

        <div class="modal-actions">
            <button class="btn-cancel-modal" onclick="closeAssignModal()">Cancel</button>
            <button class="btn-confirm-modal" onclick="confirmAssign()">Assign</button>
        </div>
    </div>
</div>

<div class="toast-overlay" id="toastModal">
    <div class="toast-box">
        <div class="toast-icon" id="toastIcon"></div>
        <div class="toast-message" id="toastMessage"></div>
        <button class="btn-toast-ok" onclick="closeToast()">OK</button>
    </div>
</div>


<script>
    let reloadAfterToast = false;

    function showToast(message, isError = false, reload = false) {
        reloadAfterToast = reload;
        var icon = document.getElementById('toastIcon');
        icon.innerHTML = isError ? '<i class="fas fa-circle-xmark"></i>' : '<i class="fas fa-circle-check"></i>';
        icon.className = 'toast-icon ' + (isError ? 'error' : 'success');
        document.getElementById('toastMessage').textContent = message;
        document.getElementById('toastModal').classList.add('show');
    }
        function showOrderTracking(btn) {
        const orderId = btn.dataset.orderId;
        const status = btn.dataset.status || '';
        const assigned = btn.dataset.assigned === '1';
        const cs = btn.dataset.courierStatus || '';

        document.getElementById('trackingArea').style.display = 'block';
        document.getElementById('trackId').textContent = '#' + orderId;

        const cancelled = status === 'Cancelled';
        document.getElementById('cancelledMessage').style.display = cancelled ? 'block' : 'none';
       document.getElementById('normalStepper').style.display = cancelled ? 'none' : 'grid';
        const delivered = status === 'Delivered' || cs === 'Delivered';
        const shipped = delivered || cs === 'PickedUp' || status === 'Shipped' || status === 'Out for Delivery';
        const isAssigned = shipped || assigned;

        const steps = {
            'step-placed': true,
            'step-assigned': isAssigned,
            'step-shipped': shipped,
            'step-delivered': delivered
        };
        Object.keys(steps).forEach(id => {
          
            document.getElementById(id).classList.toggle('active', steps[id]);
        });

        document.getElementById('trackingArea').scrollIntoView({ behavior: 'smooth' });
    }

    function closeToast() {
        document.getElementById('toastModal').classList.remove('show');
        if (reloadAfterToast) {
            reloadAfterToast = false;
            location.reload();
        }
    }

    function openAssignModal(orderId, customerPhone, customerAddress) {
        document.getElementById('assignOrderId').value = orderId;
        document.getElementById('customerPhoneInput').value = customerPhone || '';
        document.getElementById('customerAddressInput').value = customerAddress || '';

       

        document.getElementById('confirmModal').classList.add('show');
    }

    function closeConfirmModal() {
        document.getElementById('confirmModal').classList.remove('show');
    }

    function proceedToAssign() {
        document.getElementById('confirmModal').classList.remove('show');
        document.getElementById('assignModal').classList.add('show');
    }

    function closeAssignModal() {
        document.getElementById('assignModal').classList.remove('show');
    }

    async function confirmAssign() {
        const orderId = document.getElementById('assignOrderId').value;
        const courierId = document.getElementById('courierSelect').value;
        const customerPhone = document.getElementById('customerPhoneInput').value.trim();
        const customerAddress = document.getElementById('customerAddressInput').value.trim();

        if (!courierId) { showToast('Please select a rider.', true); return; }
        if (!customerPhone) { showToast('Please enter customer phone number.', true); return; }
        if (!customerAddress) { showToast('Please enter customer address.', true); return; }
        const res = await fetch('/Orders/AssignToDelivery', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `orderId=${encodeURIComponent(orderId)}&courierId=${courierId}&customerPhone=${encodeURIComponent(customerPhone)}&customerAddress=${encodeURIComponent(customerAddress)}`
        });
        const data = await res.json();

        if (data.success) {
            closeAssignModal();
           showToast('Order assigned to rider! Email sent to customer.', false, true);
        } else {
            showToast('Error: ' + (data.error || 'Something went wrong'), true);
        }
    }
   
</script>

<script src="~/seller/js/dashboard.js"></script>