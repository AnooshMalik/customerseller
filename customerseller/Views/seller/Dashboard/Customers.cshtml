@model IEnumerable<customerseller.Models.CustomerOrderRow>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Customers";

    var customers = Model
        .GroupBy(o => string.IsNullOrWhiteSpace(o.Phone) ? o.CustomerName : o.Phone)
        .Select(g => new
        {
            Name = g.First().CustomerName,
            Phone = g.First().Phone,
            Address = g.First().Address,
            Orders = g.OrderByDescending(x => x.OrderDate).ToList()
        })
        .OrderByDescending(c => c.Orders.First().OrderDate)
        .ToList();
}

<style>
    .cust-page { padding: 30px; }
    .cust-page h1 { font-size: 1.5rem; font-weight: 700; color: #1a1a2e; }
    .cust-page .sub { color: #888; font-size: 0.85rem; margin: 3px 0 20px; }
    .cust-search { width: 100%; max-width: 360px; padding: 10px 14px; border: 1.5px solid #ddd; border-radius: 8px; margin-bottom: 18px; font-size: 0.9rem; outline: none; }
    .cust-card { background: #fff; border-radius: 14px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); margin-bottom: 14px; overflow: hidden; }
    .cust-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 20px; cursor: pointer; flex-wrap: wrap; }
    .cust-head:hover { background: #fdf5f9; }
    .cust-name { font-weight: 700; color: #1a1a2e; }
    .cust-meta { font-size: 0.8rem; color: #888; margin-top: 3px; }
    .cust-badges { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    .pill { padding: 4px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 600; white-space: nowrap; }
    .cust-body { display: none; border-top: 1px solid #f0f0f0; padding: 6px 20px 16px; overflow-x: auto; }
    .cust-body.open { display: block; }
    .cust-body table { width: 100%; border-collapse: collapse; min-width: 520px; }
    .cust-body th { text-align: left; font-size: 0.72rem; text-transform: uppercase; color: #888; padding: 10px 8px; border-bottom: 1px solid #f0f0f0; }
    .cust-body td { padding: 10px 8px; font-size: 0.86rem; border-bottom: 1px solid #f7f7f7; }
    .oid { font-family: monospace; font-size: 0.8rem; background: #f5f5f5; padding: 3px 8px; border-radius: 6px; }
</style>

<div class="cust-page">
    <h1>Customers</h1>
    <p class="sub">@customers.Count @(customers.Count == 1 ? "customer" : "customers")</p>

       <input type="text" id="custSearch" class="cust-search" placeholder="Search by name or phone..." maxlength="40" autocomplete="off" />
    <div id="custNoResult" style="display:none; text-align:center; padding:40px; color:#888;">No matching customers.</div>
    @if (!customers.Any())
    {
        <div style="text-align:center; padding:50px; color:#888;">No customers yet.</div>
    }

    @foreach (var c in customers)
    {
        var total = c.Orders.Count;
        var delivered = c.Orders.Count(o => o.Status == "Delivered");
        var cancelled = c.Orders.Count(o => o.Status == "Cancelled" || o.Status == "Rejected");
        var active = total - delivered - cancelled;

        <div class="cust-card" data-search="@((c.Name + " " + c.Phone).ToLower())">
            <div class="cust-head" onclick="this.nextElementSibling.classList.toggle('open')">
                <div>
                    <div class="cust-name">@c.Name</div>
                    <div class="cust-meta">📞 @c.Phone &nbsp;|&nbsp; 📍 @c.Address</div>
                </div>
                <div class="cust-badges">
                    <span class="pill" style="background:#fce4f3; color:#ad2882;">@total @(total == 1 ? "order" : "orders")</span>
                    @if (active > 0) { <span class="pill" style="background:#e3f2fd; color:#1565c0;">@active active</span> }
                    @if (delivered > 0) { <span class="pill" style="background:#d1fae5; color:#065f46;">@delivered delivered</span> }
                    @if (cancelled > 0) { <span class="pill" style="background:#fee2e2; color:#dc2626;">@cancelled cancelled</span> }
                </div>
            </div>
            <div class="cust-body">
                <table>
                    <thead><tr><th>Order ID</th><th>Date</th><th>Product</th><th>Amount</th><th>Status</th></tr></thead>
                    <tbody>
                        @foreach (var o in c.Orders)
                        {
                            var bad = o.Status == "Cancelled" || o.Status == "Rejected";
                            var bg = o.Status == "Delivered" ? "#d1fae5" : bad ? "#fee2e2" : "#fce4f3";
                            var fg = o.Status == "Delivered" ? "#065f46" : bad ? "#dc2626" : "#ad2882";
                            <tr>
                                <td><span class="oid">@o.OrderId</span></td>
                                <td>@o.OrderDate.ToString("dd MMM yyyy", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td>@o.ProductTitle <small style="color:#999;">x@(o.Quantity)</small></td>
                                <td style="font-weight:700; color:#ad2882;">PKR @((o.Price * o.Quantity).ToString("N0"))</td>
                                <td><span class="pill" style="background:@bg; color:@fg;">@(string.IsNullOrEmpty(o.Status) ? "Placed" : o.Status)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<script>
    (function () {
        const input = document.getElementById('custSearch');
        if (!input) return;
        const cards = document.querySelectorAll('.cust-card');
        const empty = document.getElementById('custNoResult');

        input.addEventListener('input', function () {
          
            this.value = this.value.replace(/[^a-zA-Z0-9 +\-.]/g, '');

            const q = this.value.toLowerCase().trim();
            let shown = 0;
            cards.forEach(card => {
                const match = card.dataset.search.includes(q);
                card.style.display = match ? '' : 'none';
                if (match) shown++;
            });
            if (empty) empty.style.display = (shown === 0 && cards.length > 0) ? 'block' : 'none';
        });
    })();
</script>

<script src="~/seller/js/dashboard.js"></script>