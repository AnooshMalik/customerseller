@model IEnumerable<customerseller.Models.Review>
@{
    Layout = "_DashboardLayout";
    // Average rating ko dynamic calculate karne ke liye
    var avgRating = Model != null && Model.Any() ? Model.Average(r => r.Rating).ToString("0.0") : "0.0";
}
<link href="~/seller/css/Dashboard.css" rel="stylesheet" />
<style>
    .reviews-container {
        max-width: 850px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .reviews-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fff;
        padding: 22px 26px;
        border-radius: 14px;
        border: 1px solid #ddd6fe;
        margin-bottom: 22px;
    }

    .page-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: #1e1033;
    }

    .sub-title {
        font-size: 0.85rem;
        color: #8b5cf6;
        margin-top: 4px;
    }

    .summary-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #8b5cf6;
        margin-bottom: 5px;
        text-align: right;
    }

    .summary-score {
        font-size: 2rem;
        font-weight: 700;
        color: #1e1033;
    }

    .star-icon { color: #f59e0b; }

    .review-card {
        background: #fff;
        border-radius: 14px;
        padding: 22px 26px;
        margin-bottom: 16px;
        border: 1px solid #ddd6fe;
        transition: transform 0.2s;
    }

    .review-card:hover { transform: translateY(-2px); }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .customer-info { display: flex; align-items: center; gap: 12px; }

    .avatar {
        width: 42px; height: 42px;
        border-radius: 50%;
        background: #7c3aed;
        color: #fff;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.9rem; font-weight: 700;
    }

    .customer-name { font-size: 0.92rem; font-weight: 700; color: #1e1033; }
    .post-date { font-size: 0.75rem; color: #8b5cf6; margin-top: 2px; }

    .star-rating i { color: #f59e0b; font-size: 0.9rem; }
    .star-rating .far { color: #ddd6fe; }

    .product-tag {
        background: #ede9fe;
        color: #7c3aed;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .tag-container { margin-bottom: 10px; }

    .review-text {
        font-size: 0.88rem;
        color: #555;
        line-height: 1.6;
        margin-bottom: 14px;
        font-style: italic;
    }

    .btn-reply {
        font-size: 0.8rem;
        color: #7c3aed;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 8px;
        background: #ede9fe;
        transition: all 0.2s;
    }

    .btn-reply:hover { background: #7c3aed; color: #fff; }

    .reply-box {
        margin-top: 12px;
        background: #f5f3ff;
        border-radius: 10px;
        padding: 14px;
        border: 1px solid #ddd6fe;
    }

    .reply-input {
        width: 100%;
        padding: 10px 14px;
        border: 1.5px solid #ddd6fe;
        border-radius: 8px;
        font-size: 0.88rem;
        outline: none;
        resize: none;
        min-height: 80px;
        font-family: inherit;
        background: #fff;
    }

    .reply-input:focus { border-color: #8b5cf6; }

    .reply-actions { margin-top: 10px; text-align: right; }

    .btn-send {
        background: #7c3aed;
        color: #fff;
        border: none;
        padding: 8px 20px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-send:hover { background: #6d28d9; }

    .empty-reviews {
        text-align: center;
        padding: 60px 20px;
        color: #a78bfa;
    }

    .empty-reviews i {
        font-size: 3rem;
        margin-bottom: 15px;
        display: block;
        opacity: 0.4;
    }

    .empty-reviews p { font-size: 0.95rem; color: #6b7280; }

    @@media (max-width: 600px) {
        .reviews-container {
            padding: 16px 14px;
        }

        .reviews-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 14px;
            padding: 18px 20px;
        }

        .summary-label, .summary-score {
            text-align: left;
        }

        .review-card {
            padding: 18px 20px;
        }

        .card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 8px;
        }

        .reply-actions {
            text-align: center;
        }

        .btn-send {
            width: 100%;
        }
    }
</style>
<main class="reviews-container">
    <header class="reviews-header">
        <div class="title-group">
            <h1 class="page-title">Customer Reviews</h1>
            <p class="sub-title">Manage your store reputation and feedback.</p>
        </div>
        <div class="rating-summary">
            <p class="summary-label">Average Rating</p>
            @* Hardcoded 4.8 ki jagah ab dynamic value ayegi *@
            <h2 class="summary-score">@avgRating <span class="star-icon">★</span></h2>
        </div>
    </header>

    @if (Model != null && Model.Any())
    {
        @foreach (var review in Model)
        {
            <div class="review-card">
                <div class="card-header">
                    <div class="customer-info">
                        <div class="avatar">@review.CustomerInitials</div>
                        <div class="customer-details">
                            <h4 class="customer-name">@review.CustomerName</h4>
                            <p class="post-date">@review.DateLabel</p>
                        </div>
                    </div>
                    <div class="star-rating">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="@(i <= review.Rating ? "fas" : "far") fa-star"></i>
                        }
                    </div>
                </div>

                <div class="tag-container">
                    <span class="product-tag">@review.ProductName</span>
                </div>

             
                <p class="review-text">"@review.Comment"</p>
               

                @if (!string.IsNullOrEmpty(review.SellerResponse))
                {
                    <div style="background:#f0fdf4; border-left:3px solid #065f46; padding:10px 14px; border-radius:0 8px 8px 0; margin-bottom:12px;">
                        <p style="font-size:11px; font-weight:700; color:#065f46; margin:0 0 4px;"><i class="fas fa-store"></i> Your Response:</p>
                        <p style="font-size:0.88rem; color:#444; margin:0;">@review.SellerResponse</p>
                    </div>
                }

                <div class="action-area">
                    <span class="btn-reply" onclick="toggleReply('@review.Id')">
                        <i class="fas fa-reply"></i> Respond to this review
                    </span>
                </div>

                <div id="reply-@review.Id" class="reply-box" style="display:none;">
                    <textarea class="reply-input" placeholder="Write your thank you note..."></textarea>
                    <div class="reply-actions">
                        <button class="btn-send" onclick="sendResponse('@review.Id')">Send Response</button>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
      <div class="empty-reviews">
    <i class="fas fa-comments"></i>
    <p>No reviews yet. Feedback from customers will appear here.</p>
</div>
    }
</main>
<script>
    function toggleReply(id) {
        const box = document.getElementById('reply-' + id);
        if (box.style.display === 'none') {
            box.style.display = 'block';
        } else {
            box.style.display = 'none';
        }
    }

    async function sendResponse(id) {
        const textarea = document.querySelector('#reply-' + id + ' .reply-input');
        const text = textarea.value.trim();
        if (!text) {
            alert('Please write a response first.');
            return;
        }

        const btn = document.querySelector('#reply-' + id + ' .btn-send');
        btn.textContent = 'Sending...';
        btn.disabled = true;

        try {
            const res = await fetch('/Review/RespondToReview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reviewId: id, response: text })
            });
            const data = await res.json();
            if (data.success) {
                btn.textContent = 'Sent!';
                btn.style.background = '#065f46';
                textarea.value = '';
            } else {
                btn.textContent = 'Send Response';
                btn.disabled = false;
            }
        } catch {
            btn.textContent = 'Send Response';
            btn.disabled = false;
        }
    }
</script>

<script src="~/seller/js/dashboard.js"></script>