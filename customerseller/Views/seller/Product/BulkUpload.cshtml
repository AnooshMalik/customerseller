@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Bulk Upload";
    var groupedSubCategories = ViewBag.GroupedSubCategories as Dictionary<string, List<string>> ?? new Dictionary<string, List<string>>();
}

<style>
    .bulk-container {
        max-width: 750px;
        margin: 30px auto;
        background: #fff;
        border-radius: 16px;
        padding: 35px;
        box-shadow: 0 2px 20px rgba(0,0,0,0.08);
    }

        .bulk-container h2 {
            font-size: 1.5rem;
            color: #1a1a2e;
            margin-bottom: 8px;
            font-weight: 700;
        }

        .bulk-container > p.subtitle {
            color: #777;
            font-size: 0.88rem;
            margin-bottom: 25px;
        }

    .step-box {
        border: 1.5px solid #e0e0e0;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 20px;
    }

        .step-box h4 {
            font-size: 0.95rem;
            color: #a64d79;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .step-box p {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 12px;
            line-height: 1.6;
        }

    select, input[type="file"] {
        width: 100%;
        padding: 11px 14px;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        font-size: 0.9rem;
        font-family: inherit;
        background: #fafafa;
    }

    .btn-primary {
        padding: 12px 22px;
        background: linear-gradient(135deg, #a64d79, #880e4f);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

    .note-box {
        background: #fff3e0;
        border: 1px solid #ffcc80;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.8rem;
        color: #e65100;
        margin-bottom: 12px;
    }

    #resultBox {
        margin-top: 20px;
        display: none;
    }

    .result-success {
        background: #e8f5e9;
        border: 1px solid #a5d6a7;
        border-radius: 8px;
        padding: 12px 16px;
        color: #2e7d32;
        font-size: 0.88rem;
        margin-bottom: 12px;
    }

    .result-errors {
        background: #ffebee;
        border: 1px solid #ffcdd2;
        border-radius: 8px;
        padding: 12px 16px;
        color: #c62828;
        font-size: 0.83rem;
    }

        .result-errors ul {
            margin: 8px 0 0 18px;
        }

    #spinner {
        display: none;
        text-align: center;
        padding: 15px;
        color: #a64d79;
        font-size: 0.9rem;
    }

    .upload-box {
        border: 2px dashed #e0e0e0;
        border-radius: 10px;
        padding: 24px 20px;
        text-align: center;
        cursor: pointer;
        transition: border 0.3s, background 0.3s;
        background: #fafafa;
    }

        .upload-box:hover {
            border-color: #a64d79;
            background: #fdf5f9;
        }

        .upload-box.has-file {
            border-color: #a5d6a7;
            background: #f3faf4;
        }

        .upload-box i {
            font-size: 1.8rem;
            color: #bbb;
            margin-bottom: 8px;
            display: block;
        }

        .upload-box.has-file i {
            color: #2e7d32;
        }

        .upload-box .upload-main-text {
            font-size: 0.88rem;
            color: #a64d79;
            font-weight: 600;
        }

        .upload-box .upload-sub-text {
            font-size: 0.75rem;
            color: #999;
            margin-top: 3px;
        }

        .upload-box.has-file .upload-main-text {
            color: #2e7d32;
        }

        .upload-box input[type="file"] {
            display: none;
        }

    @@media (max-width: 480px) {
        .bulk-container {
            margin: 15px 10px;
            padding: 20px;
        }

        .step-box {
            padding: 16px;
        }
    }

    .custom-dropdown {
        position: relative;
        width: 100%;
    }

    .dropdown-selected {
        width: 100%;
        padding: 11px 14px;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        font-size: 0.9rem;
        background: #fafafa;
        cursor: pointer;
        color: #333;
    }

        .dropdown-selected:hover {
            border-color: #a64d79;
        }

    .dropdown-list {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        right: 0;
        max-height: 260px;
        overflow-y: auto;
        background: #fff;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.12);
        z-index: 100;
    }

        .dropdown-list.open {
            display: block;
        }

    .dropdown-group-label {
        font-weight: 700;
        font-size: 0.82rem;
        color: #1a1a2e;
        padding: 10px 14px 4px;
        background: #f9f0f5;
    }

    .dropdown-option {
        padding: 9px 22px;
        font-size: 0.88rem;
        color: #444;
        cursor: pointer;
    }

        .dropdown-option:hover {
            background: #a64d79;
            color: #fff;
        }
</style>

<div class="bulk-container">
    <h2><i class="fa-solid fa-file-excel" style="color:#a64d79; margin-right:8px;"></i>Bulk Upload Products</h2>
    <p class="subtitle">Upload hundreds of products at once via Excel — images and videos included.</p>

    <div class="step-box">
        <h4>Step 1 — Download the template</h4>
        <p>Copy your Sub-Category name from the list below. Use this <strong>exact same name</strong> in the Excel file.</p>
    <div class="custom-dropdown" id="customDropdown">
            <div class="dropdown-selected" id="dropdownSelected" onclick="toggleDropdown()">
                 Sub-Category
            </div>
            <div class="dropdown-list" id="dropdownList">
                @foreach (var group in groupedSubCategories)
                {
                    <div class="dropdown-group-label">@group.Key</div>
                    foreach (var sub in group.Value)
                    {
                    <div class="dropdown-option" data-sub="@sub" onclick="copySubCategory(this.dataset.sub)">@sub <span style="float:right; font-size:0.75rem; color:#aaa;">click to copy</span></div>
                    }
                }
            </div>
        </div>

        <br /><br />
        <button type="button" class="btn-primary" onclick="downloadTemplate()">
            <i class="fa-solid fa-download"></i> Download Template
        </button>
    </div>

    <div class="step-box">
        <h4>Step 2 — Upload the filled Excel and videos</h4>
        <div class="note-box">
            <i class="fa-solid fa-circle-info"></i>
            <strong>Please remember:</strong>
            <ul style="margin:8px 0 0 18px; padding:0;">
                <li>Type the <strong>same Sub-Category name</strong> in the Excel "SubCategory" column.</li>
                <li>If this is the <strong>first video</strong> for that Sub-Category, name the video file the <strong>same as the Sub-Category</strong> (Example: Sub-Category "Sweaters" → video file <code>Sweaters.mp4</code>).</li>
                <li>Add each product's picture directly inside the "Image" column cell (Insert &gt; Pictures &gt; Place in Cell).</li>
            </ul>
        </div>
        <label style="font-size:0.82rem; font-weight:700; color:#555; display:block; margin-bottom:6px;">FILLED EXCEL FILE</label>
        <div class="upload-box" id="excelUploadBox" onclick="document.getElementById('excelFile').click()">
            <i class="fa-solid fa-file-excel"></i>
            <div class="upload-main-text" id="excelUploadText">Click to choose Excel file</div>
            <div class="upload-sub-text">.xlsx only</div>
            <input type="file" id="excelFile" accept=".xlsx" onchange="handleExcelSelect(this)" />
        </div>

        <br />
        <label style="font-size:0.82rem; font-weight:700; color:#555; display:block; margin-bottom:6px;">VIDEO FILES (if required — you can select multiple)</label>
        <div class="upload-box" id="videoUploadBox" onclick="document.getElementById('videoFiles').click()">
            <i class="fa-solid fa-video"></i>
            <div class="upload-main-text" id="videoUploadText">Click to choose video file(s)</div>
            <div class="upload-sub-text">MP4, MOV — file name must match SubCategory code</div>
            <input type="file" id="videoFiles" accept="video/*" multiple onchange="handleVideoSelect(this)" />
        </div>

        <br /><br />
        <button type="button" class="btn-primary" onclick="submitBulkUpload()">
            <i class="fa-solid fa-cloud-arrow-up"></i> Upload Products
        </button>
    </div>

    <div id="spinner"><i class="fa-solid fa-spinner fa-spin"></i> Processing, please wait...</div>

    <div id="resultBox"></div>
</div>

<script>
    function handleExcelSelect(input) {
        const box = document.getElementById('excelUploadBox');
        const text = document.getElementById('excelUploadText');
        if (input.files && input.files[0]) {
            box.classList.add('has-file');
            text.textContent = input.files[0].name;
        } else {
            box.classList.remove('has-file');
            text.textContent = 'Click to choose Excel file';
        }
    }

    function handleVideoSelect(input) {
        const box = document.getElementById('videoUploadBox');
        const text = document.getElementById('videoUploadText');
        if (input.files && input.files.length > 0) {
            box.classList.add('has-file');
            text.textContent = input.files.length === 1
                ? input.files[0].name
                : `${input.files.length} video files selected`;
        } else {
            box.classList.remove('has-file');
            text.textContent = 'Click to choose video file(s)';
        }
    }

    function downloadTemplate() {
        window.location.href = '/Products/DownloadTemplate';
    }

    function copySubCategory(sub) {
        const el = document.getElementById('dropdownSelected');
        el.textContent = sub;
        document.getElementById('dropdownList').classList.remove('open');

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(sub).then(() => {
                el.textContent = 'Copied: ' + sub;
                setTimeout(() => { el.textContent = sub; }, 1200);
            }).catch(() => { });
        }
    }

    function toggleDropdown() {
        document.getElementById('dropdownList').classList.toggle('open');
    }

    document.addEventListener('click', function (e) {
        if (!document.getElementById('customDropdown').contains(e.target)) {
            document.getElementById('dropdownList').classList.remove('open');
        }
    });

    async function submitBulkUpload() {
        const excelFile = document.getElementById('excelFile').files[0];
        const videoFiles = document.getElementById('videoFiles').files;

        if (!excelFile) {
            showPopup('Please select an Excel file first.', 'warning', 'Excel file required');
            return;
        }

        const formData = new FormData();
        formData.append('excelFile', excelFile);
        for (let i = 0; i < videoFiles.length; i++) {
            formData.append('videoFiles', videoFiles[i]);
        }

        document.getElementById('spinner').style.display = 'block';

        try {
            const res = await fetch('/Products/BulkUpload', {
                method: 'POST',
                body: formData
            });

            if (!res.ok) {
                document.getElementById('spinner').style.display = 'none';
                showPopup('Upload failed (' + res.status + '). Please try again.', 'error', 'Upload failed');
                return;
            }

            const data = await res.json();

            document.getElementById('spinner').style.display = 'none';

            const entry = document.createElement('div');
            entry.style.marginBottom = '14px';

            let html = '';

            // Hara box sirf tab jab kam az kam 1 product upload hua ho
            if (data.inserted > 0) {
                html += `<div class="result-success"><i class="fa-solid fa-check"></i> ${data.inserted} product(s) uploaded successfully.</div>`;
            } else if (data.errorCount > 0) {
                showPopup('No products were uploaded. Please fix the errors shown below and try again.', 'error', 'Upload failed');
            } else {
                showPopup('No products were found in the Excel file.', 'warning', 'Nothing to upload');
            }

            if (data.errorCount > 0) {
                html += `<div class="result-errors"><i class="fa-solid fa-circle-exclamation"></i> ${data.errorCount} rows had errors:
                    <ul>${data.errors.map(e => `<li>${escapeHtml(e)}</li>`).join('')}</ul>
                </div>`;
            }

            entry.innerHTML = html;

            const box = document.getElementById('resultBox');
            box.style.display = 'block';
            box.innerHTML = "";
            box.appendChild(entry);
            resetUploadForm();

        } catch (e) {
            document.getElementById('spinner').style.display = 'none';
            showPopup('An error occurred during upload. Please try again.', 'error', 'Something went wrong');
        }
    }

    function escapeHtml(t) {
        const d = document.createElement('div');
        d.textContent = t;
        return d.innerHTML;
    }

    function resetUploadForm() {
        document.getElementById('dropdownSelected').textContent = 'Sub-Category';

        const excelInput = document.getElementById('excelFile');
        excelInput.value = "";
        document.getElementById('excelUploadBox').classList.remove('has-file');
        document.getElementById('excelUploadText').textContent = 'Click to choose Excel file';

        const videoInput = document.getElementById('videoFiles');
        videoInput.value = "";
        document.getElementById('videoUploadBox').classList.remove('has-file');
        document.getElementById('videoUploadText').textContent = 'Click to choose video file(s)';
    }
</script>

@* ================= Popup (alert() ki jagah) ================= *@
<style>
    .av-popup-overlay {
        position: fixed;
        inset: 0;
        background: rgba(30, 16, 50, 0.5);
        backdrop-filter: blur(2px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 99999;
        padding: 16px;
    }
    .av-popup-overlay.show { display: flex; }

    .av-popup-box {
        background: #fff;
        border-radius: 16px;
        width: 380px;
        max-width: 100%;
        padding: 30px 28px 24px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
        font-family: inherit;
        animation: avPopIn 0.18s ease-out;
    }
    @@keyframes avPopIn {
        from { opacity: 0; transform: scale(0.92) translateY(8px); }
        to   { opacity: 1; transform: none; }
    }

    .av-popup-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        margin: 0 auto 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 700;
        line-height: 1;
    }
    .av-popup-icon.success { background: #e8f5e9; color: #2e7d32; }
    .av-popup-icon.error   { background: #ffebee; color: #c62828; }
    .av-popup-icon.warning { background: #fdf0f6; color: #a64d79; }

    .av-popup-title {
        margin: 0 0 8px;
        font-size: 1.1rem;
        font-weight: 700;
        color: #1a1a2e;
    }
    .av-popup-msg {
        margin: 0;
        font-size: 0.92rem;
        line-height: 1.55;
        color: #666;
        white-space: pre-line;
        word-wrap: break-word;
    }
    .av-popup-btn {
        margin-top: 22px;
        padding: 11px 38px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #a64d79, #880e4f);
        color: #fff;
        font-size: 0.92rem;
        font-weight: 600;
        font-family: inherit;
        cursor: pointer;
        transition: opacity 0.2s;
    }
    .av-popup-btn:hover { opacity: 0.9; }
    .av-popup-btn:focus-visible { outline: 3px solid rgba(166, 77, 121, 0.35); outline-offset: 2px; }
</style>

<script>
    // Browser ke alert() ko khoobsurat popup se badal deta hai.
    // showPopup('message', 'success' | 'error' | 'warning', 'Title') se seedha bhi use kar sakte hain.
    (function () {
        if (window.__avPopupInstalled) return;
        window.__avPopupInstalled = true;

        const queue = [];
        let showing = false;
        let overlay, iconEl, titleEl, msgEl, okBtn;

        function build() {
            overlay = document.createElement('div');
            overlay.className = 'av-popup-overlay';
            overlay.innerHTML =
                '<div class="av-popup-box" role="alertdialog" aria-modal="true">' +
                '<div class="av-popup-icon"></div>' +
                '<h3 class="av-popup-title"></h3>' +
                '<p class="av-popup-msg"></p>' +
                '<button type="button" class="av-popup-btn">OK</button>' +
                '</div>';
            document.body.appendChild(overlay);

            iconEl  = overlay.querySelector('.av-popup-icon');
            titleEl = overlay.querySelector('.av-popup-title');
            msgEl   = overlay.querySelector('.av-popup-msg');
            okBtn   = overlay.querySelector('.av-popup-btn');

            okBtn.addEventListener('click', close);
            overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && overlay.classList.contains('show')) close();
            });
        }

        // Message ke alfaaz dekh kar rang/icon chunta hai
        function detectType(msg) {
            const m = String(msg).toLowerCase();
            const bad = /(error|fail|invalid|wrong|cannot|can't|unable|denied|exceed|too large|not allowed|expired)/.test(m);
            const good = /(success|saved|submitted|uploaded|sent|updated|deleted|done|✅)/.test(m);
            if (bad) return 'error';
            if (good) return 'success';
            return 'warning';
        }

        const ICONS  = { success: '✓', error: '✕', warning: '!' };
        const TITLES = { success: 'Done!', error: 'Something went wrong', warning: 'Please check' };

        function next() {
            if (!queue.length) { showing = false; return; }
            showing = true;
            if (!overlay) build();

            const item = queue.shift();
            iconEl.className = 'av-popup-icon ' + item.type;
            iconEl.textContent = ICONS[item.type];
            titleEl.textContent = item.title || TITLES[item.type];
            msgEl.textContent = item.msg;

            overlay.classList.add('show');
            okBtn.focus();
        }

        function close() {
            overlay.classList.remove('show');
            setTimeout(next, 150);   // agle popup ki baari (agar ek se zyada hon)
        }

        function show(msg, type, title) {
            msg = (msg === null || msg === undefined) ? '' : String(msg);
            queue.push({ msg: msg, type: type || detectType(msg), title: title });
            if (showing) return;
            if (document.body) next();
            else document.addEventListener('DOMContentLoaded', next);
        }

        window.showPopup = show;
        window.alert = function (msg) { show(msg); };
    })();
</script>
