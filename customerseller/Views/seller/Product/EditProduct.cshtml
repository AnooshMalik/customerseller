@model customerseller.Models.Product
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Edit Product";
}

<style>
    .edit-container {
        max-width: 700px;
        margin: 30px auto;
        background: #fff;
        border-radius: 16px;
        padding: 35px;
        box-shadow: 0 2px 20px rgba(0,0,0,0.08);
    }

        .edit-container h2 {
            font-size: 1.5rem;
            color: #1a1a2e;
            margin-bottom: 25px;
            font-weight: 700;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            font-size: 0.82rem;
            font-weight: 700;
            color: #555;
            margin-bottom: 7px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .form-group input, .form-group textarea, .form-group select {
            width: 100%;
            padding: 12px 15px;
            border: 1.5px solid #e0e0e0;
            border-radius: 10px;
            font-size: 0.92rem;
            outline: none;
            background: #fafafa;
            font-family: inherit;
            box-sizing: border-box;
        }

            .form-group input:focus, .form-group textarea:focus, .form-group select:focus {
                border-color: #a64d79;
                background: #fff;
            }

        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .btn-save {
        padding: 14px 30px;
        background: linear-gradient(135deg, #a64d79, #880e4f);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-save:hover {
            opacity: 0.9;
        }

    .btn-cancel {
        padding: 14px 25px;
        background: #f5f5f5;
        color: #555;
        border: none;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .current-img {
        max-height: 100px;
        border-radius: 8px;
        margin-bottom: 10px;
        display: block;
    }

    .pending-notice {
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: 0.88rem;
        color: #856404;
    }

    @@media (max-width: 480px) {
        .edit-container {
            margin: 15px 10px;
            padding: 20px;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .edit-container > form > div[style*="display:flex"] {
            flex-direction: column;
        }

        .btn-save, .btn-cancel {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="edit-container">
    <h2><i class="fas fa-edit" style="color:#a64d79; margin-right:8px;"></i>Edit Product</h2>

    <div class="pending-notice">
        <i class="fas fa-info-circle"></i>
        After editing, your product will go back to <strong>Pending</strong> status and require admin approval again.
    </div>

    @if (TempData["ProductError"] != null)
    {
        <div style="background:#ffebee; border:1px solid #ffcdd2; border-radius:8px; padding:12px 16px; margin-bottom:20px; color:#c62828; font-size:0.88rem;">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["ProductError"]
        </div>
    }

    <form method="post" asp-action="EditProduct" asp-controller="Products"
          enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-row">
            <div class="form-group">
                <label>Product Name *</label>
                <input type="text" name="Title" value="@Model.Title" required />
            </div>
            <div class="form-group">
                <label>Price (Rs.) *</label>
                <input type="number" name="Price" value="@Model.Price" min="1" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Stock *</label>
                <input type="number" name="Stock" value="@Model.Stock" min="1" required />
            </div>
            <div class="form-group">
                <label>Sizes (optional)</label>
                <input type="text" name="Sizes" value="@Model.Sizes" placeholder="e.g. S, M, L, XL" />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Main Category</label>
                <select id="editMainCategory" onchange="loadEditSubCategories()">
                    <option value="">-- Select Category --</option>
                    <option value="FabricTextile" selected=@(Model.Category is "CushionCovers" or "PrintedKurtas" or "TieDyeDupattas" or "FabricToteBags" or "FabricTextile" ? "selected" : "")>🧵 Fabric &amp; Textile</option>
                    <option value="WoolYarn" selected=@(Model.Category is "Sweaters" or "CrochetBags" or "StorageBaskets" or "Beanies" or "WoolYarn" ? "selected" : "")>🧶 Wool &amp; Yarn</option>
                    <option value="Leather" selected=@(Model.Category is "LeatherHandbags" or "Wallets" or "Belts" or "LeatherKeychains" or "Journals" or "Leather" ? "selected" : "")>👜 Leather</option>
                    <option value="Wood" selected=@(Model.Category is "PhotoFrames" or "WoodNecklaces" or "WoodToys" or "ServingTrays" or "WoodShowpieces" or "WoodKeychains" or "Wood" ? "selected" : "")>🪵 Wood</option>
                    <option value="ClayPottery" selected=@(Model.Category is "FlowerPots" or "CoffeeMugs" or "ClayVases" or "ClayEarrings" or "ClayFigurines" or "ClayPottery" ? "selected" : "")>🏺 Clay &amp; Pottery</option>
                    <option value="Jewels" selected=@(Model.Category is "Necklaces" or "Bracelets" or "Rings" or "Bangles" or "JewelEarrings" or "Jewels" ? "selected" : "")>💎 Jewels</option>
                    <option value="PaperCards" selected=@(Model.Category is "GreetingCards" or "GiftBoxes" or "PaperFlowers" or "PaperShowpieces" or "Scrapbooks" or "PaperCards" ? "selected" : "")>📄 Paper &amp; Cards</option>
                    <option value="JuteNatural" selected=@(Model.Category is "JuteBags" or "Baskets" or "Trays" or "DriedBouquets" or "Paintings" or "JuteNatural" ? "selected" : "")>🌿 Jute &amp; Natural</option>
                    <option value="ResinEpoxy" selected=@(Model.Category is "Coasters" or "ResinEarrings" or "ResinKeychains" or "WallArt" or "ResinServingTrays" or "ResinEpoxy" ? "selected" : "")>🔮 Resin &amp; Epoxy</option>
                    <option value="MetalWire" selected=@(Model.Category is "MetalEarrings" or "MetalVases" or "MetalFigurines" or "MetalWallArt" or "CandleHolders" or "MetalWire" ? "selected" : "")>⚙️ Metal &amp; Wire</option>
                </select>
            </div>
            <div class="form-group">
                <label>Sub Category</label>
                <select id="editSubCategory" name="Category">
                    <option value="@Model.Category" selected>@Model.Category (current)</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea name="Description">@Model.Description</textarea>
        </div>

        <div class="form-group">
            <label>Product Image</label>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="current-img" />
                <small style="color:#888; display:block; margin-bottom:8px;">Upload new image to replace (optional)</small>
            }
            <input type="file" name="ImageFile" accept="image/*" />
        </div>

        <div style="display:flex; gap:12px; margin-top:25px;">
            <button type="submit" class="btn-save">
                <i class="fas fa-save"></i> Save Changes
            </button>
            <a asp-action="SellerProduct" asp-controller="Products" class="btn-cancel">
                Cancel
            </a>
        </div>
    </form>
</div>

<script>
    var subCategoryMap = {
        'FabricTextile': [
            { val: 'CushionCovers',   label: 'Cushion Covers' },
            { val: 'PrintedKurtas',   label: 'Printed Kurtas' },
            { val: 'TieDyeDupattas',  label: 'Tie-Dye Dupattas' },
            { val: 'FabricToteBags',  label: 'Tote Bags' },
            { val: 'FabricTextile',   label: 'General Fabric' }
        ],
        'WoolYarn': [
            { val: 'Sweaters',        label: 'Sweaters' },
            { val: 'CrochetBags',     label: 'Crochet Bags' },
            { val: 'StorageBaskets',  label: 'Storage Baskets' },
            { val: 'Beanies',         label: 'Beanies' },
            { val: 'WoolYarn',        label: 'General Wool' }
        ],
        'Leather': [
            { val: 'LeatherHandbags', label: 'Handbags' },
            { val: 'Wallets',         label: 'Wallets' },
            { val: 'Belts',           label: 'Belts' },
            { val: 'LeatherKeychains',label: 'Keychains' },
            { val: 'Journals',        label: 'Journals' },
            { val: 'Leather',         label: 'General Leather' }
        ],
        'Wood': [
            { val: 'PhotoFrames',     label: 'Photo Frames' },
            { val: 'WoodNecklaces',   label: 'Necklaces' },
            { val: 'WoodToys',        label: 'Toys' },
            { val: 'ServingTrays',    label: 'Serving Trays' },
            { val: 'WoodShowpieces',  label: 'Showpieces' },
            { val: 'WoodKeychains',   label: 'Keychains' },
            { val: 'Wood',            label: 'General Wood' }
        ],
        'ClayPottery': [
            { val: 'FlowerPots',      label: 'Flower Pots' },
            { val: 'CoffeeMugs',      label: 'Coffee Mugs' },
            { val: 'ClayVases',       label: 'Vases' },
            { val: 'ClayEarrings',    label: 'Earrings' },
            { val: 'ClayFigurines',   label: 'Figurines' },
            { val: 'ClayPottery',     label: 'General Clay' }
        ],
        'Jewels': [
            { val: 'Necklaces',       label: 'Necklaces' },
            { val: 'Bracelets',       label: 'Bracelets' },
            { val: 'Rings',           label: 'Rings' },
            { val: 'Bangles',         label: 'Bangles' },
            { val: 'JewelEarrings',   label: 'Earrings' },
            { val: 'Jewels',          label: 'General Jewels' }
        ],
        'PaperCards': [
            { val: 'GreetingCards',   label: 'Greeting Cards' },
            { val: 'GiftBoxes',       label: 'Gift Boxes' },
            { val: 'PaperFlowers',    label: 'Paper Flowers' },
            { val: 'PaperShowpieces', label: 'Showpieces' },
            { val: 'Scrapbooks',      label: 'Scrapbooks' },
            { val: 'PaperCards',      label: 'General Paper' }
        ],
        'JuteNatural': [
            { val: 'JuteBags',        label: 'Bags' },
            { val: 'Baskets',         label: 'Baskets' },
            { val: 'Trays',           label: 'Trays' },
            { val: 'DriedBouquets',   label: 'Dried Bouquets' },
            { val: 'Paintings',       label: 'Paintings' },
            { val: 'JuteNatural',     label: 'General Jute' }
        ],
        'ResinEpoxy': [
            { val: 'Coasters',        label: 'Coasters' },
            { val: 'ResinEarrings',   label: 'Earrings' },
            { val: 'ResinKeychains',  label: 'Keychains' },
            { val: 'WallArt',         label: 'Wall Art' },
            { val: 'ResinServingTrays', label: 'Serving Trays' },
            { val: 'ResinEpoxy',      label: 'General Resin' }
        ],
        'MetalWire': [
            { val: 'MetalEarrings',   label: 'Earrings' },
            { val: 'MetalVases',      label: 'Vases' },
            { val: 'MetalFigurines',  label: 'Figurines' },
            { val: 'MetalWallArt',    label: 'Wall Art' },
            { val: 'CandleHolders',   label: 'Candle Holders' },
            { val: 'MetalWire',       label: 'General Metal' }
        ]
    };

    var currentSubCat = '@Model.Category';
    var sellerCats = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        ViewBag.SellerCategories ?? new System.Collections.Generic.List<string>()
                )
        );

    function loadEditSubCategories() {
        var main = document.getElementById('editMainCategory').value;
        var sub  = document.getElementById('editSubCategory');
        sub.innerHTML = '';

        if (main && subCategoryMap[main]) {
            subCategoryMap[main]
                .filter(function(item) { return sellerCats.includes(item.val); })
                .forEach(function(item) {
                    var opt = document.createElement('option');
                    opt.value       = item.val;
                    opt.textContent = item.label;
                    if (item.val === currentSubCat) opt.selected = true;
                    sub.appendChild(opt);
                });
        }
    }

    window.addEventListener('DOMContentLoaded', function () {
        var mainSel = document.getElementById('editMainCategory');

        Array.from(mainSel.options).forEach(function(opt) {
            if (opt.value === '') return;
            var subCats  = subCategoryMap[opt.value] || [];
            var hasMatch = subCats.some(function(sc) { return sellerCats.includes(sc.val); });
            if (!hasMatch) opt.style.display = 'none';
        });

        loadEditSubCategories();
    });
</script>
