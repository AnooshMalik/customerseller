@model IEnumerable<customerseller.Models.Product>
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Products";
}

<style>
    .pi-wrap {
        padding: 1.5rem;
        font-family: inherit;
    }

    .pi-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
    }

    .pi-title {
        font-size: 20px;
        font-weight: 600;
        color: #1a1a2e;
        margin: 0 0 4px;
    }

    .pi-sub {
        font-size: 13px;
        color: #888;
        margin: 0;
    }

    .pi-btn {
        background: #a64d79;
        color: #fff;
        border: none;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

        .pi-btn:hover {
            background: #8a3d63;
        }

    .pi-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 1.5rem;
    }

    .pi-stat {
        background: #fdf5f9;
        border-radius: 8px;
        padding: 1rem;
        border-top: 3px solid #a64d79;
    }

    .pi-stat-label {
        font-size: 11px;
        font-weight: 700;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
    }

    .pi-stat-val {
        font-size: 24px;
        font-weight: 700;
        color: #1a1a2e;
    }

    .search-wrap {
        position: relative;
        margin-bottom: 1.5rem;
    }

        .search-wrap input {
            width: 100%;
            padding: 12px 16px 12px 42px;
            border: 1.5px solid #e8d5e1;
            border-radius: 10px;
            font-size: 14px;
            outline: none;
            background: #fdf5f9;
            box-sizing: border-box;
        }

            .search-wrap input:focus {
                border-color: #a64d79;
            }

        .search-wrap i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #a64d79;
            font-size: 1rem;
        }

    .cat-section {
        margin-bottom: 1rem;
        border: 1px solid #f0e0ea;
        border-radius: 12px;
        overflow: hidden;
    }

    .cat-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 18px;
        background: #fdf5f9;
        cursor: pointer;
        user-select: none;
    }

        .cat-header:hover {
            background: #f9ecf3;
        }

    .cat-name {
        font-size: 15px;
        font-weight: 700;
        color: #a64d79;
    }

    .cat-count {
        font-size: 12px;
        color: #888;
        background: #fff;
        border: 1px solid #e8d5e1;
        padding: 2px 10px;
        border-radius: 20px;
    }

    .cat-arrow {
        color: #a64d79;
        font-size: 0.85rem;
        transition: transform 0.2s;
    }

        .cat-arrow.open {
            transform: rotate(180deg);
        }

    .subcat-list {
        display: none;
        padding: 8px 16px 12px;
        background: #fff;
    }

        .subcat-list.open {
            display: block;
        }

    .subcat-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 10px;
        border-radius: 8px;
        cursor: pointer;
        margin-bottom: 4px;
    }

        .subcat-item:hover {
            background: #fdf5f9;
        }

    .subcat-name {
        font-size: 13px;
        color: #444;
        font-weight: 500;
    }

    .subcat-badge {
        font-size: 11px;
        color: #a64d79;
        background: #fdf0f6;
        padding: 2px 8px;
        border-radius: 20px;
    }

    .products-panel {
        display: none;
        padding: 12px 16px;
        background: #f9f9f9;
        border-top: 1px solid #f0e0ea;
    }

        .products-panel.open {
            display: block;
        }

    .pi-table-wrap {
        background: #fff;
        border: 1px solid #f0e0ea;
        border-radius: 10px;
        overflow: hidden;
    }

    .pi-thead {
        display: grid;
        grid-template-columns: 52px minmax(0,1fr) 100px 90px 95px 130px;
        padding: 10px 16px;
        background: #fdf5f9;
        border-bottom: 1px solid #f0e0ea;
    }

        .pi-thead span {
            font-size: 11px;
            font-weight: 700;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    .pi-row {
        display: grid;
        grid-template-columns: 52px minmax(0,1fr) 100px 90px 95px 130px;
        padding: 10px 16px;
        border-bottom: 1px solid #fdf5f9;
        align-items: center;
    }

        .pi-row:last-child {
            border-bottom: none;
        }

        .pi-row:hover {
            background: #fdf9ff;
        }

    .pi-img {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        object-fit: cover;
        overflow: hidden;
    }

        .pi-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 8px;
        }

    .pi-name {
        font-size: 13px;
        font-weight: 600;
        color: #1a1a2e;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding-right: 8px;
    }

    .pi-price {
        font-size: 13px;
        font-weight: 700;
        color: #a64d79;
    }

    .pi-stock {
        font-size: 12px;
        color: #666;
    }

    .pi-badge {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
    }

        .pi-badge.approved {
            background: #d1fae5;
            color: #065f46;
        }

        .pi-badge.pending {
            background: #fef3c7;
            color: #92400e;
        }

        .pi-badge.rejected {
            background: #fee2e2;
            color: #991b1b;
        }

    .empty-state {
        text-align: center;
        padding: 40px;
        color: #888;
        font-size: 13px;
    }

    @@media (max-width: 700px) {
        .pi-wrap {
            padding: 1rem;
        }

        .pi-top {
            flex-direction: column;
            gap: 12px;
            align-items: stretch;
        }

        .pi-btn {
            justify-content: center;
        }

        .pi-stats {
            grid-template-columns: 1fr;
        }

        .pi-table-wrap {
            overflow-x: auto;
        }

        .pi-thead, .pi-row {
            min-width: 480px;
        }

        .cat-header {
            padding: 12px 14px;
        }

            .cat-header > div {
                flex-wrap: wrap;
                gap: 6px !important;
            }
    }
</style>

<div class="pi-wrap">
    <div class="pi-top">
        <div>
            <p class="pi-title">Product Inventory</p>
            <p class="pi-sub">Manage your store products and stock here.</p>
        </div>
        <a href="/Products/AddProduct" class="pi-btn">
            <i class="fas fa-plus"></i> Add New Product
        </a>
    </div>

    <div class="pi-stats">
        <div class="pi-stat">
            <div class="pi-stat-label">Total Products</div>
            <div class="pi-stat-val">@(Model?.Count() ?? 0)</div>
        </div>
        <div class="pi-stat">
            <div class="pi-stat-label">In Stock</div>
            <div class="pi-stat-val">@(Model?.Count(p => int.TryParse(p.Stock, out int s) && s > 0) ?? 0)</div>
        </div>
        <div class="pi-stat">
            <div class="pi-stat-label">Out of Stock</div>
            <div class="pi-stat-val">@(Model?.Count(p => int.TryParse(p.Stock, out int s) && s == 0) ?? 0)</div>
        </div>
    </div>

    <div class="search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" placeholder="Search products..." onkeyup="filterSearch()" />
    </div>

    <div id="categoryContainer">
        @{
            var categoryMap = new Dictionary<string, string> {
                {"CushionCovers","Fabric & Textile"},{"PrintedKurtas","Fabric & Textile"},
                {"TieDyeDupattas","Fabric & Textile"},{"FabricToteBags","Fabric & Textile"},
                {"Sweaters","Wool & Yarn"},{"CrochetBags","Wool & Yarn"},
                {"StorageBaskets","Wool & Yarn"},{"Beanies","Wool & Yarn"},
                {"LeatherHandbags","Leather"},{"Wallets","Leather"},{"Belts","Leather"},
                {"LeatherKeychains","Leather"},{"Journals","Leather"},
                {"PhotoFrames","Wood"},{"WoodNecklaces","Wood"},{"WoodToys","Wood"},
                {"ServingTrays","Wood"},{"WoodShowpieces","Wood"},{"WoodKeychains","Wood"},
                {"FlowerPots","Clay & Pottery"},{"CoffeeMugs","Clay & Pottery"},
                {"ClayVases","Clay & Pottery"},{"ClayEarrings","Clay & Pottery"},
                {"ClayFigurines","Clay & Pottery"},
                {"Necklaces","Jewels"},{"Bracelets","Jewels"},{"Rings","Jewels"},
                {"Bangles","Jewels"},{"JewelEarrings","Jewels"},
                {"GreetingCards","Paper & Cards"},{"GiftBoxes","Paper & Cards"},
                {"PaperFlowers","Paper & Cards"},{"PaperShowpieces","Paper & Cards"},
                {"Scrapbooks","Paper & Cards"},
                {"JuteBags","Jute & Natural"},{"Baskets","Jute & Natural"},
                {"Trays","Jute & Natural"},{"DriedBouquets","Jute & Natural"},
                {"Paintings","Jute & Natural"},
                {"Coasters","Resin & Epoxy"},{"ResinEarrings","Resin & Epoxy"},
                {"ResinKeychains","Resin & Epoxy"},{"WallArt","Resin & Epoxy"},
                {"ResinServingTrays","Resin & Epoxy"},
              {"MetalEarrings","Metal & Wire"},{"Vases","Metal & Wire"},{"MetalVases","Metal & Wire"},
{"MetalFigurines","Metal & Wire"},{"MetalWallArt","Metal & Wire"},
{"CandleHolders","Metal & Wire"}
            };

            var subcatDisplayNames = new Dictionary<string, string> {
                {"CushionCovers","Cushion Covers"},{"PrintedKurtas","Printed Kurtas"},
                {"TieDyeDupattas","Tie-Dye Dupattas"},{"FabricToteBags","Tote Bags"},
                {"Sweaters","Sweaters"},{"CrochetBags","Crochet Bags"},
                {"StorageBaskets","Storage Baskets"},{"Beanies","Beanies"},
                {"LeatherHandbags","Handbags"},{"Wallets","Wallets"},{"Belts","Belts"},
                {"LeatherKeychains","Keychains"},{"Journals","Journals"},
                {"PhotoFrames","Photo Frames"},{"WoodNecklaces","Necklaces"},
                {"WoodToys","Toys"},{"ServingTrays","Serving Trays"},
                {"WoodShowpieces","Showpieces"},{"WoodKeychains","Keychains"},
                {"FlowerPots","Flower Pots"},{"CoffeeMugs","Coffee Mugs"},
                {"ClayVases","Vases"},{"ClayEarrings","Earrings"},{"ClayFigurines","Figurines"},
                {"Necklaces","Necklaces"},{"Bracelets","Bracelets"},{"Rings","Rings"},
                {"Bangles","Bangles"},{"JewelEarrings","Earrings"},
                {"GreetingCards","Greeting Cards"},{"GiftBoxes","Gift Boxes"},
                {"PaperFlowers","Paper Flowers"},{"PaperShowpieces","Showpieces"},
                {"Scrapbooks","Scrapbooks"},
                {"JuteBags","Bags"},{"Baskets","Baskets"},{"Trays","Trays"},
                {"DriedBouquets","Dried Bouquets"},{"Paintings","Paintings"},
                {"Coasters","Coasters"},{"ResinEarrings","Earrings"},
                {"ResinKeychains","Keychains"},{"WallArt","Wall Art"},
                {"ResinServingTrays","Serving Trays"},
               {"MetalEarrings","Earrings"},{"Vases","Vases"},{"MetalVases","Vases"},
{"MetalFigurines","Figurines"},{"MetalWallArt","Wall Art"},
{"CandleHolders","Candle Holders"}
            };

            var grouped = Model?
                .GroupBy(p => p.Category ?? "Other")
                .ToList();

            var mainCatGroups = grouped?
                .GroupBy(g => categoryMap.ContainsKey(g.Key) ? categoryMap[g.Key] : "Other")
                .ToList();
        }

        @{
            var allSubCats = ViewBag.AllSubCategories as List<string> ?? new List<string>();

            // Saari subcategories ko main categories mein group karo
            var allMainCats = allSubCats
                .GroupBy(s => categoryMap.ContainsKey(s) ? categoryMap[s] : "Other")
                .ToList();
        }

        @foreach (var mainCat in allMainCats)
        {
            var totalProducts = Model?.Count(p =>
                mainCat.Any(s => s == p.Category)) ?? 0;
            var catIndex2 = allMainCats.IndexOf(mainCat);

            <div class="cat-section">
                <div class="cat-header" onclick="toggleCat(@catIndex2)">
                    <span class="cat-name">@mainCat.Key</span>
                    <div style="display:flex;align-items:center;gap:10px;">
                        <span class="cat-count">@totalProducts products</span>
                        <i class="fas fa-chevron-down cat-arrow" id="arrow-@catIndex2"></i>
                    </div>
                </div>
                <div class="subcat-list" id="subcat-@catIndex2">
                    @{
                        int subIdx = 0;
                    }
                    @foreach (var subCat in mainCat)
                    {
                        var displayName = subcatDisplayNames.ContainsKey(subCat)
                            ? subcatDisplayNames[subCat] : subCat;
                        var subProducts = Model?.Where(p => p.Category == subCat).ToList()
                            ?? new List<customerseller.Models.Product>();

                        <div class="subcat-item" onclick="toggleProducts(@catIndex2, @subIdx)">
                            <span class="subcat-name">@displayName</span>
                            <span class="subcat-badge">@subProducts.Count items</span>
                        </div>
                        <div class="products-panel" id="products-@catIndex2-@subIdx">
                            @if (subProducts.Any())
                            {
                                <div class="pi-table-wrap">
                                    <div class="pi-thead">
                                        <span>Image</span>
                                        <span>Product</span>
                                        <span>Price</span>
                                        <span>Stock</span>
                                        <span>Status</span>
                                        <span>Actions</span>
                                    </div>
                                    @foreach (var product in subProducts)
                                    {
                                        <div class="pi-row product-row" data-name="@product.Title?.ToLower()">
                                            <div class="pi-img">
                                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                                {
                                                    <img src="@product.ImageUrl" alt="@product.Title">
                                                }
                                            </div>
                                            <div class="pi-name">@product.Title</div>
                                            <div class="pi-price">PKR @product.Price</div>
                                            <div class="pi-stock">@product.Stock units</div>
                                            <div>
                                                <span class="pi-badge @(product.Status == "Approved" ? "approved" : product.Status == "Rejected" ? "rejected" : "pending")">
                                                    @(product.Status ?? "Pending")
                                                </span>
                                            </div>
                                            <div style="display:flex;gap:6px;">
                                                <a href="/Products/EditProduct/@product.Id"
                                                   style="padding:5px 10px;background:#fdf0f6;color:#a64d79;border-radius:6px;font-size:0.75rem;font-weight:600;text-decoration:none;">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <button onclick="deleteProduct('@product.Id')"
                                                        style="padding:5px 10px;background:#ffebee;color:#c62828;border-radius:6px;font-size:0.75rem;font-weight:600;border:none;cursor:pointer;">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div style="padding:20px;text-align:center;color:#aaa;font-size:13px;">
                                    <i class="fas fa-box-open" style="display:block;font-size:1.5rem;margin-bottom:8px;"></i>
                                    No products in this subcategory yet.
                                    <a href="/Products/AddProduct" style="display:block;margin-top:8px;color:#a64d79;font-weight:600;font-size:12px;">+ Add Product</a>
                                </div>
                            }
                        </div>
                        subIdx++;
                    }
                </div>
            </div>
        }
        
       
    </div>
</div>

<!-- Delete Modal -->
<div id="deleteModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:9999;align-items:center;justify-content:center;">
    <div style="background:#fff;border-radius:16px;padding:32px;max-width:380px;width:90%;text-align:center;">
        <div style="font-size:2.5rem;margin-bottom:12px;">🗑️</div>
        <h3 style="font-size:1.1rem;font-weight:700;color:#1e1033;margin-bottom:8px;">Delete Product?</h3>
        <p style="font-size:0.85rem;color:#6b7280;margin-bottom:20px;">This action cannot be undone.</p>
        <div style="display:flex;gap:10px;justify-content:center;">
            <button onclick="closeDeleteModal()" style="padding:10px 24px;border-radius:9px;border:1.5px solid #ddd;background:#fff;cursor:pointer;font-weight:600;">Cancel</button>
            <button id="confirmDeleteBtn" style="padding:10px 24px;border-radius:9px;border:none;background:#c62828;color:#fff;cursor:pointer;font-weight:600;">Yes, Delete</button>
        </div>
    </div>
</div>

<script>
    function toggleCat(index) {
        const subcat = document.getElementById('subcat-' + index);
        const arrow = document.getElementById('arrow-' + index);
        subcat.classList.toggle('open');
        arrow.classList.toggle('open');
    }

    function toggleProducts(catIndex, subIndex) {
        const panel = document.getElementById('products-' + catIndex + '-' + subIndex);
        panel.classList.toggle('open');
    }

    function filterSearch() {
        const query = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('.product-row').forEach(row => {
            const name = row.getAttribute('data-name') || '';
            row.style.display = name.includes(query) ? 'grid' : 'none';
        });
        if (query.length > 0) {
            document.querySelectorAll('.subcat-list').forEach(s => s.classList.add('open'));
            document.querySelectorAll('.products-panel').forEach(p => p.classList.add('open'));
            document.querySelectorAll('.cat-arrow').forEach(a => a.classList.add('open'));
        }
    }

    let deleteProductId = null;
    function deleteProduct(id) {
        deleteProductId = id;
        document.getElementById('deleteModal').style.display = 'flex';
    }
    function closeDeleteModal() {
        document.getElementById('deleteModal').style.display = 'none';
        deleteProductId = null;
    }
    document.getElementById('confirmDeleteBtn').addEventListener('click', async function () {
        if (!deleteProductId) return;
        this.textContent = 'Deleting...';
        this.disabled = true;
        const res = await fetch('/Products/DeleteProduct', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: deleteProductId })
        });
        const data = await res.json();
        if (data.success) { closeDeleteModal(); location.reload(); }
        else { this.textContent = 'Yes, Delete'; this.disabled = false; }
    });
</script>