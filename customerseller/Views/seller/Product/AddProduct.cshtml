@model customerseller.Models.Product
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Add Product";
}

<style>
    .add-product-container {
        max-width: 700px;
        margin: 30px auto;
        background: #fff;
        border-radius: 16px;
        padding: 35px;
        box-shadow: 0 2px 20px rgba(0,0,0,0.08);
    }
    .add-product-container h2 {
        font-size: 1.5rem;
        color: #1a1a2e;
        margin-bottom: 25px;
        font-weight: 700;
    }
    .form-group { margin-bottom: 20px; }
    .form-group label {
        display: block;
        font-size: 0.82rem;
        font-weight: 700;
        color: #555;
        margin-bottom: 7px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .form-group label span.required { color: #e74c3c; margin-left: 3px; }
    .form-group input,
    .form-group textarea,
    .form-group select {
        width: 100%;
        padding: 12px 15px;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        font-size: 0.92rem;
        outline: none;
        transition: border 0.3s;
        background: #fafafa;
        font-family: inherit;
    }
    .form-group input:focus,
    .form-group textarea:focus,
    .form-group select:focus { border-color: #a64d79; background: #fff; }
    .form-group textarea { min-height: 100px; resize: vertical; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .upload-box {
        border: 2px dashed #e0e0e0;
        border-radius: 10px;
        padding: 20px;
        text-align: center;
        cursor: pointer;
        transition: border 0.3s;
        background: #fafafa;
    }
    .upload-box:hover { border-color: #a64d79; }
    .upload-box i { font-size: 2rem; color: #bbb; margin-bottom: 8px; display: block; }
    .upload-box p { font-size: 0.85rem; color: #888; margin: 0; }
    .upload-box input { display: none; }
    .video-required {
        background: #fff3e0;
        border: 1px solid #ffcc80;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.82rem;
        color: #e65100;
        margin-bottom: 15px;
    }
    .video-already {
        background: #e8f5e9;
        border: 1px solid #a5d6a7;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.82rem;
        color: #2e7d32;
        margin-bottom: 15px;
    }
    .preview-img {
        max-height: 120px;
        border-radius: 8px;
        margin-top: 10px;
        display: none;
    }
    .video-name { font-size: 0.82rem; color: #2e7d32; margin-top: 8px; display: none; }
    .form-buttons { display: flex; gap: 12px; margin-top: 25px; }
    .btn-save {
        flex: 1;
        padding: 14px;
        background: linear-gradient(135deg, #a64d79, #880e4f);
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.3s;
    }
    .btn-save:hover { opacity: 0.9; }
    .btn-cancel {
        padding: 14px 25px;
        background: #f5f5f5;
        color: #555;
        border: none;
        border-radius: 10px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        display: flex;
        align-items: center;
    }
    #videoSection { display: none; }
    .form-group input.invalid { border-color: #e74c3c; background: #fff5f5; }
    .field-error { display: none; color: #c62828; font-size: 0.78rem; margin-top: 5px; }
    .field-error.show { display: block; }

    /* ---------- Color picker (hex code) ---------- */
    .color-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 8px;
    }
    .form-group .color-head label { margin-bottom: 0; }
    .form-group .color-head .optional {
        font-weight: 500;
        color: #999;
        text-transform: none;
        letter-spacing: 0;
    }
    .color-count { font-size: 0.78rem; color: #999; }
    .color-count.has { color: #a64d79; font-weight: 600; }

    .color-add-row { display: flex; gap: 10px; align-items: stretch; }
    .form-group .color-picker-input {
        width: 52px;
        height: 46px;
        padding: 4px;
        border: 1.5px solid #e0e0e0;
        border-radius: 10px;
        background: #fff;
        cursor: pointer;
        flex-shrink: 0;
    }
    .form-group .color-text {
        flex: 1;
        min-width: 0;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-family: ui-monospace, Consolas, monospace;
    }
    .color-add-btn {
        padding: 0 22px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #a64d79, #880e4f);
        color: #fff;
        font-weight: 600;
        font-size: 0.88rem;
        cursor: pointer;
        white-space: nowrap;
    }
    .color-add-btn:hover { opacity: 0.9; }
    .color-msg { display: none; color: #c62828; font-size: 0.78rem; margin-top: 6px; }
    .color-msg.show { display: block; }
    .color-hint { font-size: 0.76rem; color: #999; margin-top: 8px; }

    .color-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .color-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1.5px solid #eee;
        border-radius: 30px;
        padding: 5px 8px 5px 6px;
        font-size: 0.8rem;
        font-weight: 600;
        color: #444;
        font-family: ui-monospace, Consolas, monospace;
    }
    .chip-dot {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        border: 1px solid rgba(0,0,0,0.15);
    }
    .color-chip button {
        border: none;
        background: transparent;
        color: #999;
        font-size: 1.05rem;
        line-height: 1;
        cursor: pointer;
        padding: 0 3px;
    }
    .color-chip button:hover { color: #e74c3c; }

    @@media (max-width: 480px) {
        .add-product-container {
            margin: 15px 10px;
            padding: 20px;
        }

        .form-row {
            grid-template-columns: 1fr;
        }

        .form-buttons {
            flex-wrap: wrap;
        }

        .btn-save, .btn-cancel {
            flex: 1 1 100%;
        }
    }
</style>

<div class="add-product-container">
    <h2><i class="fa-solid fa-plus" style="color:#8b5cf6; margin-right:8px;"></i>Add New Product</h2>

    @if (TempData["ProductSuccess"] != null)
    {
        <div style="background:#e8f5e9; border:1px solid #a5d6a7; border-radius:8px; padding:12px 16px; margin-bottom:20px; color:#2e7d32; font-size:0.88rem;">
            <i class="fa-solid fa-check"></i> @TempData["ProductSuccess"]
        </div>
    }

    @if (TempData["ProductError"] != null)
    {
        <div style="background:#ffebee; border:1px solid #ffcdd2; border-radius:8px; padding:12px 16px; margin-bottom:20px; color:#c62828; font-size:0.88rem;">
            <i class="fa-solid fa-circle-exclamation"></i> @TempData["ProductError"]
        </div>
    }

    @if ((bool)(ViewBag.ShopPendingApproval ?? false))
    {
        <div style="background:#fff3e0; border:1px solid #ffcc80; border-radius:8px; padding:12px 16px; margin-bottom:20px; color:#e65100; font-size:0.88rem;">
            <i class="fa-solid fa-circle-info"></i> Your shop is under admin review. But you can upload products and videos in the meantime.
        </div>
    }

    <form method="post" asp-action="AddProduct" asp-controller="Products" enctype="multipart/form-data" id="productForm">

        <div class="form-row">
            <div class="form-group">
                <label>Product Name <span class="required">*</span></label>
                <input type="text" name="Title" id="productTitle" placeholder="Enter product name" maxlength="60" autocomplete="off" required />
                <div class="field-error" id="err-productTitle"></div>
            </div>
            <div class="form-group">
                <label>Price (Rs.) <span class="required">*</span></label>
                <input type="number" name="Price" placeholder="0.00" min="1" required />
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Main Category <span class="required">*</span></label>
                <select id="mainCategory" onchange="loadSubCategories()" required>
                    <option value="">-- Select Category --</option>
                    <option value="FabricTextile">🧵 Fabric & Textile</option>
                    <option value="WoolYarn">🧶 Wool & Yarn</option>
                    <option value="Leather">👜 Leather</option>
                    <option value="Wood">🪵 Wood</option>
                    <option value="ClayPottery">🏺 Clay & Pottery</option>
                    <option value="Jewels">💎 Jewels</option>
                    <option value="PaperCards">📄 Paper & Cards</option>
                    <option value="JuteNatural">🌿 Jute & Natural</option>
                    <option value="ResinEpoxy">🔮 Resin & Epoxy</option>
                    <option value="MetalWire">⚙️ Metal & Wire</option>
                </select>
            </div>
            <div class="form-group">
                <label>Sub Category <span class="required">*</span></label>
                <select id="subCategory" name="Category" required onchange="checkVideoStatus(); toggleSizesField();">
                    <option value="">-- Select Main Category First --</option>
                </select>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label>Stock <span class="required">*</span></label>
                <input type="number" name="Stock" placeholder="0" min="1" required />
            </div>
            <div class="form-group" id="sizesFieldGroup" style="display:none;">
                <label>Sizes (optional)</label>
                <input type="text" name="sizes" placeholder="e.g. S, M, L, XL" />
            </div>
        </div>

        <div class="form-group">
            <div class="color-head">
                <label>Color <span class="optional">(optional)</span></label>
                <span class="color-count" id="colorCount">None added</span>
            </div>

            <div class="color-add-row">
                <input type="color" id="colorPicker" class="color-picker-input" value="#a64d79"
                       title="Pick a color" oninput="onColorPickerInput()" />
                <input type="text" id="colorText" class="color-text" placeholder="Color code e.g. #FF0000"
                       maxlength="7" autocomplete="off"
                       oninput="onColorTextInput()" onkeydown="colorKeyDown(event)" />
                <button type="button" class="color-add-btn" onclick="addColor()">
                    <i class="fa-solid fa-plus"></i> Add
                </button>
            </div>
            <div class="color-msg" id="colorMsg"></div>
            <div class="color-hint">Type a color code (like #FF0000) or pick it with the box, then press Add. You can add more than one color. Customers will see these colors automatically.</div>

            <div class="color-chips" id="colorChips"></div>
            <input type="hidden" name="Color" id="ColorHidden" />
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea name="Description" placeholder="Describe your product..."></textarea>
        </div>

        <div class="form-group">
            <label>Product Image <span class="required">*</span></label>
            <div class="upload-box" onclick="document.getElementById('imageFile').click()">
                <i class="fa-solid fa-image" id="imageIcon"></i>
                <p id="imageText">Click to upload product image</p>
                <p style="font-size:0.75rem; color:#bbb;">JPG, PNG (Max 5MB)</p>
                <input type="file" id="imageFile" name="ImageFile" accept="image/*" required onchange="previewImage(this)">
                <img id="imgPreview" class="preview-img" style="max-height:120px; border-radius:8px; margin-top:10px; display:none;">
            </div>
        </div>

        <div id="videoSection" class="form-group">
            <label>Making Video <span class="required">*</span></label>
            <div id="videoStatusMsg"></div>
            <div id="videoUploadBox" class="upload-box" onclick="document.getElementById('videoFile').click()">
                <i class="fa-solid fa-video"></i>
                <p>Click to upload making video for this sub-category</p>
                <p style="font-size:0.75rem; color:#bbb;">MP4, MOV (Max 50MB) — Only required once per sub-category</p>
                <input type="file" id="videoFile" name="VideoFile" accept="video/*" onchange="showVideoName(this)">
                <p id="videoName" class="video-name" style="font-size:0.82rem; color:#2e7d32; margin-top:8px; display:none;">
                    <i class="fa-solid fa-check"></i> <span></span>
                </p>
            </div>
        </div>

        <div class="form-buttons">
            <button type="submit" class="btn-save" id="submitBtn">
                <i class="fa-solid fa-paper-plane"></i> Submit for Review
            </button>
            <button type="button" class="btn-save" id="addMoreBtn"
                    onclick="saveAndAddMore()"
                    style="background:linear-gradient(135deg,#6b7280,#4b5563);">
                <i class="fa-solid fa-plus"></i> Add More Product
            </button>
            <a href="/Products/SellerProduct" class="btn-cancel">Cancel</a>
        </div>

        <div id="toastMsg" style="display:none; position:fixed; bottom:30px; right:30px; background:#a64d79; color:#fff; padding:14px 24px; border-radius:10px; font-weight:600; z-index:9999; box-shadow:0 4px 20px rgba(0,0,0,0.2);">
            ✅ Product saved! Fill in the next one.
        </div>
    </form>
</div>

<script>
    const subCategoryMap = {
        'FabricTextile': [
            { val: 'CushionCovers', label: 'Cushion Covers' },
            { val: 'PrintedKurtas', label: 'Printed Kurtas' },
            { val: 'TieDyeDupattas', label: 'Tie-Dye Dupattas' },
            { val: 'FabricToteBags', label: 'Tote Bags' }
        ],
        'WoolYarn': [
            { val: 'Sweaters', label: 'Sweaters' },
            { val: 'CrochetBags', label: 'Crochet Bags' },
            { val: 'StorageBaskets', label: 'Storage Baskets' },
            { val: 'Beanies', label: 'Beanies' }
        ],
        'Leather': [
            { val: 'LeatherHandbags', label: 'Handbags' },
            { val: 'Wallets', label: 'Wallets' },
            { val: 'Belts', label: 'Belts' },
            { val: 'LeatherKeychains', label: 'Keychains' },
            { val: 'Journals', label: 'Journals' }
        ],
        'Wood': [
            { val: 'PhotoFrames', label: 'Photo Frames' },
            { val: 'WoodNecklaces', label: 'Necklaces' },
            { val: 'WoodToys', label: 'Toys' },
            { val: 'ServingTrays', label: 'Serving Trays' },
            { val: 'WoodShowpieces', label: 'Showpieces' },
            { val: 'WoodKeychains', label: 'Keychains' }
        ],
        'ClayPottery': [
            { val: 'FlowerPots', label: 'Flower Pots' },
            { val: 'CoffeeMugs', label: 'Coffee Mugs' },
            { val: 'ClayVases', label: 'Vases' },
            { val: 'ClayEarrings', label: 'Earrings' },
            { val: 'ClayFigurines', label: 'Figurines' }
        ],
        'Jewels': [
            { val: 'Necklaces', label: 'Necklaces' },
            { val: 'Bracelets', label: 'Bracelets' },
            { val: 'Rings', label: 'Rings' },
            { val: 'Bangles', label: 'Bangles' },
            { val: 'JewelEarrings', label: 'Earrings' }
        ],
        'PaperCards': [
            { val: 'GreetingCards', label: 'Greeting Cards' },
            { val: 'GiftBoxes', label: 'Gift Boxes' },
            { val: 'PaperFlowers', label: 'Paper Flowers' },
            { val: 'PaperShowpieces', label: 'Showpieces' },
            { val: 'Scrapbooks', label: 'Scrapbooks' }
        ],
        'JuteNatural': [
            { val: 'JuteBags', label: 'Bags' },
            { val: 'Baskets', label: 'Baskets' },
            { val: 'Trays', label: 'Trays' },
            { val: 'DriedBouquets', label: 'Dried Bouquets' },
            { val: 'Paintings', label: 'Paintings' }
        ],
        'ResinEpoxy': [
            { val: 'Coasters', label: 'Coasters' },
            { val: 'ResinEarrings', label: 'Earrings' },
            { val: 'ResinKeychains', label: 'Keychains' },
            { val: 'WallArt', label: 'Wall Art' },
            { val: 'ResinServingTrays', label: 'Serving Trays' }
        ],
        'MetalWire': [
            { val: 'MetalEarrings', label: 'Earrings' },
            { val: 'MetalVases', label: 'Vases' },
            { val: 'MetalFigurines', label: 'Figurines' },
            { val: 'MetalWallArt', label: 'Wall Art' },
            { val: 'CandleHolders', label: 'Candle Holders' }
        ]
    };

    let sellerSubCategories = [];   // ShopSetup mein seller ne jo sub-categories chuni thin

    function loadSubCategories() {
        const main = document.getElementById('mainCategory').value;
        const sub = document.getElementById('subCategory');
        sub.innerHTML = '<option value="">-- Select Sub Category --</option>';
        document.getElementById('videoSection').style.display = 'none';
        toggleSizesField();

        if (main && subCategoryMap[main]) {
            subCategoryMap[main].forEach(item => {
                if (sellerSubCategories.length && !sellerSubCategories.includes(item.val)) return;
                const opt = document.createElement('option');
                opt.value = item.val;
                opt.textContent = item.label;
                sub.appendChild(opt);
            });
        }
    }

    const SIZEABLE_SUBCATS = ['PrintedKurtas', 'Sweaters', 'Beanies', 'Belts'];
    function toggleSizesField() {
        const subCat = document.getElementById('subCategory').value;
        const group = document.getElementById('sizesFieldGroup');
        const input = group.querySelector('input[name="sizes"]');
        if (SIZEABLE_SUBCATS.includes(subCat)) {
            group.style.display = '';
        } else {
            group.style.display = 'none';
            input.value = '';
        }
    }

    async function checkVideoStatus() {
        const subCat = document.getElementById('subCategory').value;
        if (!subCat) return;

        const videoSection = document.getElementById('videoSection');
        const videoStatusMsg = document.getElementById('videoStatusMsg');
        const videoUploadBox = document.getElementById('videoUploadBox');
        const videoFileInput = document.getElementById('videoFile');

        videoSection.style.display = 'block';

        const res = await fetch('/Products/CheckSubCategoryVideo?subCategory=' + subCat);
        const data = await res.json();

        if (data.hasVideo) {
            videoStatusMsg.innerHTML = `
                <div class="video-already">
                    <i class="fa-solid fa-circle-check"></i>
                    Making video for this sub-category is already uploaded (${data.status}).
                    No need to upload again.
                </div>`;
            videoUploadBox.style.display = 'none';
            videoFileInput.removeAttribute('required');
        } else {
            videoStatusMsg.innerHTML = `
                <div class="video-required">
                    <i class="fa-solid fa-circle-info"></i>
                    No making video found for this sub-category. Please upload one — required only once.
                </div>`;
            videoUploadBox.style.display = 'block';
            videoFileInput.setAttribute('required', 'required');
        }
    }

    // ---------- Product Name: sirf letters aur space ----------
    function validateProductTitle() {
        const input = document.getElementById('productTitle');
        const err = document.getElementById('err-productTitle');
        const v = input.value.trim();
        let msg = '';
        if (!v) msg = 'Product name is required.';
        else if (v.length < 3) msg = 'Product name must be at least 3 characters.';
        else if (!/^[A-Za-z]+( [A-Za-z]+)*$/.test(v)) msg = 'Product name must contain letters only (no numbers or symbols).';
        input.classList.toggle('invalid', !!msg);
        err.textContent = msg ? '⚠️ ' + msg : '';
        err.classList.toggle('show', !!msg);
        return msg;
    }

    function resetProductTitleError() {
        document.getElementById('productTitle').classList.remove('invalid');
        const err = document.getElementById('err-productTitle');
        err.textContent = '';
        err.classList.remove('show');
    }

    (function () {
        const input = document.getElementById('productTitle');

        function cleanTitle(v) {
            return v.replace(/[^A-Za-z ]/g, '').replace(/^ +/, '').replace(/ {2,}/g, ' ');
        }

        // Key dabate hi number/symbol block
        input.addEventListener('keydown', function (e) {
            if (e.ctrlKey || e.metaKey || e.altKey) return;
            if (e.key.length === 1 && !/[A-Za-z ]/.test(e.key)) e.preventDefault();
        });

        // Paste / autofill ki safai
        input.addEventListener('input', function () {
            const cleaned = cleanTitle(this.value);
            if (cleaned !== this.value) this.value = cleaned;
            if (this.classList.contains('invalid')) validateProductTitle();
        });

        input.addEventListener('blur', validateProductTitle);
    })();

    // ---------- Color picker (seller color code likhta hai) ----------
    let selectedColors = [];
    const MAX_COLORS = 8;

    function normalizeHex(v) {
        v = (v || '').trim().replace(/^#/, '');
        if (/^[0-9a-fA-F]{3}$/.test(v)) v = v.split('').map(function (c) { return c + c; }).join('');
        if (!/^[0-9a-fA-F]{6}$/.test(v)) return null;
        return '#' + v.toUpperCase();
    }

    function showColorMsg(msg) {
        const el = document.getElementById('colorMsg');
        el.textContent = msg ? '⚠️ ' + msg : '';
        el.classList.toggle('show', !!msg);
    }

    function onColorTextInput() {
        const hex = normalizeHex(document.getElementById('colorText').value);
        if (hex) document.getElementById('colorPicker').value = hex.toLowerCase();
        showColorMsg('');
    }

    function onColorPickerInput() {
        document.getElementById('colorText').value = document.getElementById('colorPicker').value.toUpperCase();
        showColorMsg('');
    }

    function colorKeyDown(e) {
        if (e.key === 'Enter') {
            e.preventDefault();   // form submit na ho
            addColor();
        }
    }

    function addColor() {
        const text = document.getElementById('colorText');
        if (!text.value.trim()) { showColorMsg('Type a color code or pick a color first.'); return; }

        const hex = normalizeHex(text.value);
        if (!hex) { showColorMsg('Invalid color code. Use a code like #FF0000.'); return; }
        if (selectedColors.includes(hex)) { showColorMsg('This color is already added.'); return; }
        if (selectedColors.length >= MAX_COLORS) { showColorMsg('You can add up to ' + MAX_COLORS + ' colors.'); return; }

        selectedColors.push(hex);
        text.value = '';
        showColorMsg('');
        updateColorField();
    }

    function removeColor(hex) {
        selectedColors = selectedColors.filter(function (c) { return c !== hex; });
        updateColorField();
    }

    function clearColors() {
        selectedColors = [];
        document.getElementById('colorText').value = '';
        showColorMsg('');
        updateColorField();
    }

    function updateColorField() {
        // Controller ko "#DC2626, #2563EB" jaisa text milta hai
        document.getElementById('ColorHidden').value = selectedColors.join(', ');

        const count = document.getElementById('colorCount');
        count.textContent = selectedColors.length ? selectedColors.length + ' added' : 'None added';
        count.classList.toggle('has', selectedColors.length > 0);

        const chips = document.getElementById('colorChips');
        chips.innerHTML = '';
        selectedColors.forEach(function (hex) {
            const chip = document.createElement('span');
            chip.className = 'color-chip';

            const dot = document.createElement('span');
            dot.className = 'chip-dot';
            dot.style.backgroundColor = hex;

            const label = document.createElement('span');
            label.textContent = hex;

            const remove = document.createElement('button');
            remove.type = 'button';
            remove.innerHTML = '&times;';
            remove.title = 'Remove ' + hex;
            remove.addEventListener('click', function () { removeColor(hex); });

            chip.appendChild(dot);
            chip.appendChild(label);
            chip.appendChild(remove);
            chips.appendChild(chip);
        });
    }

    function previewImage(input) {
        const preview = document.getElementById('imgPreview');
        const icon = document.getElementById('imageIcon');
        const text = document.getElementById('imageText');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = e => {
                preview.src = e.target.result;
                preview.style.display = 'block';
                icon.style.display = 'none';
                text.style.display = 'none';
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    function showVideoName(input) {
        const nameEl = document.getElementById('videoName');
        if (input.files && input.files[0]) {
            nameEl.querySelector('span').textContent = input.files[0].name;
            nameEl.style.display = 'block';
        }
    }

    document.getElementById('productForm').addEventListener('submit', function(e) {
        if (validateProductTitle()) {
            e.preventDefault();
            document.getElementById('productTitle').scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
        }

        // Code likha hai lekin Add nahi dabaya? Khud add kar do
        const pendingHex = normalizeHex(document.getElementById('colorText').value);
        if (pendingHex && !selectedColors.includes(pendingHex) && selectedColors.length < MAX_COLORS) {
            selectedColors.push(pendingHex);
            document.getElementById('colorText').value = '';
            updateColorField();
        }

        const videoSection = document.getElementById('videoSection');
        const videoUploadBox = document.getElementById('videoUploadBox');
        const videoFile = document.getElementById('videoFile');

        if (videoSection.style.display === 'block' &&
            videoUploadBox.style.display !== 'none') {

            if (!videoFile.files || videoFile.files.length === 0) {
                e.preventDefault();
                document.getElementById('videoStatusMsg').innerHTML = `
                    <div class="video-required">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        Please upload a making video for this sub-category before submitting.
                    </div>`;
                videoSection.scrollIntoView({ behavior: 'smooth' });
                return false;
            }
        }
    });

    async function saveAndAddMore() {
        const form = document.getElementById('productForm');

        const title = form.querySelector('input[name="Title"]').value.trim();
        const price = form.querySelector('input[name="Price"]').value.trim();
        const stock = form.querySelector('input[name="Stock"]').value.trim();
        const subCat = document.getElementById('subCategory').value;
        const imageFile = document.getElementById('imageFile').files[0];

        if (validateProductTitle()) {
            document.getElementById('productTitle').scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }
        if (!price) { alert('Please enter price!'); return; }
        if (!stock) { alert('Please enter stock!'); return; }
        if (!subCat) { alert('Please select sub category!'); return; }
        if (!imageFile) { alert('Please upload product image!'); return; }

        const videoSection = document.getElementById('videoSection');
        const videoUploadBox = document.getElementById('videoUploadBox');
        const videoFile = document.getElementById('videoFile');
        if (videoSection.style.display === 'block' &&
            videoUploadBox.style.display !== 'none') {
            if (!videoFile.files || videoFile.files.length === 0) {
                document.getElementById('videoStatusMsg').innerHTML = `
                    <div class="video-required">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        Please upload a making video for this sub-category before submitting.
                    </div>`;
                videoSection.scrollIntoView({ behavior: 'smooth' });
                return;
            }
        }

        const formData = new FormData(form);

        const btn = document.getElementById('addMoreBtn');
        btn.textContent = 'Saving...';
        btn.disabled = true;

        try {
            const res = await fetch('/Products/AddProduct', {
                method: 'POST',
                body: formData,
                headers: { 'X-Add-More': 'true' }
            });

            if (res.ok || res.redirected) {
                form.reset();
                clearColors();       // colors aur hidden value saaf
                resetProductTitleError();
                toggleSizesField();
                document.getElementById('imgPreview').style.display = 'none';
                document.getElementById('imageIcon').style.display = '';
                document.getElementById('imageText').style.display = '';
                document.getElementById('videoSection').style.display = 'none';
                document.getElementById('subCategory').innerHTML = '<option value="">-- Select Main Category First --</option>';

                const toast = document.getElementById('toastMsg');
                toast.style.display = 'block';
                setTimeout(() => toast.style.display = 'none', 3000);
            }
        } catch(e) {
            alert('Error saving product. Please try again.');
        }

        btn.innerHTML = '<i class="fa-solid fa-plus"></i> Add More Product';
        btn.disabled = false;
    }

    document.addEventListener('DOMContentLoaded', async function() {
        updateColorField();

        const res = await fetch('/Products/GetSellerCategories');
        const data = await res.json();

        if (data.categories && data.categories.length > 0) {
            sellerSubCategories = data.categories;
            const mainCatSelect = document.getElementById('mainCategory');
            const allOptions = mainCatSelect.querySelectorAll('option');

            allOptions.forEach(opt => {
                if (opt.value === '') return;
                const subCats = subCategoryMap[opt.value] || [];
                const hasMatch = subCats.some(sc => data.categories.includes(sc.val));
                if (!hasMatch) {
                    opt.style.display = 'none';
                }
            });
        }
    });
</script>
