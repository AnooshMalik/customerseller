@{
    Layout = "_DashboardLayout";
    var subcategory = ViewBag.SubCategory as string;
}
<style>
    @@media (max-width: 480px) {
        .reupload-container {
            margin: 15px 12px !important;
            padding: 20px !important;
        }
    }
</style>
<div style="max-width:600px; margin:30px auto; background:#fff; padding:35px; border-radius:12px; box-shadow:0 2px 12px rgba(0,0,0,0.06);">
    <h2 style="color:#a64d79; margin-bottom:8px;">Re-upload Making Video</h2>
    <p style="color:#666; font-size:0.9rem; margin-bottom:20px;">Sub-category: <strong>@subcategory</strong></p>

    <form asp-action="UploadSubCategoryVideo" asp-controller="Products" method="post" enctype="multipart/form-data">
        <input type="hidden" name="subcategory" value="@subcategory" />

        <div style="margin-bottom:20px;">
            <label style="display:block; font-weight:600; color:#333; margin-bottom:8px;">Select Video File</label>

            <label for="videoFile" style="display:flex; align-items:center; justify-content:center; gap:8px; width:100%; padding:30px 12px; border:2px dashed #a64d79; border-radius:8px; cursor:pointer; color:#a64d79; font-weight:600; box-sizing:border-box;">
                <i class="fas fa-cloud-upload-alt" style="font-size:1.3rem;"></i>
                <span id="fileLabel">Click to choose video file</span>
            </label>
            <input type="file" id="videoFile" name="videoFile" accept="video/*" required
                   style="display:none;" onchange="document.getElementById('fileLabel').textContent = this.files[0] ? this.files[0].name : 'Click to choose video file'">

            <p style="font-size:0.75rem; color:#888; margin-top:6px;">Supported: MP4, MOV, AVI (Max 100MB)</p>
        </div>

        <div style="display:flex; gap:10px;">
            <a href="/Products/SellerProduct" style="flex:1; padding:12px; background:#f1f5f9; color:#333; border:none; border-radius:8px; text-align:center; text-decoration:none; font-weight:600;">
                Cancel
            </a>
            <button type="submit" style="flex:1; padding:12px; background:#a64d79; color:#fff; border:none; border-radius:8px; font-weight:600; cursor:pointer;">
                Upload Video
            </button>
        </div>
    </form>
</div>