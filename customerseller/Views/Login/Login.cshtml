<link href="~/style.css" rel="stylesheet" />

@{
    Layout = "_Layout";
}

<div class="login-container">
    <div class="login-sidebar">
        <i class="fas fa-store-alt" style="font-size: 50px; margin-bottom: 20px;"></i>
        <h2>Welcome Back!</h2>
        <p>Login to access your shop dashboard, manage inventory, and track your artisan orders.</p>
    </div>

    <div class="login-form-section">
        <h2>Login</h2>

        <form asp-controller="Login" asp-action="Login" method="post">

            @* Error Message Display *@
            @if (ViewBag.Error != null)
            {
                <div style="background-color: #fce4ec; color: #d81b60; padding: 10px; border-radius: 5px; margin-bottom: 15px; font-size: 13px; border: 1px solid #f8bbd0;">
                    <i class="fas fa-exclamation-triangle"></i> @ViewBag.Error
                </div>
            }

            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="Enter your email" required>
            </div>

            <div class="form-group">
    <label>Password</label>
    <input type="password" 
           name="password" 
           id="userPassword"
           placeholder="Min 8 chars & 1 symbol" 
           required 
           minlength="8"
           title="Must contain at least 8 characters and one special symbol (!#$)">
</div>

            <div class="forgot-link">
                <a asp-controller="Login" asp-action="ForgotPassword">Forgot Password?</a>
            </div>

            @* --- REAL SUBMIT BUTTON (No <a> tag) --- *@
            <button type="submit" class="submit-btn" style="width:100%; cursor:pointer; border:none; outline:none;">
                Login to Shop
            </button>
        </form>

        <div class="signup-link-wrapper">
            New to Artisans? <a asp-controller="Login" asp-action="Signup">Create a Shop</a>
        </div>
    </div>
</div>