<link href="~/style.css" rel="stylesheet" />

@{
    Layout = "_Layout";
}

<div class="forgot-container">
    <i class="fas fa-key" style="font-size: 40px; color: #a64d79; margin-bottom: 15px;"></i>
    <h2>Forgot Password?</h2>
    <p>Enter your registered email below to receive a reset link.</p>

    @* --- SUCCESS MESSAGE --- *@
    @if (ViewBag.Message != null)
    {
        <div class="message-box success-msg" style="background-color: #e8f5e9; color: #2e7d32; padding: 10px; border-radius: 5px; margin-bottom: 15px; border: 1px solid #c8e6c9;">
            <i class="fas fa-check-circle"></i> @ViewBag.Message
        </div>
    }

    @* --- ERROR MESSAGE --- *@
    @if (ViewBag.Error != null)
    {
        <div class="message-box error-msg" style="background-color: #fce4ec; color: #d81b60; padding: 10px; border-radius: 5px; margin-bottom: 15px; border: 1px solid #f8bbd0;">
            <i class="fas fa-exclamation-circle"></i> @ViewBag.Error
        </div>
    }

    @* Form mein asp-controller aur asp-action add kar diya hai *@
    <form asp-controller="Login" asp-action="ForgotPassword" method="post">
        <div class="form-group">
            <label>Email Address</label>
            @* Name attribute 'email' hona chahiye taake Controller ise pakar sakay *@
            <input type="email" name="email" id="resetEmail" placeholder="Enter your registered email" required>
        </div>
        <button type="submit" class="submit-btn">Send Reset Link</button>
    </form>

    <br />
    <a asp-controller="Login" asp-action="Login" class="back-to-login">
        <i class="fas fa-arrow-left"></i> Back to Login
    </a>
</div>