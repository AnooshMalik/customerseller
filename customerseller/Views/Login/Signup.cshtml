@{
    Layout = "_Layout";
}
<style>
    .signup-container {
        display: flex;
        max-width: 900px;
        margin: 60px auto;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(166,77,121,0.15);
    }

    .signup-sidebar {
        background: #a64d79;
        color: #fff;
        width: 40%;
        padding: 50px 35px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
    }

        .signup-sidebar h2 {
            font-size: 1.6rem;
        }

    .signup-form-section {
        background: #fff;
        width: 60%;
        padding: 50px 40px;
    }

        .signup-form-section h2 {
            margin-bottom: 8px;
            color: #1a1a2e;
        }

        .signup-form-section p {
            margin-bottom: 24px;
            color: #888;
            font-size: 0.9rem;
        }

    .form-group {
        margin-bottom: 18px;
    }

        .form-group label {
            display: block;
            font-size: 0.78rem;
            font-weight: 700;
            color: #888;
            text-transform: uppercase;
            margin-bottom: 6px;
            letter-spacing: 0.5px;
        }

        .form-group input, .form-group select {
            width: 100%;
            padding: 12px 14px;
            border: 1.5px solid #e0e0e0;
            border-radius: 8px;
            font-size: 0.95rem;
            outline: none;
        }

            .form-group input:focus, .form-group select:focus {
                border-color: #a64d79;
            }

    .submit-btn {
        width: 100%;
        padding: 14px;
        background: #a64d79;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
    }

    .login-link {
        text-align: center;
        margin-top: 20px;
        font-size: 0.85rem;
        color: #666;
    }

        .login-link a {
            color: #a64d79;
            text-decoration: none;
            font-weight: 600;
        }

    @@media (max-width: 768px) {
        .signup-container {
            flex-direction: column;
            margin: 20px;
        }

        .signup-sidebar, .signup-form-section {
            width: 100%;
        }
    }
</style>

<div class="signup-container">
    <div class="signup-sidebar">
        <h2>Bring your business online.</h2>
    </div>

    <div class="signup-form-section">
        <h2>Create Shop Account</h2>
        <p>Join our community of talented artisans.</p>

        @if (TempData["RegisterError"] != null)
        {
            <div style="background-color: #fce4ec; color: #d81b60; padding: 10px; border-radius: 5px; margin-bottom: 15px; font-size: 14px; border: 1px solid #f8bbd0;">
                <i class="fas fa-exclamation-circle"></i> @TempData["RegisterError"]
            </div>
        }

        <form asp-controller="Account" asp-action="SellerRegister" method="post" autocomplete="off">
            <div class="form-group">
                <label>First Name</label>
                <input type="text" name="firstName" placeholder="Enter your first name" required autocomplete="off">
            </div>

            <div class="form-group">
                <label>Last Name</label>
                <input type="text" name="lastName" placeholder="Enter your last name" required autocomplete="off">
            </div>

            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="email@example.com" required autocomplete="off">
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="Minimum 8 characters" required minlength="8" autocomplete="new-password">
            </div>

            <button type="submit" class="submit-btn">Register My Shop</button>
        </form>

        <div class="login-link">
            Already have a shop? <a asp-controller="Account" asp-action="Login">Login here</a>
        </div>
    </div>
</div>