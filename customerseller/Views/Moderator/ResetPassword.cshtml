@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Reset Password - Artisan Valley</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', sans-serif;
                min-height: 100vh;
                display: flex;
            }

            .left-panel {
                width: 45%;
                background: #a64d79;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                padding: 60px 40px;
                position: relative;
                overflow: hidden;
            }

                .left-panel::before {
                    content: '';
                    position: absolute;
                    width: 300px;
                    height: 300px;
                    background: rgba(255,255,255,0.03);
                    border-radius: 50%;
                    top: -80px;
                    left: -80px;
                }

                .left-panel::after {
                    content: '';
                    position: absolute;
                    width: 200px;
                    height: 200px;
                    background: rgba(255,255,255,0.03);
                    border-radius: 50%;
                    bottom: -50px;
                    right: -50px;
                }

                .left-panel h1 {
                    color: #fff;
                    font-size: 2.8rem;
                    font-weight: 300;
                    letter-spacing: 2px;
                    text-align: center;
                    z-index: 1;
                }

                    .left-panel h1 span {
                        font-weight: 700;
                    }

                .left-panel p {
                    color: rgba(255,255,255,0.5);
                    font-size: 0.8rem;
                    letter-spacing: 4px;
                    text-transform: uppercase;
                    margin-top: 8px;
                    z-index: 1;
                }

            .left-divider {
                width: 50px;
                height: 2px;
                background: rgba(255,255,255,0.2);
                margin: 25px auto;
                z-index: 1;
            }

            .left-quote {
                color: rgba(255,255,255,0.6);
                font-style: italic;
                font-size: 1rem;
                text-align: center;
                z-index: 1;
                max-width: 280px;
                line-height: 1.6;
            }

            .right-panel {
                width: 55%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #fafafa;
                padding: 60px 40px;
            }

            .form-box {
                width: 100%;
                max-width: 420px;
            }

            .icon-box {
                width: 65px;
                height: 65px;
                background: #a64d79;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 20px;
            }

                .icon-box i {
                    color: #fff;
                    font-size: 1.6rem;
                }

            h2 {
                font-size: 1.8rem;
                color: #1a1a2e;
                font-weight: 600;
                margin-bottom: 8px;
            }

            .sub {
                color: #888;
                font-size: 0.88rem;
                margin-bottom: 30px;
                line-height: 1.6;
            }

            .error-box {
                background: #ffebee;
                color: #c62828;
                padding: 10px 14px;
                border-radius: 8px;
                margin-bottom: 15px;
                font-size: 0.9rem;
            }

            .field-label {
                display: block;
                font-size: 0.72rem;
                font-weight: 700;
                color: #999;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                margin-bottom: 8px;
            }

            .input-wrapper {
                position: relative;
                margin-bottom: 20px;
            }

            input {
                width: 100%;
                padding: 14px 16px;
                border: 1.5px solid #e0e0e0;
                border-radius: 10px;
                font-size: 0.95rem;
                outline: none;
                background: #fff;
                transition: border 0.3s;
            }

                input:focus {
                    border-color: #a64d79;
                }

            .toggle-pass {
                position: absolute;
                right: 14px;
                top: 50%;
                transform: translateY(-50%);
                cursor: pointer;
                color: #aaa;
                font-size: 0.9rem;
            }

            .submit-btn {
                width: 100%;
                padding: 15px;
                background: #a64d79;
                color: #fff;
                border: none;
                border-radius: 10px;
                font-size: 1rem;
                font-weight: 600;
                cursor: pointer;
                margin-top: 5px;
                transition: opacity 0.3s;
            }

                .submit-btn:hover {
                    opacity: 0.9;
                }

            .back-link {
                text-align: center;
                margin-top: 20px;
                font-size: 0.85rem;
            }

                .back-link a {
                    color: #a64d79;
                    text-decoration: none;
                }

            .footer-text {
                text-align: center;
                margin-top: 30px;
                color: #bbb;
                font-size: 0.8rem;
            }

            .password-strength {
                font-size: 0.78rem;
                margin-top: -14px;
                margin-bottom: 16px;
                color: #888;
            }

            @@media (max-width: 768px) {
                body {
                    flex-direction: column;
                }

                .left-panel {
                    width: 100%;
                    padding: 30px 20px;
                    min-height: auto;
                }

                    .left-panel h1 {
                        font-size: 1.8rem;
                    }

                .left-quote {
                    font-size: 0.9rem;
                    max-width: 100%;
                }

                .right-panel {
                    width: 100%;
                    padding: 30px 20px;
                }

                .form-box {
                    max-width: 100%;
                }
            }
    </style>
</head>
<body>
    <div class="left-panel">
        <h1><span>Artisan</span> Valley</h1>
        <p>Moderator Portal</p>
        <div class="left-divider"></div>
        <div class="left-quote">"Review with care,<br>approve with precision."</div>
    </div>

    <div class="right-panel">
        <div class="form-box">
            <div class="icon-box">
                <i class="fa-solid fa-key"></i>
            </div>
            <h2>Reset Password</h2>
            <p class="sub">Enter your new password below. Make sure it's strong and secure.</p>

            @if (TempData["ModError"] != null)
            {
                <div class="error-box">⚠️ @TempData["ModError"]</div>
            }

            <form asp-controller="Moderator" asp-action="ResetPassword" method="post">
                <input type="hidden" name="token" value="@ViewBag.Token" />

                <label class="field-label">New Password</label>
                <div class="input-wrapper">
                    <input type="password" name="newPassword" id="newPass"
                           placeholder="Enter new password" required minlength="8">
                    <span class="toggle-pass" onclick="togglePass('newPass', this)">
                        <i class="fa-solid fa-eye"></i>
                    </span>
                </div>

                <label class="field-label">Confirm Password</label>
                <div class="input-wrapper">
                    <input type="password" id="confirmPass"
                           placeholder="Confirm new password" required minlength="8">
                    <span class="toggle-pass" onclick="togglePass('confirmPass', this)">
                        <i class="fa-solid fa-eye"></i>
                    </span>
                </div>
                <p class="password-strength" id="matchMsg"></p>

                <button type="submit" class="submit-btn" onclick="return checkMatch()">
                    <i class="fa-solid fa-check"></i> Reset Password
                </button>
            </form>

            <div class="back-link">
                <a href="/Moderator/Login"><i class="fa-solid fa-arrow-left"></i> Back to Login</a>
            </div>
            <div class="footer-text">© 2025 Artisan Valley. All rights reserved.</div>
        </div>
    </div>

    <script>
            function togglePass(id, el) {
                const input = document.getElementById(id);
                const icon = el.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.replace('fa-eye', 'fa-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.replace('fa-eye-slash', 'fa-eye');
                }
            }

            function checkMatch() {
                const p1 = document.getElementById('newPass').value;
                const p2 = document.getElementById('confirmPass').value;
                if (p1 !== p2) {
                    document.getElementById('matchMsg').textContent = '❌ Passwords do not match!';
                    document.getElementById('matchMsg').style.color = '#c62828';
                    return false;
                }
                return true;
            }

            document.getElementById('confirmPass').addEventListener('input', function() {
                const p1 = document.getElementById('newPass').value;
                const p2 = this.value;
                const msg = document.getElementById('matchMsg');
                if (p2.length > 0) {
                    if (p1 === p2) {
                        msg.textContent = '✅ Passwords match!';
                        msg.style.color = '#2e7d32';
                    } else {
                        msg.textContent = '❌ Passwords do not match!';
                        msg.style.color = '#c62828';
                    }
                } else {
                    msg.textContent = '';
                }
            });
    </script>
</body>
</html>