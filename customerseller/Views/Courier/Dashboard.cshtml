@model List<customerseller.Models.Order>
@{
    Layout = null;
    var courierName = Context.Session.GetString("CourierName");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Courier Dashboard - Artisan Valley</title>
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Segoe UI', sans-serif;
                background: #f5f3ff;
                display: flex;
            }

            .sidebar {
                width: 250px;
                background: #a64d79;
                height: 100vh;
                position: fixed;
                left: 0;
                top: 0;
                display: flex;
                flex-direction: column;
            }

            .sidebar-logo {
                padding: 24px 20px;
                border-bottom: 1px solid rgba(255,255,255,0.1);
            }

                .sidebar-logo h2 {
                    color: #fff;
                    font-size: 1.2rem;
                    font-weight: 700;
                }

                .sidebar-logo p {
                    color: rgba(255,255,255,0.6);
                    font-size: 0.75rem;
                    margin-top: 4px;
                }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 13px 20px;
                color: rgba(255,255,255,0.85);
                font-size: 0.88rem;
                cursor: pointer;
                border-left: 3px solid transparent;
            }

                .nav-item.active {
                    background: rgba(255,255,255,0.1);
                    border-left-color: #fff;
                }

            .sidebar-bottom {
                margin-top: auto;
                padding: 16px 0;
                border-top: 1px solid rgba(255,255,255,0.1);
            }

            .logout-item {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 13px 20px;
                color: #ffd2d2;
                text-decoration: none;
                font-size: 0.88rem;
            }

            .main {
                margin-left: 250px;
                padding: 30px 40px;
                flex: 1;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            .topbar {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 26px;
            }

                .topbar h1 {
                    font-size: 1.5rem;
                    color: #1a1a2e;
                    font-weight: 700;
                }

                .topbar p {
                    color: #888;
                    font-size: 0.85rem;
                    margin-top: 3px;
                }

            .stats-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 16px;
                margin-bottom: 26px;
            }

            .stat-card {
                background: #fff;
                padding: 18px;
                border-radius: 12px;
                box-shadow: 0 2px 12px rgba(0,0,0,0.06);
                border-left: 4px solid #a64d79;
            }

                .stat-card.pending {
                    border-left-color: #f59e0b;
                }

                .stat-card.delivered {
                    border-left-color: #10b981;
                }

            .stat-number {
                font-size: 1.7rem;
                font-weight: 700;
                color: #1a1a2e;
            }

            .stat-label {
                font-size: 0.78rem;
                color: #888;
                margin-top: 3px;
            }

            .order-card {
                background: #fff;
                border-radius: 14px;
                padding: 20px 22px;
                margin-bottom: 16px;
                box-shadow: 0 2px 12px rgba(0,0,0,0.06);
            }

            .order-header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 14px;
            }

            .order-id {
                font-family: monospace;
                font-size: 0.85rem;
                color: #7c3aed;
                font-weight: 700;
            }

            .badge {
                padding: 4px 12px;
                border-radius: 20px;
                font-size: 0.74rem;
                font-weight: 700;
            }

            .badge-assigned {
                background: #fff3e0;
                color: #e65100;
            }

            .badge-pickedup {
                background: #e3f2fd;
                color: #1565c0;
            }

            .badge-delivered {
                background: #d1fae5;
                color: #059669;
            }

            .address-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px;
                margin-bottom: 14px;
            }

            .address-box {
                background: #f8f5ff;
                border-radius: 10px;
                padding: 12px 14px;
            }

                .address-box .label {
                    font-size: 0.7rem;
                    color: #8b5cf6;
                    font-weight: 700;
                    text-transform: uppercase;
                    margin-bottom: 5px;
                }

                .address-box .name {
                    font-size: 0.88rem;
                    font-weight: 700;
                    color: #1a1a2e;
                }

                .address-box .addr {
                    font-size: 0.82rem;
                    color: #555;
                    margin-top: 3px;
                }

                .address-box .phone {
                    font-size: 0.82rem;
                    color: #a64d79;
                    font-weight: 600;
                    margin-top: 4px;
                }

                    .address-box .phone a {
                        color: #a64d79;
                        text-decoration: none;
                    }

            .cost-row {
                display: flex;
                justify-content: space-between;
                padding: 10px 0;
                border-top: 1px solid #f0f0f0;
                font-size: 0.85rem;
                color: #555;
            }

                .cost-row.total {
                    font-weight: 700;
                    color: #a64d79;
                    font-size: 0.95rem;
                }

            .order-actions {
                display: flex;
                gap: 10px;
                margin-top: 14px;
            }

            .btn-pickup {
                flex: 1;
                padding: 10px;
                background: #e3f2fd;
                color: #1565c0;
                border: none;
                border-radius: 8px;
                font-size: 0.85rem;
                font-weight: 600;
                cursor: pointer;
            }

            .btn-deliver {
                flex: 1;
                padding: 10px;
                background: #d1fae5;
                color: #059669;
                border: none;
                border-radius: 8px;
                font-size: 0.85rem;
                font-weight: 600;
                cursor: pointer;
            }

            .empty-state {
                text-align: center;
                padding: 60px;
                color: #aaa;
            }

                .empty-state i {
                    font-size: 3rem;
                    margin-bottom: 16px;
                    display: block;
                    color: #ddd;
                }

            /* Payment Modal */
            .modal-overlay {
                display: none;
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.45);
                z-index: 9999;
                align-items: center;
                justify-content: center;
            }

                .modal-overlay.show {
                    display: flex;
                }

            .modal-box {
                background: #fff;
                border-radius: 16px;
                padding: 30px;
                max-width: 380px;
                width: 90%;
            }

                .modal-box h3 {
                    font-size: 1rem;
                    font-weight: 700;
                    color: #1a1a2e;
                    margin-bottom: 16px;
                }

            .payment-options {
                display: flex;
                gap: 10px;
                margin-bottom: 16px;
            }

            .payment-btn {
                flex: 1;
                padding: 12px;
                border-radius: 10px;
                border: 1.5px solid #ddd;
                background: #fff;
                cursor: pointer;
                font-size: 0.85rem;
                font-weight: 600;
            }

                .payment-btn.selected.received {
                    background: #d1fae5;
                    border-color: #10b981;
                    color: #059669;
                }

                .payment-btn.selected.notreceived {
                    background: #fee2e2;
                    border-color: #ef4444;
                    color: #c62828;
                }

            .reason-input {
                width: 100%;
                padding: 10px 12px;
                border: 1.5px solid #ddd;
                border-radius: 8px;
                font-size: 0.85rem;
                margin-bottom: 16px;
                display: none;
            }

            .modal-actions {
                display: flex;
                gap: 10px;
            }

            .btn-cancel-modal {
                flex: 1;
                padding: 11px;
                background: #f1f5f9;
                color: #555;
                border: none;
                border-radius: 8px;
                font-weight: 600;
                cursor: pointer;
            }

            .btn-confirm-modal {
                flex: 1;
                padding: 11px;
                background: #a64d79;
                color: #fff;
                border: none;
                border-radius: 8px;
                font-weight: 600;
                cursor: pointer;
            }

            @@media (max-width: 768px) {
                .sidebar {
                    width: 100%;
                    height: auto;
                    position: relative;
                }

                .main {
                    margin-left: 0;
                    padding: 20px 15px;
                }

                .stats-grid {
                    grid-template-columns: 1fr;
                }

                .address-grid {
                    grid-template-columns: 1fr;
                }

                .order-card {
                    padding: 16px 18px;
                }

                .order-header {
                    flex-wrap: wrap;
                    gap: 8px;
                }

                .order-actions {
                    flex-direction: column;
                }

                .payment-options {
                    flex-direction: column;
                }

                .modal-actions {
                    flex-direction: column;
                }
            }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-logo">
            <h2>Artisan<span style="color:#ffd2e6;">Valley</span></h2>
            <p>Courier Partner — @courierName</p>
        </div>
        <div class="nav-item active">
            <i class="fas fa-truck"></i> My Deliveries
        </div>
        <a href="/Chat/Messages" class="nav-item" style="text-decoration:none; position:relative;">
            <i class="fas fa-comment-dots"></i> Messages
            <span id="chatUnreadBadge" style="display:none; margin-left:auto; background:#dc2626; color:#fff; padding:2px 8px; border-radius:10px; font-size:0.72rem;">0</span>
        </a>
        <div class="sidebar-bottom">
            <a href="/Courier/Logout" class="logout-item" onclick="return confirmLogout(event)">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <div class="main">
        <div class="topbar">
            <div>
                <h1>My Deliveries</h1>
                <p>Manage your assigned orders</p>
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number">@ViewBag.Total</div>
                <div class="stat-label">Total Assigned</div>
            </div>
            <div class="stat-card pending">
                <div class="stat-number">@ViewBag.Pending</div>
                <div class="stat-label">In Progress</div>
            </div>
            <div class="stat-card delivered">
                <div class="stat-number">@ViewBag.Delivered</div>
                <div class="stat-label">Delivered</div>
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-box-open"></i>
                <p>No deliveries assigned yet.</p>
            </div>
        }
        else
        {
            @foreach (var o in Model)
            {
                var statusClass = o.CourierStatus switch
                {
                    "Assigned" => "badge-assigned",
                    "PickedUp" => "badge-pickedup",
                    "Delivered" => "badge-delivered",
                    _ => "badge-assigned"
                };

                <div class="order-card" id="order-@o.OrderId">
                    <div class="order-header">
                        <span class="order-id">#@(o.OrderId?.Length > 8 ? o.OrderId.Substring(0, 8).ToUpper() : o.OrderId)</span>
                        <span class="badge @statusClass">@o.CourierStatus</span>
                    </div>

                    <div class="address-grid">
                        <div class="address-box">
                            <div class="label"><i class="fas fa-store"></i> Pickup From (Seller)</div>
                            <div class="addr">@(o.SellerPickupAddress ?? "Address not set")</div>
                            <div class="phone">
                                <i class="fas fa-phone"></i>
                                <a href="tel:@o.SellerPhone">@(o.SellerPhone ?? "N/A")</a>
                            </div>
                        </div>
                        <div class="address-box">
                            <div class="label"><i class="fas fa-map-marker-alt"></i> Deliver To (Customer)</div>
                            <div class="name">@o.FirstName @o.LastName</div>
                            <div class="addr">@(o.CustomerAddress ?? o.Address)</div>
                            <div class="phone">
                                <i class="fas fa-phone"></i>
                                <a href="tel:@o.CustomerPhone">@(o.CustomerPhone ?? o.Email)</a>
                            </div>
                        </div>
                    </div>

                    <div class="cost-row">
                        <span>Product Cost</span>
                        <span>Rs. @((o.Total - (o.DeliveryFee ?? 0)).ToString("N0"))</span>
                    </div>
                    <div class="cost-row">
                        <span>Delivery Fee</span>
                        <span>Rs. @((o.DeliveryFee ?? 0).ToString("N0"))</span>
                    </div>
                    <div class="cost-row total">
                        <span>Total (COD)</span>
                        <span>Rs. @o.Total.ToString("N0")</span>
                    </div>

                    @if (o.CourierStatus != "Delivered")
                    {
                        <div class="order-actions">
                            @if (o.CourierStatus == "Assigned")
                            {
                                <button class="btn-pickup" onclick="markPickedUp('@o.OrderId')">
                                    <i class="fas fa-box"></i> Mark Picked Up
                                </button>
                            }
                            <button class="btn-deliver" onclick="openDeliverModal('@o.OrderId')">
                                <i class="fas fa-check-circle"></i> Mark Delivered
                            </button>
                        </div>
                    }
                    else
                    {
                        <div style="margin-top:12px; font-size:0.85rem; color:#059669;">
                            <i class="fas fa-check-circle"></i>
                            Delivered on @o.DeliveredAt?.ToString("dd MMM yyyy, hh:mm tt", new System.Globalization.CultureInfo("en-US"))
                            @if (o.PaymentReceived == false)
                            {
                                <span style="color:#c62828;"> — Payment Issue: @o.PaymentNotReceivedReason</span>
                            }
                        </div>
                    }
                </div>
            }
        }
        <div style="text-align:center; padding:20px; font-size:0.8rem; color:#999; margin-top:auto;">
            © 2026 ArtisanValley — Courier Portal
        </div>
    </div>

    <!-- Deliver Modal -->
    <div class="modal-overlay" id="deliverModal">
        <div class="modal-box">
            <h3><i class="fas fa-money-bill-wave" style="color:#a64d79;"></i> Confirm Payment Status</h3>
            <input type="hidden" id="deliverOrderId">
            <div class="payment-options">
                <button type="button" class="payment-btn" id="btnReceived" onclick="selectPayment(true)">
                    <i class="fas fa-check"></i> Payment Received
                </button>
                <button type="button" class="payment-btn" id="btnNotReceived" onclick="selectPayment(false)">
                    <i class="fas fa-times"></i> Not Received
                </button>
            </div>
            <textarea class="reason-input" id="reasonInput" placeholder="Reason (e.g. customer refused, partial payment...)"></textarea>
            <div class="modal-actions">
                <button class="btn-cancel-modal" onclick="closeDeliverModal()">Cancel</button>
                <button class="btn-confirm-modal" onclick="confirmDelivery()">Confirm</button>
            </div>
           
        </div>
    </div>
    <!-- Logout Confirm Modal -->
    <div class="modal-overlay" id="logoutModal">
        <div class="modal-box" style="max-width:320px;">
            <h3><i class="fas fa-sign-out-alt" style="color:#a64d79;"></i> Confirm Logout</h3>
            <p style="font-size:0.85rem; color:#555; margin-bottom:20px;">Are you sure you want to logout?</p>
            <div class="modal-actions">
                <button class="btn-cancel-modal" onclick="closeLogoutModal()">Cancel</button>
                <button class="btn-confirm-modal" onclick="doLogout()">Logout</button>
            </div>
        </div>
    </div>
    <script>
            let paymentReceived = null;

            async function markPickedUp(orderId) {
                const res = await fetch('/Courier/MarkPickedUp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: 'orderId=' + encodeURIComponent(orderId)
                });
                const data = await res.json();
                if (data.success) location.reload();
            }

            function openDeliverModal(orderId) {
                document.getElementById('deliverOrderId').value = orderId;
                paymentReceived = null;
                document.getElementById('btnReceived').classList.remove('selected', 'received');
                document.getElementById('btnNotReceived').classList.remove('selected', 'notreceived');
                document.getElementById('reasonInput').style.display = 'none';
                document.getElementById('reasonInput').value = '';
                document.getElementById('deliverModal').classList.add('show');
            }

            function closeDeliverModal() {
                document.getElementById('deliverModal').classList.remove('show');
            }

            function selectPayment(received) {
                paymentReceived = received;
                document.getElementById('btnReceived').classList.remove('selected', 'received');
                document.getElementById('btnNotReceived').classList.remove('selected', 'notreceived');
                document.getElementById('reasonInput').style.display = received ? 'none' : 'block';

                if (received) {
                    document.getElementById('btnReceived').classList.add('selected', 'received');
                } else {
                    document.getElementById('btnNotReceived').classList.add('selected', 'notreceived');
                }
            }

                    fetch('/Chat/GetUnreadCount')
            .then(r => r.json())
            .then(d => {
                const badge = document.getElementById('chatUnreadBadge');
                if (d.count > 0) {
                    badge.textContent = d.count;
                    badge.style.display = 'inline-block';
                }
            });
            async function confirmDelivery() {
                if (paymentReceived === null) {
                    alert('Please select payment status.');
                    return;
                }
                const orderId = document.getElementById('deliverOrderId').value;
                const reason = document.getElementById('reasonInput').value;

                const res = await fetch('/Courier/MarkDelivered', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `orderId=${encodeURIComponent(orderId)}&paymentReceived=${paymentReceived}&reason=${encodeURIComponent(reason)}`
                });
                const data = await res.json();
                if (data.success) {
                    closeDeliverModal();
                    location.reload();

                }
            }
                       function confirmLogout(e) {
                e.preventDefault();
                document.getElementById('logoutModal').classList.add('show');
                return false;
            }

            function closeLogoutModal() {
                document.getElementById('logoutModal').classList.remove('show');
            }

            async function doLogout() {
                 await fetch('/Courier/Logout');
                 window.location.replace('/');
             }
    </script>
</body>
</html>
